---
import Container from "./Container.astro";
// Quote of the day. Overwritten daily at midnight by the agent that queries
// one of Claude / Gemini / ChatGPT and updates the JSON file in place.
import quote from "../data/quote.json";

interface ColophonLink { label: string; href: string; }
interface Props {
  email?: string;
  subdomains?: ColophonLink[];
  /** Item number printed in the right rail, e.g. "№ 047". */
  itemNumber?: string;
}

const {
  email = "naman@nl06.com",
  subdomains = [
    { label: "gs.",      href: "https://gs.nl06.com" },
    { label: "chains.",  href: "https://chains.nl06.com" },
    { label: "reading.", href: "https://reading.nl06.com" },
  ],
  itemNumber = "№ 001",
} = Astro.props;

const year = new Date().getFullYear();
---
<footer class="footer">
  <Container size="wide" class="footer__inner">
    <div class="footer__topline">
      <span class="footer__head">Colophon</span>
      <span class="footer__rule" aria-hidden="true"></span>
      <span class="footer__item">{itemNumber}</span>
    </div>

    <div class="footer__grid">
      <dl class="footer__rows">
        <div class="footer__row">
          <dt>Source</dt>
          <dd><a href="https://github.com/namanmishra07/nl06" rel="noopener">github.com/namanmishra07/nl06</a></dd>
        </div>
        <div class="footer__row">
          <dt>Subdomains</dt>
          <dd>
            {subdomains.map((s, i) => (
              <>
                {i > 0 && <span class="footer__sep" aria-hidden="true">·</span>}
                <a href={s.href}>{s.label}</a>
              </>
            ))}
          </dd>
        </div>
        <div class="footer__row">
          <dt>Write</dt>
          <dd><a href={`mailto:${email}`}>{email}</a></dd>
        </div>
      </dl>

      <aside class="footer__aside" aria-label="Quote of the day">
        <blockquote class="footer__quote">
          <p class="footer__quote-body">
            <span class="footer__quote-mark" aria-hidden="true">“</span>
            {quote.quote}
          </p>
          <cite class="footer__quote-cite">
            — <a href={quote.author_url} rel="noopener">{quote.author}</a>, quote of the day
          </cite>
        </blockquote>
      </aside>
    </div>

    <div class="footer__base">
      <span class="footer__year">© {year}, Naman Mishra.</span>
      <span class="footer__ornament" aria-hidden="true">❡   ·   §   ·   ❡</span>
      <span class="footer__rights">
        Run by a Claude agent from the <a href="https://gs.nl06.com">Lucknow GS</a>.
      </span>
    </div>
  </Container>
</footer>

<style>
  .footer {
    margin-top: var(--space-24);
    padding-top: var(--space-10);
    padding-bottom: var(--space-12);
    border-top: 3px solid var(--color-ink);
    position: relative;
    background: var(--color-paper);
  }
  /* Companion thin rule above the thick one (banner-rule pattern). */
  .footer::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: -7px;
    border-top: 1px solid var(--color-ink);
    pointer-events: none;
  }

  /* TOP LINE — "Colophon" | hairline | item number */
  .footer__topline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .footer__head {
    color: var(--color-ink);
    font-weight: 600;
  }
  .footer__rule {
    flex: 1;
    height: 1px;
    background: var(--color-rule);
  }

  /* GRID — three-row dl on the left, pull-quotes aside on the right. */
  .footer__grid {
    margin-top: var(--space-7);
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }
  .footer__rows {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--type-small);
    color: var(--color-ink-soft);
    line-height: var(--leading-normal);
  }
  .footer__row { display: contents; }
  .footer__rows dt {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    padding-top: 0.22em;
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .footer__rows dd { margin: 0; }
  .footer__rows a { color: var(--color-ink); }
  .footer__sep {
    margin: 0 var(--space-2);
    color: var(--color-rule-strong);
  }

  .footer__aside {
    padding-left: var(--space-6);
    border-left: 1px solid var(--color-rule);
  }
  .footer__quote {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .footer__quote-body {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--type-h3);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    text-indent: -0.4em;
  }
  .footer__quote-mark {
    color: var(--color-accent);
    font-weight: 800;
    font-size: 1.4em;
    line-height: 0;
    vertical-align: -0.1em;
  }
  .footer__quote-cite {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-style: normal;
    font-weight: 500;
  }
  .footer__quote-cite em {
    text-transform: none;
    letter-spacing: 0;
    font-style: italic;
    font-family: var(--font-serif);
    color: var(--color-ink-soft);
    font-size: var(--type-small);
  }
  .footer__quote-cite a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    padding-bottom: 1px;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .footer__quote-cite a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* BASE — year · ornament · operational note, single line. */
  .footer__base {
    margin-top: var(--space-10);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .footer__ornament {
    color: var(--color-ink-faint);
    letter-spacing: 0.5em;
  }
  .footer__rights a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    padding-bottom: 1px;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .footer__rights a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .footer__aside {
      padding-left: 0;
      border-left: 0;
      padding-top: var(--space-6);
      border-top: 1px solid var(--color-rule);
    }
    .footer__rows {
      grid-template-columns: 1fr;
      gap: var(--space-1) 0;
    }
    .footer__rows dt { padding-top: var(--space-3); }
    .footer__base {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
    .footer__ornament { display: none; }
  }
</style>
