---
import Container from "./Container.astro";
import NavLink from "./NavLink.astro";

interface NavItem {
  label: string;
  href: string;
  external?: boolean;
}
interface StationItem {
  /** Display label, e.g. "gs." */
  label: string;
  /** External URL, e.g. "https://gs.nl06.com". */
  href: string;
  /** Roman-numeral mark, e.g. "I". Optional; auto-numbered if omitted. */
  numeral?: string;
}
interface Props {
  /** Path of the current page, used to mark the active nav item. */
  pathname?: string;
  /** Override the default nav items. */
  nav?: NavItem[];
  /**
   * Optional secondary nav of subdomains ("stations"). When provided
   * and non-empty, a quietly-subordinated row of subdomain links is
   * rendered below the primary nav. Currently used by the apex
   * (nl06.com) only; subdomain mastheads omit it.
   */
  stations?: StationItem[];
  /** Label printed before the stations row. Default "Stations". */
  stationsLabel?: string;
  /** Wordmark / publication title. */
  title?: string;
  /** Sub-label after the wordmark (e.g. "— A Review", "— Register"). */
  caption?: string;
  /** Where the wordmark links to. */
  homeHref?: string;
  /** Edition / volume line shown above the wordmark. */
  edition?: string;
  /** Right-side dateline (defaults to the issue's longest-living date). */
  dateline?: string;
}

const {
  pathname = "/",
  title = "NL06",
  caption,
  homeHref = "/",
  edition = "Vol. I  ·  Issue 01",
  dateline = "Lucknow  ·  2026",
  nav = [
    { label: "Home",     href: "/" },
    { label: "Now",      href: "/now" },
    { label: "Writing",  href: "/writing" },
    { label: "About",    href: "/about" },
    { label: "Colophon", href: "/colophon" },
  ],
  stations,
  stationsLabel = "Stations",
} = Astro.props;

const ROMANS = ["I","II","III","IV","V","VI","VII","VIII","IX","X"];

/**
 * Normalise both the pathname and the link href before comparing.
 * Astro's `build: { format: "file" }` makes `Astro.url.pathname` end
 * in `.html` at build time (e.g. `/plates.html`), but the nav links
 * are written without the extension (e.g. `/plates`). Stripping
 * `.html` (and any trailing slash) makes the equality robust across
 * both formats. Without this, every non-root page on a `format:"file"`
 * subdomain would silently fail to mark its nav link as active.
 */
const norm = (p: string) => {
  if (!p) return "/";
  const stripped = p.replace(/\.html$/i, "").replace(/\/$/, "");
  return stripped === "" ? "/" : stripped;
};
const isCurrent = (href: string) => {
  const np = norm(pathname);
  const nh = norm(href);
  if (nh === "/") return np === "/";
  return np === nh || np.startsWith(nh + "/");
};
---
<header class="masthead">
  <Container size="wide" class="masthead__inner">
    <div class="masthead__topline">
      <span class="masthead__edition" set:html={edition}></span>
      <span class="masthead__rule" aria-hidden="true"></span>
      <span class="masthead__dateline">{dateline}</span>
    </div>

    <a href={homeHref} class="masthead__wordmark" aria-label={`${title} — home`}>
      <span class="masthead__wordmark-glyph">{title}</span>
      {caption && <span class="masthead__wordmark-caption">{caption}</span>}
    </a>

    {stations && stations.length > 0 && (
      <p class="masthead__stations" aria-label="Stations">
        {stations.map((s, i) => (
          <>
            {i > 0 && <span class="masthead__stations-sep" aria-hidden="true">·</span>}
            <a class="masthead__stations-link" href={s.href}>{s.label}</a>
          </>
        ))}
      </p>
    )}

    <nav class="masthead__nav" aria-label="Primary">
      <ol class="masthead__nav-list">
        {nav.map((item, i) => (
          <li class="masthead__nav-item">
            <span class="masthead__nav-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <NavLink href={item.href} external={item.external} current={isCurrent(item.href)}>
              {item.label}
            </NavLink>
          </li>
        ))}
      </ol>
    </nav>

  </Container>
</header>

<style>
  .masthead {
    padding-top: var(--space-6);
    position: relative;
  }

  .masthead :global(.masthead__inner) {
    display: block;
  }

  /* Top line: edition · hairline · dateline */
  .masthead__topline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    font-feature-settings: var(--features-tabular);
    color: var(--color-ink-muted);
    font-weight: 500;
  }
  .masthead__edition { white-space: nowrap; }
  .masthead__edition :global(a) {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    padding-bottom: 1px;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .masthead__edition :global(a:hover) {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .masthead__dateline { white-space: nowrap; }
  .masthead__rule {
    flex: 1;
    height: 1px;
    background: var(--color-rule);
  }

  /* Wordmark — display-jumbo serif, slight optical hang. */
  .masthead__wordmark {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    padding: var(--space-5) 0 var(--space-4);
    color: var(--color-ink);
    text-decoration: none;
  }
  .masthead__wordmark-glyph {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-jumbo);
    line-height: 0.9;
    letter-spacing: var(--tracking-jumbo);
    font-feature-settings: var(--features-display);
  }
  .masthead__wordmark-caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--type-h3);
    color: var(--color-ink-muted);
    letter-spacing: var(--tracking-tight);
  }

  /* Nav: numbered list flowing horizontally with hung tabular numerals. */
  .masthead__nav {
    border-top: 1px solid var(--color-rule);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }
  .masthead__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
  }
  .masthead__nav-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
  }
  .masthead__nav-num {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-meta);
    color: var(--color-ink-faint);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }

  /* "Stations" — a quiet italic-serif line sitting in the breathing
     space between the wordmark and the primary nav. Reads as the
     publication's department/section index, like a magazine's
     "in this issue" line. No label, no numerals — just the lowercased
     subdomain names spaced with middle dots. Apex masthead only. */
  .masthead__stations {
    margin: 0;
    padding: 0 0 var(--space-4);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--type-small);
    color: var(--color-ink-muted);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }
  .masthead__stations-sep {
    margin: 0 0.55em;
    color: var(--color-ink-faint);
    font-style: normal;
  }
  .masthead__stations-link {
    color: var(--color-ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 100ms ease, border-color 100ms ease;
  }
  .masthead__stations-link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .masthead__wordmark-glyph { font-size: var(--type-display); }
    .masthead__nav-list { gap: var(--space-4) var(--space-5); }
    .masthead__stations { font-size: var(--type-meta); }
  }
</style>
