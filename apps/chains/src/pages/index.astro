---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import Prose      from "@nl06/design-system/components/Prose.astro";
import ChainCard  from "~/components/ChainCard.astro";

const all = (await getCollection("chains"))
  .filter((c) => !c.data.draft)
  .sort((a, b) => b.data.last_updated.getTime() - a.data.last_updated.getTime());

const active = all.filter((c) => c.data.status !== "KILLED");
const killed = all.filter((c) => c.data.status === "KILLED");
---
<BaseLayout
  title="chains.nl06"
  description="Consequence chains — a public window into the methodology."
>
  <Container size="container" class="page">
    <p class="meta">Methodology</p>
    <h1>Consequence chains</h1>

    <Prose>
      <p><em>PLACEHOLDER — methodology explainer. The four-question structure: macro shift → first-order change → second-order consequence → mandatory new problem → infrastructure gap. Worked example follows.</em></p>
    </Prose>

    <section class="section">
      <h2 id="live">Live chains</h2>
      {active.length === 0 ? (
        <p class="empty"><em>PLACEHOLDER — no live chains yet.</em></p>
      ) : (
        <div class="chains">
          {active.map((c) => <ChainCard chain={c} />)}
        </div>
      )}
    </section>

    {killed.length > 0 && (
      <section class="section">
        <h2 id="killed">Killed chains</h2>
        <p class="killed-blurb">Chains that have been killed, with the reason why.</p>
        <div class="chains">
          {killed.map((c) => <ChainCard chain={c} />)}
        </div>
      </section>
    )}
  </Container>
</BaseLayout>

<style>
  .page { padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .page > * + * { margin-top: var(--space-4); }
  .page > h1 { margin-top: var(--space-2); }
  .page > :global(.prose-flow) { margin-top: var(--space-8); }

  .section {
    margin-top: var(--space-16);
  }
  .section > h2 {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }
  .section > .killed-blurb {
    margin-top: var(--space-3);
    color: var(--color-ink-muted);
    font-size: var(--type-small);
  }
  .chains {
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }
  .empty { margin-top: var(--space-6); color: var(--color-ink-muted); }
</style>
