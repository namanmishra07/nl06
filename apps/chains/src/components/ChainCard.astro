---
import type { CollectionEntry } from "astro:content";

interface Props {
  chain: CollectionEntry<"chains">;
}
const { chain } = Astro.props;
const d = chain.data;

const fmtDate = (date: Date) =>
  date.toISOString().slice(0, 10).replace(/-/g, " · ");
---
<article class:list={["chain", `chain--${d.status.toLowerCase()}`]}>
  <header class="chain__head">
    <span class:list={["chain__status", `chain__status--${d.status.toLowerCase()}`]}>{d.status}</span>
    <span class="chain__date">Updated {fmtDate(d.last_updated)}</span>
  </header>

  <h3 class="chain__title">{d.title}</h3>

  <p class="chain__macro"><span class="chain__label">Macro shift</span>{d.macro_shift}</p>

  <ol class="chain__steps">
    {d.steps.map((s) => <li>{s}</li>)}
  </ol>

  {d.status === "KILLED" && d.killed_reason && (
    <p class="chain__verdict chain__verdict--killed">
      <span class="chain__label">Killed</span>{d.killed_reason}
    </p>
  )}
  {d.status !== "KILLED" && d.verdict_reason && (
    <p class="chain__verdict">
      <span class="chain__label">Verdict</span>{d.verdict_reason}
    </p>
  )}
</article>

<style>
  .chain {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .chain + .chain { margin-top: 0; }

  .chain__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--type-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }
  .chain__status { font-weight: 600; }
  .chain__status--live       { color: var(--color-accent); }
  .chain__status--unresolved { color: var(--color-ink-soft); }
  .chain__status--killed     { color: var(--color-ink-muted); }
  .chain__date { color: var(--color-ink-muted); }

  .chain__title {
    font-size: var(--type-h3);
    margin-top: var(--space-2);
  }

  .chain__macro {
    margin-top: var(--space-3);
    color: var(--color-ink-soft);
  }

  .chain__label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--type-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-right: var(--space-2);
  }

  .chain__steps {
    margin-top: var(--space-4);
    padding-left: var(--space-6);
  }
  .chain__steps li + li { margin-top: var(--space-2); }

  .chain__verdict {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-rule);
  }
  .chain__verdict--killed {
    color: var(--color-ink-muted);
  }
</style>
