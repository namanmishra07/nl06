---
/**
 * Stage3D.astro — three.js canvas that renders the maneuver stage.
 * The host page (index.astro) calls `window.__ssaStage.setEvent(idx)` and
 * `__ssaStage.replay()`. We keep the global namespace lean: one object.
 *
 * Earth is a sphere with a CanvasTexture drawn at runtime (rough continent
 * silhouettes on a blue-green disc; no external image asset).
 *
 * Orbits are TorusGeometry tubes tilted by each event's inclination.
 * The satellite is a small sphere that rides the morphing orbit during
 * the BEFORE→AFTER animation. The burn arrow is an ArrowHelper that
 * stays visible after the animation finishes (per the brief).
 *
 * Editorial palette: cream paper-cream background, ink-blue accents,
 * no dark starfield.
 */
---

<div class="stage3d">
  <canvas id="stage-canvas"></canvas>

  <!-- HUD overlay -->
  <div class="hud">
    <div class="hud__line">
      <span class="hud__label">NORAD</span>
      <span class="hud__value" id="hud-norad">—</span>
    </div>
    <div class="hud__line">
      <span class="hud__label">ALT</span>
      <span class="hud__value" id="hud-alt">—</span>
      <span class="hud__sep" aria-hidden="true">·</span>
      <span class="hud__label">INC</span>
      <span class="hud__value" id="hud-inc">—</span>
    </div>
  </div>

  <p class="stage3d__note">3D diagram · not to scale</p>
</div>

<script>
  import * as THREE from "three";

  type ManeuverEvent = {
    norad_id: number;
    detected_epoch: string;
    classification: string;
    kind: "in_plane" | "out_of_plane";
    delta_a_km: number | null;
    delta_inc_deg: number | null;
    dv_mps: number;
    altitude_km: number;
    inc_deg_at_event: number | null;
    confidence: "HIGH" | "LOW";
    object_name?: string;
  };

  const COLOR: Record<string, number> = {
    raise:             0xE07A30,
    lower:             0x2A5B9C,
    plane_change:      0x36906A,
    stationkeeping_ew: 0xB8B2A0,
    stationkeeping_ns: 0xC9C1A9,
    deorbit:           0xC73E2E,
  };

  const canvas = document.getElementById("stage-canvas") as HTMLCanvasElement | null;
  if (!canvas) throw new Error("Stage canvas missing");

  // ── Scene ─────────────────────────────────────────────────
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0xFAF8F3);

  const camera = new THREE.PerspectiveCamera(44, 1, 0.1, 6000);
  camera.position.set(0, 340, 780);
  camera.lookAt(0, 0, 0);

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  // ── Lighting ──────────────────────────────────────────────
  const ambient = new THREE.AmbientLight(0xffffff, 0.55);
  const sun = new THREE.DirectionalLight(0xffffff, 0.85);
  sun.position.set(180, 120, 220);
  const fill = new THREE.DirectionalLight(0x7faecf, 0.25);
  fill.position.set(-200, 100, -200);
  scene.add(ambient, sun, fill);

  // ── Earth (real Blue Marble texture) ──────────────────────
  const earthRadius = 50;
  const textureLoader = new THREE.TextureLoader();
  const earthTexture = textureLoader.load("/textures/earth.jpg");
  earthTexture.colorSpace = THREE.SRGBColorSpace;
  earthTexture.anisotropy = 8;
  const earthMat = new THREE.MeshPhongMaterial({
    color: 0x254060, // visible during the brief texture-load flash
    map: earthTexture,
    shininess: 14,
    specular: 0x152030,
  });
  const earthGeo = new THREE.SphereGeometry(earthRadius, 64, 64);
  const earth = new THREE.Mesh(earthGeo, earthMat);
  earth.rotation.z = THREE.MathUtils.degToRad(23.5); // axial tilt for character
  scene.add(earth);

  // Atmosphere halo (faint outer sphere)
  const atmoGeo = new THREE.SphereGeometry(earthRadius * 1.04, 64, 64);
  const atmoMat = new THREE.MeshBasicMaterial({
    color: 0x7eaad9, transparent: true, opacity: 0.12, side: THREE.BackSide,
  });
  scene.add(new THREE.Mesh(atmoGeo, atmoMat));

  // ── orbitGroup: holds guides + per-event orbits + satellite.
  //    Re-oriented every frame so its local +Y axis points toward the
  //    camera. That makes every orbit drawn in the local XZ plane appear
  //    face-on (a true circle) regardless of camera angle.
  const orbitGroup = new THREE.Group();
  scene.add(orbitGroup);
  // Sub-container for the AFTER orbit + satellite — gets an extra rotation
  // around its local X axis to visualise plane changes (tilt relative to
  // the camera-facing plane).
  const tiltGroup = new THREE.Group();
  orbitGroup.add(tiltGroup);

  // ── Faint regime guide rings (LEO/MEO-low/MEO/GEO) ────────
  function guideRing(r: number) {
    const geo = new THREE.TorusGeometry(r, 0.45, 6, 96);
    const mat = new THREE.MeshBasicMaterial({
      color: 0xC9C1A9, transparent: true, opacity: 0.22, depthWrite: false,
    });
    const m = new THREE.Mesh(geo, mat);
    m.rotation.x = Math.PI / 2;
    return m;
  }
  [120, 175, 230, 290].forEach((r) => orbitGroup.add(guideRing(r)));

  // ── Event-specific objects (recreated per event) ──────────
  const eventGroup = new THREE.Group();
  orbitGroup.add(eventGroup);

  // ── Mouse-drag camera rotation ─────────────────────────────
  let camAzimuth = 0;
  let camPolar = 1.05;
  const camRadius = 850;
  let dragging = false;
  let lastX = 0, lastY = 0;
  function applyCamera() {
    const r = camRadius;
    camera.position.set(
      r * Math.sin(camPolar) * Math.sin(camAzimuth),
      r * Math.cos(camPolar),
      r * Math.sin(camPolar) * Math.cos(camAzimuth),
    );
    camera.lookAt(0, 0, 0);
  }
  applyCamera();

  canvas.addEventListener("pointerdown", (e) => {
    dragging = true; lastX = e.clientX; lastY = e.clientY;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    const dx = e.clientX - lastX;
    const dy = e.clientY - lastY;
    lastX = e.clientX; lastY = e.clientY;
    camAzimuth -= dx * 0.005;
    camPolar = Math.max(0.25, Math.min(Math.PI - 0.25, camPolar - dy * 0.005));
    applyCamera();
  });
  canvas.addEventListener("pointerup", (e) => {
    dragging = false;
    try { canvas.releasePointerCapture(e.pointerId); } catch {}
  });
  canvas.addEventListener("pointerleave", () => { dragging = false; });

  // ── Resize ────────────────────────────────────────────────
  function resize() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (w === 0 || h === 0) return;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  const ro = new ResizeObserver(resize);
  ro.observe(canvas);
  resize();

  // ── Helpers ───────────────────────────────────────────────
  function baseRadius(altKm: number) {
    if (altKm < 2000)  return 110;
    if (altKm < 7000)  return 150;
    if (altKm < 25000) return 200;
    return 260;
  }
  function gapForDeltaA(deltaKm: number | null) {
    const abs = Math.abs(deltaKm || 0);
    return Math.max(10, Math.min(56, 8 + Math.log10(abs + 1) * 26));
  }
  function angleFor(noradId: number) {
    let x = noradId | 0;
    x ^= x << 13; x ^= x >>> 17; x ^= x << 5;
    return (((x >>> 0) % 100000) / 100000) * Math.PI * 2;
  }
  function easeInOutCubic(t: number) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  // Orbit rendered as a thin 3-D torus so it has actual thickness — Line
  // primitives in WebGL ignore linewidth > 1 on every desktop browser
  // and render sub-pixel thin from camera distance.
  const ORBIT_TUBE_RADIUS = 0.9;
  const ORBIT_RADIAL_SEGMENTS = 8;
  const ORBIT_TUBULAR_SEGMENTS = 128;

  function makeOrbitTorus(r: number, color: number, opacity: number): THREE.Mesh {
    const geo = new THREE.TorusGeometry(
      r, ORBIT_TUBE_RADIUS, ORBIT_RADIAL_SEGMENTS, ORBIT_TUBULAR_SEGMENTS,
    );
    const mat = new THREE.MeshBasicMaterial({
      color, transparent: true, opacity, depthWrite: false,
    });
    const torus = new THREE.Mesh(geo, mat);
    // TorusGeometry is in XY plane by default — rotate to XZ so it sits
    // in our standard orbital plane.
    torus.rotation.x = Math.PI / 2;
    return torus;
  }

  function setOrbitRadius(torus: THREE.Mesh, r: number) {
    (torus.geometry as THREE.TorusGeometry).dispose();
    torus.geometry = new THREE.TorusGeometry(
      r, ORBIT_TUBE_RADIUS, ORBIT_RADIAL_SEGMENTS, ORBIT_TUBULAR_SEGMENTS,
    );
  }

  // ── Per-event state ───────────────────────────────────────
  type EventVisual = {
    event: ManeuverEvent;
    beforeOrbit: THREE.Mesh;
    afterOrbit: THREE.Mesh;
    satellite: THREE.Mesh;
    arrow: THREE.ArrowHelper | null;
    satTheta: number;          // continuously advancing orbital angle
    beforeR: number;
    afterR: number;
    planeTilt: number;         // radians of extra tilt for plane changes
    cycleStart: number;
  };
  let current: EventVisual | null = null;
  // Continuous loop: morph → hold → reverse-morph (smooth reset).
  const MORPH_MS = 1800;
  const HOLD_MS  = 2200;
  const RESET_MS = 700;
  const CYCLE_MS = MORPH_MS + HOLD_MS + RESET_MS;

  // Bulletproof arrow cleanup. Declared before disposeCurrent because that
  // function calls it. Cheap — tiltGroup never has many children.
  function clearAllArrows() {
    const arrows = tiltGroup.children.filter(
      (c): c is THREE.ArrowHelper => c instanceof THREE.ArrowHelper,
    );
    for (const a of arrows) {
      tiltGroup.remove(a);
      a.dispose();
    }
    if (current) current.arrow = null;
  }

  function disposeCurrent() {
    if (!current) return;
    [current.beforeOrbit, current.afterOrbit, current.satellite].forEach((o) => {
      o.parent?.remove(o);
      ((o as any).geometry as THREE.BufferGeometry)?.dispose();
      const m = (o as any).material;
      if (Array.isArray(m)) m.forEach((mm) => mm.dispose());
      else m?.dispose();
    });
    clearAllArrows();
    current = null;
  }

  // Position on the local XZ-plane orbit at angle theta.
  function placeSatellite(theta: number, r: number): THREE.Vector3 {
    return new THREE.Vector3(Math.cos(theta) * r, 0, Math.sin(theta) * r);
  }

  function setEvent(e: ManeuverEvent) {
    disposeCurrent();

    const baseR = baseRadius(e.altitude_km);
    const isPlane = e.kind === "out_of_plane";
    const dir = (e.delta_a_km ?? 0) >= 0 ? 1 : -1;
    const gap = isPlane ? 0 : gapForDeltaA(e.delta_a_km);
    const beforeR = isPlane ? baseR : baseR - dir * gap * 0.5;
    const afterR  = isPlane ? baseR : baseR + dir * gap * 0.5;
    const color = COLOR[e.classification] ?? 0x14181F;
    const theta = angleFor(e.norad_id);

    // Plane-change tilt: rotate the AFTER orbit + satellite around the
    // local X axis by an exaggerated fraction of Δi so the change is
    // visible against the camera-facing BEFORE orbit.
    const planeTilt = isPlane && e.delta_inc_deg != null
      ? THREE.MathUtils.degToRad(Math.max(-45, Math.min(45, e.delta_inc_deg * 14)))
      : 0;

    const beforeOrbit = makeOrbitTorus(beforeR, 0x767A82, 0.55);
    eventGroup.add(beforeOrbit);

    const afterOrbit = makeOrbitTorus(beforeR, color, 0);
    tiltGroup.add(afterOrbit);

    const satGeo = new THREE.SphereGeometry(4.5, 20, 20);
    const satMat = new THREE.MeshBasicMaterial({ color });
    const satellite = new THREE.Mesh(satGeo, satMat);
    tiltGroup.add(satellite);
    satellite.position.copy(placeSatellite(theta, beforeR));

    // Reset tilt for new event.
    tiltGroup.rotation.set(0, 0, 0);

    current = {
      event: e, beforeOrbit, afterOrbit, satellite,
      arrow: null,
      satTheta: theta, beforeR, afterR,
      planeTilt,
      cycleStart: performance.now(),
    };

    // Snap the orbit plane perpendicular to the camera at this instant
    // — face-on view for the new event. We do NOT keep updating this in
    // the frame loop, so the user can drag freely from here to view
    // the orbit in 3D.
    faceOrbitToCamera();

    // Update HUD overlay.
    setHud(e);
  }

  function drawBurnArrow(e: ManeuverEvent) {
    if (!current) return;
    clearAllArrows();
    const theta = current.satTheta;
    const radialLocal     = new THREE.Vector3(Math.cos(theta), 0, Math.sin(theta));
    const tangentialLocal = new THREE.Vector3(-Math.sin(theta), 0, Math.cos(theta));
    let dirLocal: THREE.Vector3, length: number;
    if (e.kind === "in_plane" && e.delta_a_km != null) {
      const sign = e.delta_a_km >= 0 ? 1 : -1;
      dirLocal = radialLocal.clone().multiplyScalar(sign);
      length = 20 + Math.log10(Math.abs(e.delta_a_km) + 1) * 18;
    } else if (e.kind === "out_of_plane" && e.delta_inc_deg != null) {
      const sign = e.delta_inc_deg >= 0 ? 1 : -1;
      dirLocal = tangentialLocal.clone().multiplyScalar(sign);
      length = 22 + Math.log10(Math.abs(e.delta_inc_deg) + 1) * 30;
    } else {
      return;
    }
    dirLocal.normalize();
    const arrow = new THREE.ArrowHelper(
      dirLocal, current.satellite.position.clone(), length,
      COLOR[e.classification] ?? 0x14181F,
      length * 0.28, length * 0.18,
    );
    tiltGroup.add(arrow);
    current.arrow = arrow;
  }

  function setHud(e: ManeuverEvent) {
    const nEl = document.getElementById("hud-norad");
    const aEl = document.getElementById("hud-alt");
    const iEl = document.getElementById("hud-inc");
    if (nEl) nEl.textContent = String(e.norad_id);
    if (aEl) aEl.textContent = `${Math.round(e.altitude_km).toLocaleString()} km`;
    if (iEl) iEl.textContent = e.inc_deg_at_event != null
      ? `${e.inc_deg_at_event.toFixed(2)}°` : "—";
  }

  // Kepler-third angular speed: rad/sec given orbital radius r.
  // Calibrated so r=110 (LEO) → ~12 s/rev, r=260 (GEO) → ~43 s/rev.
  const KEPLER_K = 605;
  function angularSpeed(r: number) {
    return KEPLER_K / Math.pow(Math.max(r, 1), 1.5);
  }

  // Phase decomposition for the continuous loop.
  function phaseFor(elapsedMs: number) {
    const m = elapsedMs % CYCLE_MS;
    if (m < MORPH_MS) {
      const t = m / MORPH_MS;
      return { phase: "morph" as const, t, k: easeInOutCubic(t) };
    }
    if (m < MORPH_MS + HOLD_MS) {
      return { phase: "hold" as const, t: 1, k: 1 };
    }
    const t = (m - MORPH_MS - HOLD_MS) / RESET_MS;
    // During reset, k goes from 1 back to 0 (reverse-morph).
    return { phase: "reset" as const, t, k: 1 - easeInOutCubic(t) };
  }

  // Each frame: orient orbitGroup so its local +Y axis points toward the
  // camera. Drawing orbits in the local XZ plane then renders them as
  // full circles facing the viewer, regardless of drag-rotation.
  const yAxisLocal = new THREE.Vector3(0, 1, 0);
  const tmpQ = new THREE.Quaternion();
  function faceOrbitToCamera() {
    const camDir = camera.position.clone().normalize();
    tmpQ.setFromUnitVectors(yAxisLocal, camDir);
    orbitGroup.setRotationFromQuaternion(tmpQ);
  }

  // ── Animation loop ────────────────────────────────────────
  let lastT = performance.now();
  function frame() {
    requestAnimationFrame(frame);
    const now = performance.now();
    const dt = now - lastT;
    lastT = now;

    // Earth slowly spins.
    earth.rotation.y += dt * 0.00012;

    if (current) {
      const e = current.event;
      const elapsed = now - current.cycleStart;
      const { phase, k } = phaseFor(elapsed);

      // Orbit radius interpolated along k.
      const curR = current.beforeR + (current.afterR - current.beforeR) * k;
      setOrbitRadius(current.afterOrbit, curR);

      // Opacities.
      (current.beforeOrbit.material as THREE.MeshBasicMaterial).opacity =
        0.55 * (1 - k);
      (current.afterOrbit.material as THREE.MeshBasicMaterial).opacity =
        Math.min(1, k * 1.4);

      // Plane-change tilt — applied to tiltGroup so AFTER orbit + satellite
      // tilt together off the camera-facing plane.
      tiltGroup.rotation.x = current.planeTilt * k;

      // Continuously advance the satellite's orbital angle.
      const omega = angularSpeed(curR);
      current.satTheta += omega * (dt / 1000);
      const sp = placeSatellite(current.satTheta, curR);
      current.satellite.position.copy(sp);

      // Fire the burn arrow once per cycle at the morph apex (~k = 0.6),
      // anchored to the orbital frame so it tracks the tilt and faces the
      // camera. Disposed at the start of the next reset.
      if (phase === "morph" && k > 0.6 && !current.arrow) {
        drawBurnArrow(e);
      }
      if (phase === "reset" && current.arrow) {
        clearAllArrows();
      }
    }

    renderer.render(scene, camera);
  }
  requestAnimationFrame(frame);

  // ── Public surface ────────────────────────────────────────
  // The page's existing JS calls these.
  (window as any).__ssaStage = {
    setEvent,
    replay: () => {
      if (current) {
        // Start the next loop from the beginning of the morph phase.
        current.cycleStart = performance.now();
        clearAllArrows();
      }
    },
  };

  // Page may have already requested an event before this script booted.
  if ((window as any).__ssaStagePending != null) {
    setEvent((window as any).__ssaStagePending);
    (window as any).__ssaStagePending = null;
  }
</script>

<style>
  .stage3d {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--color-paper);
  }
  .stage3d canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
    cursor: grab;
    touch-action: none;
  }
  .stage3d canvas:active { cursor: grabbing; }

  .stage3d__note {
    position: absolute;
    bottom: var(--space-2);
    right: var(--space-3);
    margin: 0;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    pointer-events: none;
  }

  .hud {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-weight: 700;
    pointer-events: none;
    min-width: 160px;
    font-feature-settings: "tnum" 1, "lnum" 1;
  }
  .hud__line {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    line-height: 1.5;
  }
  .hud__label { color: var(--color-ink-muted); }
  .hud__value { color: var(--color-ink); font-weight: 800; }
  .hud__sep   { color: var(--color-ink-faint); margin: 0 0.2em; }
</style>
