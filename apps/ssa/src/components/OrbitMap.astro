---
/**
 * OrbitMap.astro — a stylised 2-D orbital diagram.
 *
 * Earth sits at the centre. Around it, concentric orbital shells
 * represent LEO / Polar / MEO / GEO (radii are visual, not literal).
 * Each event is plotted as a dot on its shell at a randomised angle
 * (seeded by NORAD ID so positions are stable build-to-build).
 *
 * Dots are coloured by classification and gently pulse on a loop.
 * Hover shows a tooltip; click opens the same focus panel as the
 * old atlas. Honours prefers-reduced-motion.
 */

interface Event {
  norad_id: number;
  detected_epoch: string;
  classification: string;
  dv_mps: number;
  altitude_km: number;
  confidence: "HIGH" | "LOW";
  object_name?: string;
}

interface Props {
  events: Event[];
  size?: number;
}

const { events, size = 760 } = Astro.props;
const W = size;
const H = size;
const cx = W / 2;
const cy = H / 2;

// Stylised shell radii (px) and the altitude bucket each represents.
// Sizes are chosen for visual balance, not log scale.
const SHELLS = [
  { key: "leo",    altMin: 150,    altMax: 2000,    r: 110, label: "LEO",   altLabel: "400-2,000 km" },
  { key: "polar",  altMin: 2000,   altMax: 7000,    r: 175, label: "MEO low", altLabel: "2-7k km" },
  { key: "meo",    altMin: 7000,   altMax: 25000,   r: 240, label: "MEO",   altLabel: "GPS · GLONASS" },
  { key: "geo",    altMin: 25000,  altMax: 60000,   r: 320, label: "GEO",   altLabel: "35,786 km · weather + comms" },
];

const COLOR: Record<string, string> = {
  raise:             "#E07A30", // brighter rust
  lower:             "#2A5B9C", // saturated blue
  plane_change:      "#36906A", // saturated green
  stationkeeping_ew: "#B8B2A0", // grey for routine
  stationkeeping_ns: "#C9C1A9",
  deorbit:           "#C73E2E", // red
};

// Stable pseudo-angle from NORAD id so dots don't jitter between builds.
function angle(norad: number, salt = 0): number {
  // xorshift-ish hash → [0, 2π)
  let x = (norad + salt) | 0;
  x ^= x << 13; x ^= x >>> 17; x ^= x << 5;
  const u = ((x >>> 0) % 100000) / 100000;
  return u * Math.PI * 2;
}

// Project each event onto a shell.
function placeEvent(e: Event, i: number) {
  const shell = SHELLS.find((s) => e.altitude_km >= s.altMin && e.altitude_km < s.altMax)
              || (e.altitude_km < 150 ? SHELLS[0] : SHELLS[SHELLS.length - 1]);
  // Multiple events per satellite get nudged so they don't overlap.
  const t = angle(e.norad_id, i * 7);
  const x = cx + shell.r * Math.cos(t);
  const y = cy + shell.r * Math.sin(t);
  const r = Math.max(3, Math.min(10, 2 + Math.log10(e.dv_mps + 1) * 6));
  return { x, y, r, shell, t };
}

const placed = events.map((e, i) => ({ event: e, ...placeEvent(e, i) }));
---

<figure class="orbit-map">
  <svg
    class="orbit-map__svg"
    viewBox={`0 0 ${W} ${H}`}
    width={W}
    height={H}
    role="img"
    aria-label="Orbital map showing detected maneuvers around Earth"
  >
    <defs>
      <!-- Soft Earth gradient: blue/green disc, no shading drama. -->
      <radialGradient id="earth-grad" cx="50%" cy="50%" r="50%">
        <stop offset="0%"  stop-color="#5a7da5" />
        <stop offset="65%" stop-color="#3a5a7e" />
        <stop offset="100%" stop-color="#243d57" />
      </radialGradient>
    </defs>

    <!-- Subtle shell halos (very low opacity) -->
    {SHELLS.map((s) => (
      <circle cx={cx} cy={cy} r={s.r + 4}
              fill="none"
              stroke="#1B3A5C"
              stroke-opacity="0.04"
              stroke-width="8" />
    ))}

    <!-- Orbital shell rings -->
    {SHELLS.map((s) => (
      <circle cx={cx} cy={cy} r={s.r}
              fill="none"
              stroke="var(--color-rule-strong)"
              stroke-width="0.8"
              stroke-dasharray={s.key === "geo" ? "4 4" : "1 5"} />
    ))}

    <!-- Shell labels along the right -->
    {SHELLS.map((s) => (
      <>
        <line x1={cx + s.r} x2={cx + s.r + 18} y1={cy} y2={cy}
              stroke="var(--color-rule)" stroke-width="0.6" />
        <text x={cx + s.r + 22} y={cy - 3}
              font-family="var(--font-sans)" font-size="11" font-weight="700"
              fill="var(--color-ink)">
          {s.label}
        </text>
        <text x={cx + s.r + 22} y={cy + 10}
              font-family="var(--font-sans)" font-size="9"
              fill="var(--color-ink-muted)"
              style="letter-spacing: 0.04em;">
          {s.altLabel}
        </text>
      </>
    ))}

    <!-- Earth -->
    <circle cx={cx} cy={cy} r="36" fill="url(#earth-grad)" />
    <text x={cx} y={cy + 5} text-anchor="middle"
          font-family="var(--font-sans)" font-size="10" font-weight="600"
          fill="#FAF8F3"
          style="letter-spacing: 0.16em; text-transform: uppercase;">
      Earth
    </text>

    <!-- Maneuver dots -->
    {placed.map(({ event, x, y, r }, i) => {
      const color = COLOR[event.classification] ?? "var(--color-ink)";
      const ringOpacity = event.confidence === "HIGH" ? 0.7 : 0;
      return (
        <a href={`/sat/${event.norad_id}`} class="orbit-map__dot-link">
          <g class="orbit-map__dot-group" style={`animation-delay: ${(i * 53) % 2400}ms`}>
            <circle
              class="orbit-map__halo"
              cx={x} cy={y} r={r * 2.4}
              fill={color} opacity={ringOpacity}
            />
            <circle
              class="orbit-map__dot"
              cx={x} cy={y} r={r}
              fill={color}
              data-norad={event.norad_id}
              data-class={event.classification}
              data-conf={event.confidence}
              data-epoch-ms={new Date(event.detected_epoch).getTime()}
              data-name={event.object_name ?? `NORAD ${event.norad_id}`}
              data-dv={event.dv_mps}
              data-alt={event.altitude_km}
              data-base-r={r}
              data-color={color}
            />
          </g>
        </a>
      );
    })}
  </svg>
</figure>

<style>
  .orbit-map {
    margin: 0;
    padding: 0;
    background: var(--color-paper);
    position: relative;
  }
  .orbit-map__svg {
    display: block;
    width: 100%;
    height: auto;
    max-width: 760px;
    margin: 0 auto;
  }

  .orbit-map__dot-link { pointer-events: bounding-box; cursor: pointer; }
  .orbit-map__dot {
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transform-origin: center;
    transform-box: fill-box;
  }
  .orbit-map__halo {
    animation: orbit-pulse 3.4s ease-in-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  .orbit-map__dot-group {
    animation: orbit-fade-in 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes orbit-pulse {
    0%, 100% { transform: scale(0.6); opacity: 0.5; }
    50%      { transform: scale(1.1); opacity: 0.05; }
  }
  @keyframes orbit-fade-in {
    from { opacity: 0; transform: scale(0.3); }
    to   { opacity: 1; transform: scale(1); }
  }

  .orbit-map__dot-link:hover .orbit-map__dot {
    transform: scale(1.7);
  }
  .orbit-map__dot-link:hover .orbit-map__halo {
    animation-play-state: paused;
    opacity: 0.35;
    transform: scale(1.8);
  }

  /* JS-applied states (focus + filter) */
  .orbit-map__dot--dimmed   { opacity: 0.1; }
  .orbit-map__dot--related  { opacity: 1 !important; stroke: var(--color-ink); stroke-width: 1.5; }
  .orbit-map__dot--selected {
    transform: scale(1.9);
    stroke: var(--color-ink);
    stroke-width: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-map__halo,
    .orbit-map__dot-group { animation: none; opacity: 0.3; }
    .orbit-map__dot { transition: none; }
  }
</style>
