---
/**
 * Atlas.astro — a scatter "map of the sky lately." X is detected date,
 * Y is altitude (log), each dot is a maneuver. Color = classification,
 * size = Δv magnitude, opacity = confidence. Inline SVG, zero JS.
 *
 * Dots link to /sat/<norad>, so the chart doubles as the navigator —
 * the whole feed is on one page without anyone scrolling a list.
 */

interface Event {
  norad_id: number;
  detected_epoch: string;
  classification: string;
  dv_mps: number;
  altitude_km: number;
  confidence: "HIGH" | "LOW";
  object_name?: string;
}

interface Props {
  events: Event[];
  width?: number;
  height?: number;
  windowDays?: number;
}

const { events, width = 920, height = 460, windowDays = 30 } = Astro.props;

// Per-classification accents. Routine SK is grey on purpose — it
// shouldn't compete visually with real maneuvers.
const COLOR: Record<string, string> = {
  raise:             "#C8602C", // warm rust
  lower:             "#1B3A5C", // ink blue (= site accent)
  plane_change:      "#2E7E5D", // muted green
  stationkeeping_ew: "#B8B2A0", // ink-faint grey
  stationkeeping_ns: "#C9C1A9", // a shade lighter
  deorbit:           "#B33A2A", // red — alarming
};

const M = { l: 64, r: 96, t: 26, b: 44 };
const innerW = width - M.l - M.r;
const innerH = height - M.t - M.b;

// Time axis: last N days, ending now.
const tEnd = Date.now();
const tStart = tEnd - windowDays * 86400 * 1000;
const tSpan = tEnd - tStart;
const px = (ms: number) => M.l + ((ms - tStart) / tSpan) * innerW;

// Altitude axis: log scale, 150 km → 50,000 km (covers LEO through GEO).
// High-eccentric orbits sometimes report enormous a; we clamp them rather
// than blow up the scale.
const aMin = 150;
const aMax = 50000;
const yLog = Math.log(aMin);
const ySpan = Math.log(aMax) - yLog;
const py = (alt: number) => {
  const clipped = Math.max(aMin, Math.min(aMax, alt));
  return M.t + innerH - ((Math.log(clipped) - yLog) / ySpan) * innerH;
};

// Dot radius from Δv (m/s) — small but visibly different at log-Δv ranges.
const rad = (dv: number) => {
  if (!isFinite(dv) || dv <= 0) return 2;
  return Math.max(1.8, Math.min(8.5, 1.6 + Math.log10(dv + 1) * 5));
};

// Filter to the chart's range so dots don't pile on the clamp edges.
const inRange = events.filter((e) => {
  const ms = new Date(e.detected_epoch).getTime();
  return (
    ms >= tStart - 1e6 &&
    ms <= tEnd + 1e6 &&
    e.altitude_km >= aMin * 0.5 &&
    e.altitude_km <= aMax * 1.5
  );
});

// Reference altitudes drawn as faint horizontal rules with right-margin labels.
const refs: { y: number; label: string }[] = [
  { y: 400,    label: "LEO" },
  { y: 1200,   label: "Polar" },
  { y: 20000,  label: "MEO" },
  { y: 35786,  label: "GEO" },
];

// Day-axis ticks: 5 evenly spaced.
const dayTicks: { x: number; label: string }[] = [];
for (let i = 0; i <= 5; i++) {
  const ms = tStart + (i / 5) * tSpan;
  const d = new Date(ms);
  dayTicks.push({
    x: px(ms),
    label: d.toLocaleDateString("en-GB", { day: "2-digit", month: "short" }),
  });
}

// Sort smallest-Δv first so big maneuvers sit on top.
const sorted = [...inRange].sort((a, b) => a.dv_mps - b.dv_mps);
---

<figure class="atlas">
  <svg viewBox={`0 0 ${width} ${height}`} width={width} height={height}
       role="img" aria-label="Detected maneuvers in the last 30 days, by altitude and date">

    <!-- Plot frame -->
    <line x1={M.l} x2={M.l} y1={M.t} y2={M.t + innerH}
          stroke="var(--color-ink)" stroke-width="1" />
    <line x1={M.l} x2={M.l + innerW} y1={M.t + innerH} y2={M.t + innerH}
          stroke="var(--color-ink)" stroke-width="1" />

    <!-- Reference altitudes -->
    {refs.map((r) => {
      const y = py(r.y);
      if (y < M.t || y > M.t + innerH) return null;
      return (
        <>
          <line x1={M.l} x2={M.l + innerW} y1={y} y2={y}
                stroke="var(--color-rule)" stroke-width="0.5"
                stroke-dasharray="3 3" />
          <text x={M.l + innerW + 6} y={y + 4}
                font-family="var(--font-sans)" font-size="10"
                fill="var(--color-ink-muted)">
            {r.label} <tspan fill="var(--color-ink-faint)">{r.y >= 1000 ? `${(r.y / 1000).toFixed(0)}k` : r.y} km</tspan>
          </text>
        </>
      );
    })}

    <!-- Day-axis tick labels -->
    {dayTicks.map((t) => (
      <text x={t.x} y={M.t + innerH + 18} text-anchor="middle"
            font-family="var(--font-sans)" font-size="10"
            fill="var(--color-ink-muted)"
            style="letter-spacing: 0.04em; text-transform: uppercase;">
        {t.label}
      </text>
    ))}

    <!-- Y label -->
    <text x={16} y={M.t + innerH / 2}
          transform={`rotate(-90, 16, ${M.t + innerH / 2})`}
          text-anchor="middle"
          font-family="var(--font-sans)" font-size="10"
          fill="var(--color-ink-muted)"
          style="letter-spacing: 0.06em; text-transform: uppercase;">
      altitude · log scale
    </text>

    <!-- Dots — links to /sat/<norad> -->
    {sorted.map((e) => {
      const cx = px(new Date(e.detected_epoch).getTime());
      const cy = py(e.altitude_km);
      const r = rad(e.dv_mps);
      const color = COLOR[e.classification] ?? "var(--color-ink)";
      const opacity = e.confidence === "HIGH" ? 0.85 : 0.45;
      const title = `${e.object_name ?? `NORAD ${e.norad_id}`}: ${e.classification.replace(/_/g, " ")}, Δv ≈ ${e.dv_mps.toFixed(2)} m/s, alt ${Math.round(e.altitude_km).toLocaleString()} km, ${e.confidence}`;
      return (
        <a href={`/sat/${e.norad_id}`} class="atlas__dot-link">
          <circle cx={cx} cy={cy} r={r}
                  fill={color} opacity={opacity}
                  stroke={e.confidence === "HIGH" ? color : "none"}
                  stroke-width="1">
            <title>{title}</title>
          </circle>
        </a>
      );
    })}
  </svg>

  <ul class="legend" aria-label="Classification legend">
    <li class="legend__entry">
      <span class="legend__dot" style={`background:${COLOR.raise}`} aria-hidden="true"></span>
      <span class="legend__label">orbit raise</span>
    </li>
    <li class="legend__entry">
      <span class="legend__dot" style={`background:${COLOR.lower}`} aria-hidden="true"></span>
      <span class="legend__label">orbit lower</span>
    </li>
    <li class="legend__entry">
      <span class="legend__dot" style={`background:${COLOR.plane_change}`} aria-hidden="true"></span>
      <span class="legend__label">plane change</span>
    </li>
    <li class="legend__entry">
      <span class="legend__dot" style={`background:${COLOR.stationkeeping_ew}`} aria-hidden="true"></span>
      <span class="legend__label">station-keeping</span>
    </li>
    <li class="legend__entry">
      <span class="legend__dot" style={`background:${COLOR.deorbit}`} aria-hidden="true"></span>
      <span class="legend__label">deorbit</span>
    </li>
    <li class="legend__entry legend__entry--note">
      <span class="legend__rule" aria-hidden="true"></span>
      <span class="legend__label">dot size = Δv magnitude · ring = high confidence</span>
    </li>
  </ul>
</figure>

<style>
  .atlas {
    margin: 0;
    padding: var(--space-5) var(--space-4) var(--space-3);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
  }
  .atlas svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .atlas__dot-link circle {
    transition: opacity 140ms ease;
    cursor: pointer;
  }
  .atlas__dot-link:hover circle {
    opacity: 1 !important;
    stroke: var(--color-ink);
    stroke-width: 1.4;
  }

  .legend {
    list-style: none;
    margin: var(--space-4) 0 0 0;
    padding: var(--space-3) 0 0 0;
    border-top: 1px solid var(--color-rule);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .legend__entry {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .legend__entry--note {
    margin-left: auto;
    color: var(--color-ink-faint);
  }
  .legend__dot {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    display: inline-block;
  }
  .legend__rule {
    display: inline-block;
    width: 1.5em;
    height: 1px;
    background: var(--color-rule-strong);
    margin-right: 0.3em;
  }
</style>
