---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import OrbitMap   from "~/components/OrbitMap.astro";
import fs from "node:fs";
import path from "node:path";

interface FeedEvent {
  norad_id: number;
  object_name: string;
  country: string | null;
  constellation: string | null;
  object_type: string | null;
  detected_epoch: string;
  kind: "in_plane" | "out_of_plane";
  classification: string;
  delta_a_km: number | null;
  delta_inc_deg: number | null;
  dv_mps: number;
  snr: number;
  confidence: "HIGH" | "LOW";
  altitude_km: number;
  sparkline: { epoch_iso: string[]; a_km: number[]; altitude_km: number[] };
}
interface Feed { generated_at: string; window_days: number; event_count: number; events: FeedEvent[]; }
interface Summary {
  generated_at: string; window_days: number; payloads_tracked: number;
  events_in_window: number;
  by_classification: Record<string, number>; by_kind: Record<string, number>;
  by_confidence: Record<string, number>; by_constellation: Record<string, number>;
}

function readJson<T>(rel: string, fallback: T): T {
  try {
    const p = path.resolve("./public", rel);
    if (!fs.existsSync(p)) return fallback;
    return JSON.parse(fs.readFileSync(p, "utf-8")) as T;
  } catch { return fallback; }
}

const feed: Feed = readJson("data/feed.json", {
  generated_at: new Date().toISOString(), window_days: 30, event_count: 0, events: [],
});
const summary: Summary = readJson("data/summary.json", {
  generated_at: new Date().toISOString(), window_days: 30, payloads_tracked: 0,
  events_in_window: 0, by_classification: {}, by_kind: {}, by_confidence: {}, by_constellation: {},
});

// Filter to physically sensible events.
const usable = feed.events.filter((e) =>
  e.altitude_km > 100 && e.altitude_km < 50000 && e.dv_mps > 0.005
);

function isSK(c: string) { return c.startsWith("stationkeeping"); }
function score(e: FeedEvent): number {
  const conf    = e.confidence === "HIGH" ? 1.6 : 0.9;
  const routine = isSK(e.classification) ? 0.2 : 1.0;
  const swarm   = e.constellation ? 0.3 : 1.0;
  return e.dv_mps * conf * routine * swarm;
}
const ranked = [...usable].sort((a, b) => score(b) - score(a));
const hero = ranked.length > 0 ? ranked[0] : null;
const moreCards = ranked.slice(1, 9);

// ── Plain-language translators ─────────────────────────────────────
const PLAIN_TYPE: Record<string, string> = {
  raise:               "orbit raised",
  lower:               "orbit lowered",
  deorbit:             "rapid altitude loss",
  plane_change:        "orbital plane shifted",
  stationkeeping_ew:   "routine east-west adjustment",
  stationkeeping_ns:   "routine north-south adjustment",
};

const TYPE_VERB: Record<string, string> = {
  raise:               "raised its orbit",
  lower:               "lowered its orbit",
  deorbit:             "dropped altitude fast",
  plane_change:        "shifted its orbital plane",
  stationkeeping_ew:   "nudged east-or-west",
  stationkeeping_ns:   "nudged north-or-south",
};

function plainAltitude(alt: number): string {
  if (alt < 1000) return `low Earth orbit (${Math.round(alt)} km up)`;
  if (alt < 8000) return `medium-low orbit (${(alt / 1000).toFixed(1)}k km up)`;
  if (alt < 25000) return `medium Earth orbit (${(alt / 1000).toFixed(0)}k km up)`;
  if (alt > 33000 && alt < 38000) return `geostationary orbit (about 36k km up)`;
  return `high orbit (${(alt / 1000).toFixed(0)}k km up)`;
}

function plainSize(dv: number): { label: string; tone: "tiny" | "small" | "medium" | "big" | "huge" } {
  if (dv < 0.05) return { label: "a tiny nudge", tone: "tiny" };
  if (dv < 0.5)  return { label: "a small move", tone: "small" };
  if (dv < 5)    return { label: "a noticeable burn", tone: "medium" };
  if (dv < 50)   return { label: "a significant maneuver", tone: "big" };
  return { label: "a major maneuver", tone: "huge" };
}

function plainDistance(km: number | null): string {
  if (km === null) return "";
  const abs = Math.abs(km);
  if (abs < 0.5) return `about ${(abs * 1000).toFixed(0)} metres`;
  if (abs < 2)   return `about ${abs.toFixed(1)} km`;
  return `about ${Math.round(abs)} km`;
}

function plainAngle(deg: number | null): string {
  if (deg === null) return "";
  const abs = Math.abs(deg);
  if (abs < 0.01) return `under a hundredth of a degree`;
  if (abs < 0.1)  return `${abs.toFixed(3)}°`;
  return `${abs.toFixed(2)}°`;
}

function fmtWhenShort(iso: string) {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
}
function fmtWhenLong(iso: string) {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long" });
}

function buildSentence(e: FeedEvent): string {
  const name = e.object_name ?? `Satellite ${e.norad_id}`;
  const verb = TYPE_VERB[e.classification] ?? "moved";
  const alt = plainAltitude(e.altitude_km);
  if (e.kind === "in_plane" && e.delta_a_km !== null) {
    const dist = plainDistance(e.delta_a_km);
    const dir = e.delta_a_km >= 0 ? "by" : "by";
    return `${name} ${verb} ${dir} ${dist}, in ${alt}.`;
  }
  if (e.kind === "out_of_plane" && e.delta_inc_deg !== null) {
    return `${name} ${verb} by ${plainAngle(e.delta_inc_deg)}, in ${alt}.`;
  }
  return `${name} ${verb} in ${alt}.`;
}

const counts = {
  total:    usable.length,
  confirmed: usable.filter((e) => e.confidence === "HIGH").length,
  watched:  summary.payloads_tracked || (new Set(usable.map((e) => e.norad_id)).size),
};
---
<BaseLayout
  title="SSA — Satellites moving in orbit"
  description="What just moved up there: a daily readout of satellite maneuvers, in plain English."
  pathname="/"
  itemNumber="№ 001"
>
  <article class="page">
    <Container size="wide" class="page__inner">

      <!-- ────────────────── HERO HEADLINE ────────────────── -->
      <header class="hero-head">
        <p class="hero-head__kicker">What moved up there</p>
        <h1 class="hero-head__title">
          <span class="hero-head__num">{counts.total}</span>
          <span class="hero-head__text">satellites changed orbit in the last 30 days.</span>
        </h1>
        <p class="hero-head__lede">
          We watch the public tracking data and look for sudden breaks in
          otherwise smooth orbits. Each break is a thruster firing.
          <a class="hero-head__how" href="/method">How that works ↗</a>
        </p>

        <ul class="stats">
          <li class="stats__cell">
            <span class="stats__num"><span data-counter={counts.total}>0</span></span>
            <span class="stats__lbl">maneuvers detected</span>
          </li>
          <li class="stats__cell">
            <span class="stats__num"><span data-counter={counts.confirmed}>0</span></span>
            <span class="stats__lbl">double-confirmed</span>
          </li>
          <li class="stats__cell">
            <span class="stats__num"><span data-counter={counts.watched}>0</span></span>
            <span class="stats__lbl">satellites watched</span>
          </li>
        </ul>
      </header>

      <!-- ────────────────── ORBIT MAP ────────────────── -->
      {usable.length > 0 && (
        <section class="map-sec">
          <header class="map-sec__head">
            <h2 class="map-sec__title">Every move, on one map</h2>
            <p class="map-sec__sub">
              Each dot is a satellite that just maneuvered, placed on its orbital
              shell. <strong>Hover</strong> for a quick read,
              <strong>click</strong> for the story.
            </p>
          </header>

          <div class="controls">
            <button class="chip is-on" data-filter-class="raise"             type="button"><span class="chip__sw" style="background:#E07A30"></span>raised</button>
            <button class="chip is-on" data-filter-class="lower"             type="button"><span class="chip__sw" style="background:#2A5B9C"></span>lowered</button>
            <button class="chip is-on" data-filter-class="plane_change"      type="button"><span class="chip__sw" style="background:#36906A"></span>plane shift</button>
            <button class="chip is-on" data-filter-class="stationkeeping_ew" type="button"><span class="chip__sw" style="background:#B8B2A0"></span>routine SK</button>
            <button class="chip is-on" data-filter-class="stationkeeping_ns" type="button"><span class="chip__sw" style="background:#C9C1A9"></span>routine SK</button>
            <button class="chip is-on" data-filter-class="deorbit"           type="button"><span class="chip__sw" style="background:#C73E2E"></span>deorbit</button>
            <span class="controls__sep" aria-hidden="true"></span>
            <button class="chip chip--toggle" data-filter-conf="HIGH" type="button" aria-pressed="false">Show double-confirmed only</button>
          </div>

          <OrbitMap events={usable} />

          <!-- Focus panel — JS populates from orbit map hover/click -->
          <aside class="focus" id="focus" aria-live="polite" aria-atomic="true">
            <div class="focus__placeholder">
              <span class="focus__placeholder-icon" aria-hidden="true">↑</span>
              Hover a dot above for a quick read · click to dig in
            </div>
            <article class="focus__card" hidden>
              <header class="focus__head">
                <h3 class="focus__name" id="focus-name"></h3>
                <button class="focus__close" type="button" id="focus-close" aria-label="Clear focus">×</button>
              </header>
              <p class="focus__sentence" id="focus-sentence"></p>
              <ul class="focus__facts">
                <li><span>When</span> <strong id="focus-when"></strong></li>
                <li><span>Size of move</span> <strong id="focus-size"></strong></li>
                <li><span>Where</span> <strong id="focus-where"></strong></li>
                <li><span>How confident</span> <strong id="focus-conf"></strong></li>
              </ul>
              <footer class="focus__foot">
                <a class="focus__open" id="focus-open" href="#">See this satellite's orbit history →</a>
                <span class="focus__related" id="focus-related"></span>
              </footer>
            </article>
          </aside>
        </section>
      )}

      <!-- ────────────────── FEATURED CARD ────────────────── -->
      {hero && (
        <section class="featured">
          <p class="featured__eyebrow">Most notable move this month</p>
          <div class="featured__card">
            <a class="featured__link" href={`/sat/${hero.norad_id}`}>
              <span class={`featured__tag featured__tag--${hero.classification}`}>{PLAIN_TYPE[hero.classification] ?? hero.classification}</span>
              <h2 class="featured__sentence">{buildSentence(hero)}</h2>
              <p class="featured__when">on {fmtWhenLong(hero.detected_epoch)}.</p>
              <span class="featured__cta">See its orbit history →</span>
            </a>
          </div>
        </section>
      )}

      <!-- ────────────────── MORE CARDS ────────────────── -->
      {moreCards.length > 0 && (
        <section class="more">
          <header class="more__head">
            <h2 class="more__title">More worth noting</h2>
            <p class="more__sub">Sorted by how big the move was, with routine adjustments demoted.</p>
          </header>
          <ul class="card-grid">
            {moreCards.map((e) => {
              const size = plainSize(e.dv_mps);
              const tag = PLAIN_TYPE[e.classification] ?? e.classification.replace(/_/g, " ");
              return (
                <li class={`card card--${e.classification} card--${size.tone}`}>
                  <a class="card__link" href={`/sat/${e.norad_id}`}>
                    <span class="card__date">{fmtWhenShort(e.detected_epoch)}</span>
                    <span class="card__tag">{tag}</span>
                    <h3 class="card__sentence">{buildSentence(e)}</h3>
                    <p class="card__size">{size.label} · {e.confidence === "HIGH" ? "double-confirmed" : "single signal"}</p>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <footer class="foot">
        <p class="foot__nb">
          Satellite names are still loading — the public catalog usually fills
          them in within a day, then this page will read "Starlink 12345" and
          the like instead of bare NORAD numbers.
        </p>
      </footer>

    </Container>
  </article>

  <script type="application/json" id="events-data" set:html={JSON.stringify(usable)} />

  <script is:inline>
    (function () {
      const dataNode = document.getElementById("events-data");
      if (!dataNode) return;
      const events = JSON.parse(dataNode.textContent || "[]");
      const byNorad = new Map();
      for (const e of events) {
        const arr = byNorad.get(e.norad_id) || [];
        arr.push(e); byNorad.set(e.norad_id, arr);
      }

      // ── Counter rollups ──────────────────────────────────────
      const counters = document.querySelectorAll("[data-counter]");
      counters.forEach((el) => {
        const target = +el.dataset.counter;
        const dur = 1100;
        const start = performance.now();
        function tick(now) {
          const p = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased).toLocaleString();
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = target.toLocaleString();
        }
        requestAnimationFrame(tick);
      });

      // ── Orbit map hooks ──────────────────────────────────────
      const dots = Array.from(document.querySelectorAll(".orbit-map__dot"));
      if (dots.length === 0) return;

      const focus     = document.getElementById("focus");
      const focusCard = focus && focus.querySelector(".focus__card");
      const focusPh   = focus && focus.querySelector(".focus__placeholder");
      const closeBtn  = document.getElementById("focus-close");

      const PLAIN_TYPE = {
        raise: "orbit raised", lower: "orbit lowered", deorbit: "rapid altitude loss",
        plane_change: "orbital plane shifted",
        stationkeeping_ew: "routine east-west adjustment",
        stationkeeping_ns: "routine north-south adjustment",
      };
      const TYPE_VERB = {
        raise: "raised its orbit", lower: "lowered its orbit",
        deorbit: "dropped altitude fast",
        plane_change: "shifted its orbital plane",
        stationkeeping_ew: "nudged east-or-west",
        stationkeeping_ns: "nudged north-or-south",
      };
      function plainAltitude(a) {
        if (a < 1000) return `low Earth orbit (${Math.round(a)} km up)`;
        if (a < 8000) return `medium-low orbit (${(a / 1000).toFixed(1)}k km up)`;
        if (a < 25000) return `medium Earth orbit (${(a / 1000).toFixed(0)}k km up)`;
        if (a > 33000 && a < 38000) return `geostationary orbit (about 36k km up)`;
        return `high orbit (${(a / 1000).toFixed(0)}k km up)`;
      }
      function plainDistance(km) {
        const abs = Math.abs(km);
        if (abs < 0.5) return `about ${(abs * 1000).toFixed(0)} metres`;
        if (abs < 2)   return `about ${abs.toFixed(1)} km`;
        return `about ${Math.round(abs)} km`;
      }
      function plainAngle(d) {
        const abs = Math.abs(d);
        if (abs < 0.01) return `under a hundredth of a degree`;
        if (abs < 0.1)  return `${abs.toFixed(3)}°`;
        return `${abs.toFixed(2)}°`;
      }
      function plainSizeLabel(dv) {
        if (dv < 0.05) return "a tiny nudge";
        if (dv < 0.5)  return "a small move";
        if (dv < 5)    return "a noticeable burn";
        if (dv < 50)   return "a significant maneuver";
        return "a major maneuver";
      }
      function sentence(e) {
        const name = e.object_name || `Satellite ${e.norad_id}`;
        const verb = TYPE_VERB[e.classification] || "moved";
        const alt = plainAltitude(e.altitude_km);
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          return `${name} ${verb} by ${plainDistance(e.delta_a_km)}, in ${alt}.`;
        }
        if (e.kind === "out_of_plane" && e.delta_inc_deg != null) {
          return `${name} ${verb} by ${plainAngle(e.delta_inc_deg)}, in ${alt}.`;
        }
        return `${name} ${verb} in ${alt}.`;
      }
      function whenLong(iso) {
        const d = new Date(iso);
        return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })
             + " · " + d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" }) + " UTC";
      }

      // ── Filters ──────────────────────────────────────────────
      const activeClasses = new Set(dots.map((d) => d.dataset.class));
      let highOnly = false;
      function applyFilters() {
        dots.forEach((d) => {
          const ok = activeClasses.has(d.dataset.class)
                  && (!highOnly || d.dataset.conf === "HIGH");
          d.classList.toggle("orbit-map__dot--dimmed", !ok && d !== pinnedDot);
        });
        if (pinnedDot) setRelated(+pinnedDot.dataset.norad);
      }
      document.querySelectorAll("[data-filter-class]").forEach((chip) => {
        chip.addEventListener("click", () => {
          const k = chip.dataset.filterClass;
          if (activeClasses.has(k)) { activeClasses.delete(k); chip.classList.remove("is-on"); }
          else { activeClasses.add(k); chip.classList.add("is-on"); }
          applyFilters();
        });
      });
      const highBtn = document.querySelector('[data-filter-conf="HIGH"]');
      if (highBtn) {
        highBtn.addEventListener("click", () => {
          highOnly = !highOnly;
          highBtn.classList.toggle("is-on", highOnly);
          highBtn.setAttribute("aria-pressed", String(highOnly));
          applyFilters();
        });
      }

      // ── Focus state ──────────────────────────────────────────
      let pinnedDot = null;
      function setRelated(noradId) {
        dots.forEach((d) => {
          const sameSat = +d.dataset.norad === noradId;
          d.classList.toggle("orbit-map__dot--related", sameSat && d !== pinnedDot);
        });
      }
      function clearRelated() {
        dots.forEach((d) => d.classList.remove("orbit-map__dot--related", "orbit-map__dot--selected"));
      }
      function clearFocus() {
        if (focusCard) focusCard.hidden = true;
        if (focusPh) focusPh.hidden = false;
        clearRelated();
        clearChange();
      }

      // Draw a small radial / tangential arrow into the orbit map
      // showing the direction of the maneuver.
      const changeLayer = document.querySelector(".orbit-map__change");
      function clearChange() {
        if (changeLayer) changeLayer.innerHTML = "";
      }
      function drawChange(dot, e) {
        if (!changeLayer) return;
        clearChange();
        const cxV = 390, cyV = 390; // matches OrbitMap viewBox centre at size=780
        const px = +dot.getAttribute("cx");
        const py = +dot.getAttribute("cy");
        const theta = +dot.dataset.theta; // angle from centre
        const ns = "http://www.w3.org/2000/svg";
        const arrow = document.createElementNS(ns, "g");
        const tip = document.createElementNS(ns, "line");
        const lbl = document.createElementNS(ns, "text");
        let labelText = "";
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          // Radial: outward for raise (+Δa), inward for lower (-Δa).
          const dir = e.delta_a_km >= 0 ? 1 : -1;
          const len = Math.min(46, 18 + Math.log10(Math.abs(e.delta_a_km) + 1) * 14);
          const x2 = px + dir * len * Math.cos(theta);
          const y2 = py + dir * len * Math.sin(theta);
          tip.setAttribute("x1", px); tip.setAttribute("y1", py);
          tip.setAttribute("x2", x2); tip.setAttribute("y2", y2);
          tip.setAttribute("marker-end", "url(#change-arrow)");
          labelText = (e.delta_a_km >= 0 ? "+" : "") + e.delta_a_km.toFixed(1) + " km";
          lbl.setAttribute("x", x2 + dir * 6 * Math.cos(theta));
          lbl.setAttribute("y", y2 + dir * 6 * Math.sin(theta) - 4);
          lbl.setAttribute("text-anchor", dir > 0 ? "start" : "end");
        } else if (e.kind === "out_of_plane" && e.delta_inc_deg != null) {
          // Tangential along the shell.
          const dir = e.delta_inc_deg >= 0 ? 1 : -1;
          const len = Math.min(50, 24 + Math.log10(Math.abs(e.delta_inc_deg) + 1) * 22);
          const tx = px - dir * len * Math.sin(theta);
          const ty = py + dir * len * Math.cos(theta);
          tip.setAttribute("x1", px); tip.setAttribute("y1", py);
          tip.setAttribute("x2", tx); tip.setAttribute("y2", ty);
          tip.setAttribute("marker-end", "url(#change-arrow)");
          labelText = (e.delta_inc_deg >= 0 ? "+" : "") + Math.abs(e.delta_inc_deg).toFixed(3) + "°";
          lbl.setAttribute("x", tx - dir * 4 * Math.sin(theta));
          lbl.setAttribute("y", ty + dir * 4 * Math.cos(theta) - 4);
          lbl.setAttribute("text-anchor", "middle");
        }
        if (labelText) {
          lbl.textContent = labelText;
          arrow.appendChild(tip);
          arrow.appendChild(lbl);
          changeLayer.appendChild(arrow);
        }
      }

      function updateFocus(dot, pinned) {
        if (!focusCard) return;
        const norad = +dot.dataset.norad;
        const e = (byNorad.get(norad) || []).find(
          (x) => Math.abs(new Date(x.detected_epoch).getTime() - +dot.dataset.epochMs) < 1000
        ) || (byNorad.get(norad) || [])[0];
        if (!e) return;

        focusPh.hidden = true;
        focusCard.hidden = false;

        const name = e.object_name || `Satellite NORAD ${e.norad_id}`;
        document.getElementById("focus-name").textContent = name;
        document.getElementById("focus-sentence").textContent = sentence(e);
        document.getElementById("focus-when").textContent = whenLong(e.detected_epoch);
        document.getElementById("focus-size").textContent =
          plainSizeLabel(e.dv_mps) + " (Δv ≈ " + e.dv_mps.toFixed(2) + " m/s)";
        document.getElementById("focus-where").textContent = plainAltitude(e.altitude_km);
        document.getElementById("focus-conf").textContent =
          e.confidence === "HIGH" ? "Double-confirmed (two tests agreed)" : "Single signal";
        document.getElementById("focus-open").href = `/sat/${e.norad_id}`;

        const related = (byNorad.get(norad) || []).length;
        document.getElementById("focus-related").textContent = related > 1
          ? `This satellite moved ${related}× in the last 30 days`
          : "Only move from this satellite this month";

        if (pinned) {
          pinnedDot = dot;
          dots.forEach((d) => d.classList.toggle("orbit-map__dot--selected", d === dot));
          setRelated(norad);
          drawChange(dot, e);
        }
      }

      dots.forEach((d) => {
        d.addEventListener("mouseenter", () => { if (!pinnedDot) updateFocus(d, false); });
      });
      const mapEl = document.querySelector(".orbit-map__svg");
      if (mapEl) {
        mapEl.addEventListener("mouseleave", () => { if (!pinnedDot) clearFocus(); });
      }
      document.querySelectorAll(".orbit-map__dot-link").forEach((a) => {
        a.addEventListener("click", (e) => {
          const dot = a.querySelector(".orbit-map__dot");
          if (!dot) return;
          e.preventDefault();
          if (pinnedDot === dot) { pinnedDot = null; clearFocus(); }
          else { updateFocus(dot, true); }
        });
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && pinnedDot) { pinnedDot = null; clearFocus(); }
      });
      if (closeBtn) {
        closeBtn.addEventListener("click", () => { pinnedDot = null; clearFocus(); });
      }
    })();
  </script>
</BaseLayout>

<style>
  /* ─────────────────── tokens local to this page ─────────────────── */
  :root {
    --ssa-raise:   #E07A30;
    --ssa-lower:   #2A5B9C;
    --ssa-plane:   #36906A;
    --ssa-sk:      #B8B2A0;
    --ssa-deorbit: #C73E2E;
  }

  /* ─────────────────── shell ─────────────────── */
  .page {
    padding-top: var(--space-10);
    padding-bottom: var(--space-20);
  }
  .page__inner {
    padding-left: var(--space-page);
    padding-right: var(--space-page);
  }

