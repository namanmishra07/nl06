---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import Atlas      from "~/components/Atlas.astro";
import Sparkline  from "~/components/Sparkline.astro";
import fs from "node:fs";
import path from "node:path";

interface FeedEvent {
  norad_id: number;
  object_name: string;
  country: string | null;
  constellation: string | null;
  object_type: string | null;
  detected_epoch: string;
  kind: "in_plane" | "out_of_plane";
  classification: string;
  delta_a_km: number | null;
  delta_inc_deg: number | null;
  dv_mps: number;
  snr: number;
  confidence: "HIGH" | "LOW";
  altitude_km: number;
  sparkline: { epoch_iso: string[]; a_km: number[]; altitude_km: number[] };
}

interface Feed {
  generated_at: string;
  window_days: number;
  event_count: number;
  events: FeedEvent[];
}

interface Summary {
  generated_at: string;
  window_days: number;
  payloads_tracked: number;
  events_in_window: number;
  by_classification: Record<string, number>;
  by_kind: Record<string, number>;
  by_confidence: Record<string, number>;
  by_constellation: Record<string, number>;
}

function readJson<T>(rel: string, fallback: T): T {
  try {
    const p = path.resolve("./public", rel);
    if (!fs.existsSync(p)) return fallback;
    return JSON.parse(fs.readFileSync(p, "utf-8")) as T;
  } catch {
    return fallback;
  }
}

const feed: Feed = readJson("data/feed.json", {
  generated_at: new Date().toISOString(),
  window_days: 30,
  event_count: 0,
  events: [],
});

const summary: Summary = readJson("data/summary.json", {
  generated_at: new Date().toISOString(),
  window_days: 30,
  payloads_tracked: 0,
  events_in_window: 0,
  by_classification: {},
  by_kind: {},
  by_confidence: {},
  by_constellation: {},
});

// ── Filter to physically-sane events ─────────────────────────────────
// Drop high-eccentric orbits where Kozai mean-element a is nonsense
// (altitudes above ~50,000 km), and events too small to be real.
const usable = feed.events.filter((e) =>
  e.altitude_km > 100 && e.altitude_km < 50000 && e.dv_mps > 0.005
);

// ── Score for "worth a look" curation ────────────────────────────────
// HIGH confidence weighs more. Station-keeping is routine and gets
// demoted. Constellation members are also demoted (mostly Starlink
// shell upkeep). Big Δv stays big.
function isSK(c: string) { return c.startsWith("stationkeeping"); }
function score(e: FeedEvent): number {
  const conf = e.confidence === "HIGH" ? 1.6 : 0.9;
  const routine = isSK(e.classification) ? 0.2 : 1.0;
  const swarm = e.constellation ? 0.3 : 1.0;
  return e.dv_mps * conf * routine * swarm;
}

const ranked = [...usable].sort((a, b) => score(b) - score(a));
const hero = ranked.length > 0 ? ranked[0] : null;
const shortlist = ranked.slice(1, 8); // up to 7 notables after the hero

const generatedDate = new Date(feed.generated_at).toLocaleString("en-GB", {
  day: "numeric", month: "long", year: "numeric",
  hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC",
});

const classLabel: Record<string, string> = {
  raise:               "orbit raise",
  lower:               "orbit lower",
  deorbit:             "deorbit",
  plane_change:        "plane change",
  stationkeeping_ew:   "station-keeping (E-W)",
  stationkeeping_ns:   "station-keeping (N-S)",
};

function fmtDv(dv: number): string {
  return dv < 0.1 ? dv.toFixed(3) : dv.toFixed(2);
}

function fmtWhen(iso: string): { date: string; time: string } {
  const d = new Date(iso);
  return {
    date: d.toLocaleDateString("en-GB", { day: "numeric", month: "long" }),
    time: d.toLocaleTimeString("en-GB", {
      hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC",
    }) + " UTC",
  };
}

// Per-class counts for the strip — readable, not exhaustive.
const counts = {
  total:    usable.length,
  raise:    usable.filter((e) => e.classification === "raise").length,
  lower:    usable.filter((e) => e.classification === "lower").length,
  plane:    usable.filter((e) => e.classification === "plane_change").length,
  sk:       usable.filter((e) => isSK(e.classification)).length,
  highConf: usable.filter((e) => e.confidence === "HIGH").length,
};
---
<BaseLayout
  title="SSA — Satellites that maneuvered"
  description="One scatter atlas of every maneuver detected from public orbital data in the last 30 days. The featured event up top, the routine kept quiet."
  pathname="/"
  itemNumber="№ 001"
>
  <article class="lately">
    <Container size="wide" class="lately__inner">

      <!-- ─────────────────── MASTHEAD ─────────────────── -->
      <header class="masthead">
        <div class="masthead__rail">
          <span class="rail__label">The Sky, Lately</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">As of {generatedDate} UTC</span>
        </div>

        <h1 class="masthead__title">
          <span class="masthead__title-pre">Thirty days of</span>
          <span class="masthead__title-main">satellites moving.</span>
        </h1>

        <p class="masthead__lede">
          Every dot below is a thruster firing detected from public orbital
          data &mdash; not telemetry, inference.
          <a href="/method">How this works.</a>
        </p>
      </header>

      <!-- ─────────────────── HERO ─────────────────── -->
      {hero === null ? (
        <p class="lately__empty">
          No usable maneuvers in the last 30 days. The pipeline may be
          mid-bootstrap; check back tomorrow.
        </p>
      ) : (
        <section class="hero" aria-label="Featured maneuver">
          {(() => { const w = fmtWhen(hero.detected_epoch); return (
            <header class="hero__head">
              <span class="hero__eyebrow">Worth a closer look</span>
              <h2 class="hero__name">
                <a href={`/sat/${hero.norad_id}`}>{hero.object_name ?? `NORAD ${hero.norad_id}`}</a>
              </h2>
              <p class="hero__meta">
                NORAD <span class="hero__meta-em">{hero.norad_id}</span>
                {hero.country && <><span class="hero__sep" aria-hidden="true">·</span>{hero.country}</>}
                {hero.constellation && <><span class="hero__sep" aria-hidden="true">·</span>{hero.constellation}</>}
                <span class="hero__sep" aria-hidden="true">·</span>{w.date}, {w.time}
              </p>
            </header>
          )})()}

          <div class="hero__body">
            <p class="hero__story">
              An <span class="hero__story-em">{classLabel[hero.classification] ?? hero.classification.replace(/_/g, " ")}</span>
              {hero.kind === "in_plane" && hero.delta_a_km !== null ? (
                <> &mdash; the orbit&rsquo;s size changed by <span class="hero__story-em">{hero.delta_a_km >= 0 ? "+" : ""}{hero.delta_a_km.toFixed(2)} km</span></>
              ) : hero.delta_inc_deg !== null ? (
                <> &mdash; the orbital plane shifted by <span class="hero__story-em">{hero.delta_inc_deg >= 0 ? "+" : ""}{hero.delta_inc_deg.toFixed(4)}°</span></>
              ) : null}
              {", which puts the implied velocity change at "}
              <span class="hero__story-em">≈ {fmtDv(hero.dv_mps)} m/s</span>.
              Confidence is <span class="hero__story-em">{hero.confidence}</span> &mdash;
              {hero.confidence === "HIGH" ? " both the element-jump test and the SGP4 consistency check agreed." : " only the element-jump test fired, so treat this as provisional."}
            </p>

            <div class="hero__chart">
              <Sparkline
                epochs={hero.sparkline.epoch_iso}
                a_km={hero.sparkline.a_km}
                eventEpoch={hero.detected_epoch}
                classification={hero.classification}
                width={460}
                height={120}
                accentColor={hero.confidence === "HIGH" ? "var(--color-accent)" : "var(--color-ink-muted)"}
              />
              <span class="hero__chart-label">a(t), 90 days &mdash; the kink is the evidence</span>
            </div>
          </div>
        </section>
      )}

      <!-- ─────────────────── ATLAS ─────────────────── -->
      {usable.length > 0 && (
        <section class="atlas-section" aria-label="Atlas of maneuvers">
          <header class="atlas-section__head">
            <h2 class="atlas-section__title">The whole month, at one glance.</h2>
            <p class="atlas-section__sub">
              <span class="atlas-section__num">{counts.total}</span> events.
              <span class="atlas-section__inline">
                {counts.raise} raise, {counts.lower} lower, {counts.plane} plane changes, {counts.sk} routine station-keeping.
              </span>
              <span class="atlas-section__inline">
                {counts.highConf} high-confidence &mdash; both tests agreed.
              </span>
              Hover for detail, click to focus.
            </p>
          </header>

          <!-- Filter chips + replay -->
          <div class="controls" role="toolbar" aria-label="Atlas filters">
            <div class="controls__row controls__row--filters">
              <span class="controls__label">show</span>
              <button class="chip is-on" data-filter-class="raise"             type="button">orbit raise</button>
              <button class="chip is-on" data-filter-class="lower"             type="button">orbit lower</button>
              <button class="chip is-on" data-filter-class="plane_change"      type="button">plane change</button>
              <button class="chip is-on" data-filter-class="stationkeeping_ew" type="button">SK E-W</button>
              <button class="chip is-on" data-filter-class="stationkeeping_ns" type="button">SK N-S</button>
              <button class="chip is-on" data-filter-class="deorbit"           type="button">deorbit</button>
              <span class="controls__sep" aria-hidden="true">·</span>
              <button class="chip chip--toggle" data-filter-conf="HIGH"        type="button" aria-pressed="false">HIGH only</button>
            </div>
            <button class="replay" id="replay" type="button">
              <span class="replay__arrow" aria-hidden="true">↻</span>
              Replay the month
            </button>
          </div>

          <Atlas events={usable} />

          <!-- Focus panel — JS populates from atlas hover/click -->
          <aside class="focus" id="focus" aria-live="polite" aria-atomic="true">
            <div class="focus__placeholder">
              Hover any dot above for detail · click to pin
            </div>
            <article class="focus__card" hidden>
              <header class="focus__head">
                <div class="focus__title-block">
                  <h3 class="focus__name" id="focus-name"></h3>
                  <p class="focus__meta">
                    <span id="focus-meta-norad"></span>
                    <span id="focus-meta-when"></span>
                    <span id="focus-meta-other"></span>
                  </p>
                </div>
                <button class="focus__close" type="button" id="focus-close" aria-label="Clear focus">×</button>
              </header>
              <div class="focus__grid">
                <dl class="focus__numbers">
                  <div class="focus__num">
                    <dt>Type</dt>
                    <dd id="focus-class"></dd>
                  </div>
                  <div class="focus__num">
                    <dt id="focus-delta-label">Δa</dt>
                    <dd id="focus-delta-value"></dd>
                  </div>
                  <div class="focus__num">
                    <dt>Δv</dt>
                    <dd id="focus-dv"></dd>
                  </div>
                  <div class="focus__num">
                    <dt>Altitude</dt>
                    <dd id="focus-alt"></dd>
                  </div>
                  <div class="focus__num">
                    <dt>Confidence</dt>
                    <dd id="focus-conf"></dd>
                  </div>
                  <div class="focus__num">
                    <dt>SNR</dt>
                    <dd id="focus-snr"></dd>
                  </div>
                </dl>
                <div class="focus__chart" id="focus-chart-wrap">
                  <!-- inline SVG sparkline, populated by JS -->
                </div>
              </div>
              <footer class="focus__foot">
                <a class="focus__open" id="focus-open" href="#">Open detail page →</a>
                <span class="focus__related" id="focus-related"></span>
              </footer>
            </article>
          </aside>
        </section>
      )}

      <!-- ─────────────────── SHORTLIST ─────────────────── -->
      {shortlist.length > 0 && (
        <section class="notable" aria-label="Worth-a-look maneuvers">
          <header class="notable__head">
            <h2 class="notable__title">Six more, in order of how big.</h2>
            <p class="notable__sub">Ranked by Δv, with station-keeping and constellation routine demoted.</p>
          </header>
          <ol class="notable__list">
            {shortlist.map((e, i) => {
              const w = fmtWhen(e.detected_epoch);
              return (
                <li class:list={["notable__row", `notable__row--${e.confidence.toLowerCase()}`]}>
                  <span class="notable__rank">№ {String(i + 2).padStart(2, "0")}</span>
                  <span class="notable__main">
                    <a class="notable__name" href={`/sat/${e.norad_id}`}>
                      {e.object_name ?? `NORAD ${e.norad_id}`}
                    </a>
                    <span class="notable__class">{classLabel[e.classification] ?? e.classification.replace(/_/g, " ")}</span>
                  </span>
                  <span class="notable__when">{w.date}</span>
                  <span class="notable__dv">Δv ≈ {fmtDv(e.dv_mps)} m/s</span>
                  <span class="notable__alt">alt. {Math.round(e.altitude_km).toLocaleString()} km</span>
                  <span class:list={["notable__conf", `notable__conf--${e.confidence.toLowerCase()}`]}>{e.confidence}</span>
                </li>
              );
            })}
          </ol>
        </section>
      )}

      <footer class="lately__foot">
        <p class="lately__nb">
          Names and operators are still loading &mdash; the catalog cross-reference
          will fill in on the next nightly pass.
        </p>
        <span class="asterism" aria-hidden="true">⁂</span>
      </footer>

    </Container>
  </article>

  <script type="application/json" id="events-data" set:html={JSON.stringify(usable)} />

  <script is:inline>
    (function () {
      const dataNode = document.getElementById("events-data");
      if (!dataNode) return;
      const events = JSON.parse(dataNode.textContent || "[]");
      const byNorad = new Map();
      for (const e of events) {
        const arr = byNorad.get(e.norad_id) || [];
        arr.push(e);
        byNorad.set(e.norad_id, arr);
      }

      const svg = document.querySelector(".atlas__svg");
      if (!svg) return;
      const atlasEl = svg.closest(".atlas");
      const overlay = svg.querySelector(".atlas__overlay");
      const readout = svg.querySelector(".atlas__readout");
      const readoutBox  = readout && readout.querySelector(".atlas__readout-box");
      const readoutName = readout && readout.querySelector(".atlas__readout-name");
      const readoutMeta = readout && readout.querySelector(".atlas__readout-meta");
      const focus = document.getElementById("focus");
      const focusCard = focus && focus.querySelector(".focus__card");
      const focusPh   = focus && focus.querySelector(".focus__placeholder");
      const closeBtn  = document.getElementById("focus-close");
      const replayBtn = document.getElementById("replay");

      const ML = +svg.dataset.marginL, MR = +svg.dataset.marginR;
      const MT = +svg.dataset.marginT, MB = +svg.dataset.marginB;
      const innerW = +svg.dataset.innerW, innerH = +svg.dataset.innerH;
      const tStart = +svg.dataset.tStart, tEnd = +svg.dataset.tEnd, tSpan = tEnd - tStart;
      const aMin = +svg.dataset.aMin, aMax = +svg.dataset.aMax;
      const yLog = Math.log(aMin), ySpan = Math.log(aMax) - Math.log(aMin);

      const dots = Array.from(svg.querySelectorAll(".atlas__dot"));
      const eventByNorad = new Map();
      events.forEach((e) => {
        const arr = eventByNorad.get(e.norad_id) || [];
        arr.push(e);
        eventByNorad.set(e.norad_id, arr);
      });

      // ── Filter state ────────────────────────────────────────
      const activeClasses = new Set(dots.map((d) => d.dataset.class));
      let highOnly = false;

      function applyFilters() {
        dots.forEach((d) => {
          const ok = activeClasses.has(d.dataset.class)
                  && (!highOnly || d.dataset.conf === "HIGH");
          d.classList.toggle("atlas__dot--dimmed", !ok && d !== pinnedDot);
        });
        if (pinnedDot) reapplyRelated();
      }

      document.querySelectorAll("[data-filter-class]").forEach((chip) => {
        chip.addEventListener("click", () => {
          const k = chip.dataset.filterClass;
          if (activeClasses.has(k)) { activeClasses.delete(k); chip.classList.remove("is-on"); }
          else { activeClasses.add(k); chip.classList.add("is-on"); }
          applyFilters();
        });
      });
      const highBtn = document.querySelector('[data-filter-conf="HIGH"]');
      if (highBtn) {
        highBtn.addEventListener("click", () => {
          highOnly = !highOnly;
          highBtn.classList.toggle("is-on", highOnly);
          highBtn.setAttribute("aria-pressed", String(highOnly));
          applyFilters();
        });
      }

      // ── Hover + crosshair ───────────────────────────────────
      function dateLabel(ms) {
        return new Date(ms).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
      }
      function altFromY(yPx) {
        const norm = (MT + innerH - yPx) / innerH;
        return Math.exp(yLog + norm * ySpan);
      }
      function fmtAlt(km) {
        if (km >= 1000) return (km / 1000).toFixed(1) + "k km";
        return Math.round(km) + " km";
      }

      function ensureCrosshair() {
        if (overlay.children.length > 0) return;
        const ns = "http://www.w3.org/2000/svg";
        ["v", "h"].forEach((k) => {
          const l = document.createElementNS(ns, "line");
          l.setAttribute("class", "atlas__crosshair");
          l.setAttribute("id", `xhair-${k}`);
          overlay.appendChild(l);
        });
        const ldate = document.createElementNS(ns, "text");
        ldate.setAttribute("class", "atlas__crosshair-label");
        ldate.setAttribute("id", "xhair-date");
        ldate.setAttribute("text-anchor", "middle");
        overlay.appendChild(ldate);
        const lalt = document.createElementNS(ns, "text");
        lalt.setAttribute("class", "atlas__crosshair-label");
        lalt.setAttribute("id", "xhair-alt");
        lalt.setAttribute("text-anchor", "end");
        overlay.appendChild(lalt);
      }
      ensureCrosshair();
      const xV = overlay.querySelector("#xhair-v");
      const xH = overlay.querySelector("#xhair-h");
      const xD = overlay.querySelector("#xhair-date");
      const xA = overlay.querySelector("#xhair-alt");

      function hideCrosshair() {
        [xV, xH, xD, xA].forEach((el) => el && el.setAttribute("visibility", "hidden"));
      }
      hideCrosshair();

      function viewboxXY(evt) {
        const rect = svg.getBoundingClientRect();
        const vbW = svg.viewBox.baseVal.width;
        const vbH = svg.viewBox.baseVal.height;
        const x = ((evt.clientX - rect.left) / rect.width) * vbW;
        const y = ((evt.clientY - rect.top) / rect.height) * vbH;
        return [x, y];
      }

      svg.addEventListener("mousemove", (e) => {
        const [x, y] = viewboxXY(e);
        if (x < ML || x > ML + innerW || y < MT || y > MT + innerH) {
          hideCrosshair();
          return;
        }
        const ms = tStart + ((x - ML) / innerW) * tSpan;
        const alt = altFromY(y);
        xV.setAttribute("x1", x); xV.setAttribute("x2", x);
        xV.setAttribute("y1", MT); xV.setAttribute("y2", MT + innerH);
        xH.setAttribute("x1", ML); xH.setAttribute("x2", ML + innerW);
        xH.setAttribute("y1", y); xH.setAttribute("y2", y);
        xD.setAttribute("x", x); xD.setAttribute("y", MT + innerH + 30);
        xD.textContent = dateLabel(ms);
        xA.setAttribute("x", ML + innerW + 80); xA.setAttribute("y", y + 4);
        xA.textContent = fmtAlt(alt);
        [xV, xH, xD, xA].forEach((el) => el.setAttribute("visibility", "visible"));

        // Find nearest dot within ~22 viewBox px
        let best = null, bestD = 22 * 22;
        for (const d of dots) {
          if (d.classList.contains("atlas__dot--dimmed")) continue;
          const cx = +d.getAttribute("cx"), cy = +d.getAttribute("cy");
          const dist2 = (cx - x) ** 2 + (cy - y) ** 2;
          if (dist2 < bestD) { best = d; bestD = dist2; }
        }
        if (best && !pinnedDot) {
          updateFocus(best, /*pinned*/ false);
          showReadoutFor(best);
        } else if (!best && !pinnedDot) {
          if (readout) readout.setAttribute("visibility", "hidden");
        }
      });
      svg.addEventListener("mouseleave", () => {
        hideCrosshair();
        if (readout) readout.setAttribute("visibility", "hidden");
        if (!pinnedDot) clearFocus();
      });

      function showReadoutFor(dot) {
        if (!readout) return;
        const cx = +dot.getAttribute("cx"), cy = +dot.getAttribute("cy");
        const name = dot.dataset.name;
        const cls = (dot.dataset.class || "").replace(/_/g, " ");
        const dv = (+dot.dataset.dv).toFixed(2);
        readoutName.textContent = name;
        readoutMeta.textContent = `${cls} · Δv ≈ ${dv} m/s · ${dot.dataset.conf}`;
        const bb = readoutName.getBBox();
        const bb2 = readoutMeta.getBBox();
        const w = Math.max(bb.width, bb2.width) + 20;
        readoutBox.setAttribute("width", w);
        let x = cx + 14, y = cy - 46;
        if (x + w > ML + innerW) x = cx - w - 14;
        if (y < MT) y = cy + 14;
        readout.setAttribute("transform", `translate(${x.toFixed(1)}, ${y.toFixed(1)})`);
        readoutName.setAttribute("x", 10); readoutName.setAttribute("y", 16);
        readoutMeta.setAttribute("x", 10); readoutMeta.setAttribute("y", 30);
        readout.setAttribute("visibility", "visible");
      }

      // ── Focus panel ──────────────────────────────────────────
      let pinnedDot = null;

      function setRelated(noradId) {
        dots.forEach((d) => {
          const sameSat = +d.dataset.norad === +noradId;
          d.classList.toggle("atlas__dot--related", sameSat && d !== pinnedDot);
        });
      }
      function reapplyRelated() {
        if (pinnedDot) setRelated(pinnedDot.dataset.norad);
      }
      function clearRelated() {
        dots.forEach((d) => d.classList.remove("atlas__dot--related", "atlas__dot--selected"));
      }
      function clearFocus() {
        if (focusCard) focusCard.hidden = true;
        if (focusPh) focusPh.hidden = false;
        clearRelated();
      }

      const classLabel = {
        raise: "orbit raise",
        lower: "orbit lower",
        deorbit: "deorbit",
        plane_change: "plane change",
        stationkeeping_ew: "station-keeping (E-W)",
        stationkeeping_ns: "station-keeping (N-S)",
      };

      function updateFocus(dot, pinned) {
        if (!focusCard) return;
        const norad = +dot.dataset.norad;
        const e = (eventByNorad.get(norad) || []).find(
          (x) => Math.abs(new Date(x.detected_epoch).getTime() - +dot.dataset.epochMs) < 1000
        ) || (eventByNorad.get(norad) || [])[0];
        if (!e) return;

        focusPh.hidden = true;
        focusCard.hidden = false;
        focusCard.classList.toggle("focus__card--pinned", pinned);

        const name = e.object_name || `NORAD ${e.norad_id}`;
        document.getElementById("focus-name").textContent = name;
        document.getElementById("focus-meta-norad").textContent = `NORAD ${e.norad_id}`;
        const d = new Date(e.detected_epoch);
        const when = d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })
                   + " · " + d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" }) + " UTC";
        document.getElementById("focus-meta-when").textContent = when;
        document.getElementById("focus-meta-other").textContent =
          [e.country, e.constellation].filter(Boolean).join(" · ");

        document.getElementById("focus-class").textContent =
          classLabel[e.classification] || e.classification.replace(/_/g, " ");

        const deltaLab = document.getElementById("focus-delta-label");
        const deltaVal = document.getElementById("focus-delta-value");
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          deltaLab.textContent = "Δa";
          deltaVal.textContent = (e.delta_a_km >= 0 ? "+" : "") + e.delta_a_km.toFixed(2) + " km";
        } else if (e.delta_inc_deg != null) {
          deltaLab.textContent = "Δi";
          deltaVal.textContent = (e.delta_inc_deg >= 0 ? "+" : "") + e.delta_inc_deg.toFixed(4) + "°";
        } else {
          deltaLab.textContent = "Δ";
          deltaVal.textContent = "—";
        }
        document.getElementById("focus-dv").textContent =
          (e.dv_mps < 0.1 ? e.dv_mps.toFixed(3) : e.dv_mps.toFixed(2)) + " m/s";
        document.getElementById("focus-alt").textContent =
          Math.round(e.altitude_km).toLocaleString() + " km";
        const confEl = document.getElementById("focus-conf");
        confEl.textContent = e.confidence;
        confEl.className = "focus__conf focus__conf--" + e.confidence.toLowerCase();
        document.getElementById("focus-snr").textContent = e.snr.toFixed(1);
        document.getElementById("focus-open").href = `/sat/${e.norad_id}`;

        const related = byNorad.get(norad) || [];
        const relatedNote = document.getElementById("focus-related");
        relatedNote.textContent = related.length > 1
          ? `${related.length} maneuvers from this satellite in the window`
          : "Only event from this satellite in the window";

        const chartWrap = document.getElementById("focus-chart-wrap");
        chartWrap.innerHTML = renderSparkline(e);

        if (pinned) {
          pinnedDot = dot;
          dots.forEach((d) => d.classList.toggle("atlas__dot--selected", d === dot));
          setRelated(norad);
        }
      }

      function renderSparkline(e) {
        const sp = e.sparkline || {};
        const ep = sp.epoch_iso || [];
        const a = sp.a_km || [];
        if (ep.length < 2) return '<span class="focus__chart-empty">No 90-day series.</span>';
        const W = 420, H = 110, m = { l: 8, r: 8, t: 12, b: 22 };
        const iw = W - m.l - m.r, ih = H - m.t - m.b;
        const ts = ep.map((s) => new Date(s).getTime());
        const tMin = ts[0], tMax = ts[ts.length - 1], tSp = Math.max(1, tMax - tMin);
        const aMin2 = Math.min.apply(null, a), aMax2 = Math.max.apply(null, a);
        const pad = Math.max(0.001, (aMax2 - aMin2) * 0.15);
        const yLo = aMin2 - pad, yHi = aMax2 + pad;
        const X = (t) => m.l + ((t - tMin) / tSp) * iw;
        const Y = (v) => m.t + ih - ((v - yLo) / (yHi - yLo)) * ih;
        let d = "";
        for (let i = 0; i < ts.length; i++) {
          d += (i === 0 ? "M" : "L") + X(ts[i]).toFixed(1) + "," + Y(a[i]).toFixed(1);
        }
        const evMs = new Date(e.detected_epoch).getTime();
        const evX = (evMs >= tMin && evMs <= tMax) ? X(evMs) : null;
        const accent = e.confidence === "HIGH" ? "var(--color-accent)" : "var(--color-ink-muted)";
        return `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" class="focus__svg" role="img" aria-label="a(t) sparkline for the satellite">
          <line x1="${m.l}" x2="${W - m.r}" y1="${m.t + ih}" y2="${m.t + ih}" stroke="var(--color-rule)" stroke-width="0.6"/>
          ${evX !== null ? `<line x1="${evX}" x2="${evX}" y1="${m.t}" y2="${m.t + ih}" stroke="${accent}" stroke-width="1.3" stroke-dasharray="3 3" opacity="0.85"/>` : ""}
          <path d="${d}" fill="none" stroke="var(--color-ink)" stroke-width="1.1"/>
          <text x="${m.l}" y="${H - 6}" font-family="var(--font-sans)" font-size="9" fill="var(--color-ink-muted)" style="letter-spacing:0.06em;text-transform:uppercase">a(t) · 90d · the kink is the evidence</text>
        </svg>`;
      }

      svg.addEventListener("click", (e) => {
        const a = e.target.closest("a.atlas__dot-link");
        if (!a) return;
        const dot = a.querySelector(".atlas__dot");
        if (!dot) return;
        e.preventDefault();
        if (pinnedDot === dot) {
          pinnedDot = null;
          clearFocus();
        } else {
          updateFocus(dot, /*pinned*/ true);
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && pinnedDot) {
          pinnedDot = null;
          clearFocus();
        }
      });
      if (closeBtn) {
        closeBtn.addEventListener("click", () => {
          pinnedDot = null;
          clearFocus();
        });
      }

      // ── Replay animation ─────────────────────────────────────
      let replayTimer = null;
      function replay() {
        if (!atlasEl) return;
        if (replayTimer) { cancelAnimationFrame(replayTimer); replayTimer = null; }
        const visible = dots.filter((d) => !d.classList.contains("atlas__dot--dimmed"));
        if (visible.length === 0) return;
        visible.forEach((d) => { d.style.opacity = "0"; d.style.transform = "scale(0.3)"; });
        const sorted = [...visible].sort((a, b) => +a.dataset.epochMs - +b.dataset.epochMs);
        const tFirst = +sorted[0].dataset.epochMs;
        const tLast = +sorted[sorted.length - 1].dataset.epochMs;
        const tWin = Math.max(1, tLast - tFirst);
        const DUR = 2500;
        const start = performance.now();
        let i = 0;
        function tick(now) {
          const prog = (now - start) / DUR;
          const cutoff = tFirst + prog * tWin;
          while (i < sorted.length && +sorted[i].dataset.epochMs <= cutoff) {
            sorted[i].style.opacity = "";
            sorted[i].style.transform = "";
            i++;
          }
          if (prog < 1) {
            replayTimer = requestAnimationFrame(tick);
          } else {
            sorted.forEach((d) => { d.style.opacity = ""; d.style.transform = ""; });
            replayTimer = null;
          }
        }
        replayTimer = requestAnimationFrame(tick);
      }
      if (replayBtn) replayBtn.addEventListener("click", replay);

      // ── First-load entrance ──────────────────────────────────
      // Subtle staggered fade-in on first paint — gives the atlas a sense
      // of coming together rather than slamming in.
      requestAnimationFrame(() => requestAnimationFrame(() => replay()));
    })();
  </script>
</BaseLayout>

