---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import fs from "node:fs";
import path from "node:path";

interface FeedEvent {
  norad_id: number;
  object_name: string;
  country: string | null;
  constellation: string | null;
  object_type: string | null;
  detected_epoch: string;
  kind: "in_plane" | "out_of_plane";
  classification: string;
  delta_a_km: number | null;
  delta_inc_deg: number | null;
  dv_mps: number;
  snr: number;
  confidence: "HIGH" | "LOW";
  altitude_km: number;
  a_km_at_event: number | null;
  inc_deg_at_event: number | null;
  sparkline: { epoch_iso: string[]; a_km: number[]; altitude_km: number[] };
}
interface Feed { generated_at: string; window_days: number; event_count: number; events: FeedEvent[]; }

function readJson<T>(rel: string, fallback: T): T {
  try {
    const p = path.resolve("./public", rel);
    if (!fs.existsSync(p)) return fallback;
    return JSON.parse(fs.readFileSync(p, "utf-8")) as T;
  } catch { return fallback; }
}

const feed: Feed = readJson("data/feed.json", {
  generated_at: new Date().toISOString(), window_days: 30, event_count: 0, events: [],
});

const usable = feed.events.filter((e) =>
  e.altitude_km > 100 && e.altitude_km < 50000 && e.dv_mps > 0.005
);

function isSK(c: string) { return c.startsWith("stationkeeping"); }
function score(e: FeedEvent): number {
  const conf    = e.confidence === "HIGH" ? 1.6 : 0.9;
  const routine = isSK(e.classification) ? 0.2 : 1.0;
  const swarm   = e.constellation ? 0.3 : 1.0;
  return e.dv_mps * conf * routine * swarm;
}
const ordered = [...usable].sort((a, b) => score(b) - score(a));
const totalEvents = ordered.length;

const generatedDate = new Date(feed.generated_at);
const generatedDisplay = generatedDate.toLocaleString("en-GB", {
  day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit",
  hour12: false, timeZone: "UTC",
}) + " UTC";

const PLAIN_TAG: Record<string, string> = {
  raise: "Raised", lower: "Lowered", deorbit: "Deorbit",
  plane_change: "Plane shift",
  stationkeeping_ew: "SK East-West",
  stationkeeping_ns: "SK North-South",
};
---
<BaseLayout
  title="SSA — Live satellite tracker"
  description="Satellite stalking from public orbital data: every maneuver detected in the last 30 days, in one console view."
  pathname="/"
  itemNumber="№ 001"
>
  <article class="console-page">
    <Container size="full" class="console-page__inner">

      <!-- ─── tracker bar ─── -->
      <header class="trackbar">
        <div class="trackbar__left">
          <span class="trackbar__pulse" aria-hidden="true"></span>
          <span class="trackbar__lbl">Tracking</span>
          <span class="trackbar__sep">·</span>
          <span class="trackbar__title">
            <span class="trackbar__title-pre">Satellites in</span>
            <span class="trackbar__title-main">motion.</span>
          </span>
        </div>
        <div class="trackbar__right">
          <span class="trackbar__stat">
            <span class="trackbar__num">{totalEvents}</span>
            <span class="trackbar__lbl">events · 30d</span>
          </span>
          <span class="trackbar__sep">·</span>
          <span class="trackbar__stat">
            <span class="trackbar__lbl">Last fetch</span>
            <span class="trackbar__when">{generatedDisplay}</span>
          </span>
          <span class="trackbar__sep">·</span>
          <a class="trackbar__link" href="/method">Method ↗</a>
        </div>
      </header>

      {ordered.length === 0 ? (
        <p class="console-empty">
          No usable maneuvers in the last 30 days. Pipeline may be mid-bootstrap.
        </p>
      ) : (
        <section class="console" aria-label="Maneuver console">

          <!-- ─── LEFT: events list ─── -->
          <aside class="col col--events" aria-label="Event log">
            <header class="col__head">
              <h2 class="col__title">Event log</h2>
              <div class="filter-chips" role="toolbar" aria-label="Filter by type">
                <button class="fchip is-on" data-fc="raise"             type="button" title="Orbit raised">
                  <span class="fchip__sw" style="background:#E07A30"></span>R
                </button>
                <button class="fchip is-on" data-fc="lower"             type="button" title="Orbit lowered">
                  <span class="fchip__sw" style="background:#2A5B9C"></span>L
                </button>
                <button class="fchip is-on" data-fc="plane_change"      type="button" title="Plane shift">
                  <span class="fchip__sw" style="background:#36906A"></span>P
                </button>
                <button class="fchip is-on" data-fc="stationkeeping_ew" type="button" title="SK east-west">
                  <span class="fchip__sw" style="background:#B8B2A0"></span>SK
                </button>
                <button class="fchip is-on" data-fc="stationkeeping_ns" type="button" title="SK north-south">
                  <span class="fchip__sw" style="background:#C9C1A9"></span>SK
                </button>
                <button class="fchip is-on" data-fc="deorbit"           type="button" title="Deorbit">
                  <span class="fchip__sw" style="background:#C73E2E"></span>D
                </button>
                <button class="fchip fchip--toggle" data-fc-conf="HIGH" type="button"
                        title="Show double-confirmed only" aria-pressed="false">
                  ✓
                </button>
              </div>
            </header>
            <ol class="log" id="log" role="listbox" aria-label="All maneuver events">
              {ordered.map((e, i) => {
                const d = new Date(e.detected_epoch);
                const date = d.toLocaleDateString("en-GB", { day: "2-digit", month: "short" });
                const time = d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" });
                return (
                  <li>
                    <button
                      class={`log__row log__row--${e.classification}`}
                      type="button"
                      role="option"
                      data-idx={i}
                      aria-selected="false">
                      <span class="log__date">{date}</span>
                      <span class="log__time">{time}</span>
                      <span class="log__tag">{PLAIN_TAG[e.classification] ?? e.classification}</span>
                      <span class="log__name">{e.object_name ?? `NORAD ${e.norad_id}`}</span>
                      <span class={`log__conf log__conf--${e.confidence.toLowerCase()}`}>{e.confidence === "HIGH" ? "✓" : "·"}</span>
                    </button>
                  </li>
                );
              })}
            </ol>
            <div class="col__foot">
              <span class="col__counter" id="log-counter">— / {totalEvents}</span>
            </div>
          </aside>

          <!-- ─── CENTER: the stage ─── -->
          <div class="col col--stage">
            <div class="stage">
              <svg
                class="stage__svg"
                viewBox="0 0 700 480"
                role="img"
                aria-label="Animated diagram of one satellite maneuver"
              >
                <defs>
                  <radialGradient id="t-earth" cx="38%" cy="38%" r="65%">
                    <stop offset="0%"  stop-color="#6f93b9" />
                    <stop offset="58%" stop-color="#3a5a7e" />
                    <stop offset="100%" stop-color="#1f3349" />
                  </radialGradient>
                  <clipPath id="t-earth-clip">
                    <circle cx="350" cy="240" r="26" />
                  </clipPath>
                  <linearGradient id="sweep-grad" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%"   stop-color="#1B3A5C" stop-opacity="0" />
                    <stop offset="60%"  stop-color="#1B3A5C" stop-opacity="0" />
                    <stop offset="100%" stop-color="#1B3A5C" stop-opacity="0.14" />
                  </linearGradient>
                  <marker id="t-arrow" markerWidth="10" markerHeight="10" refX="7" refY="5" orient="auto">
                    <path d="M0,1 L8,5 L0,9 L1.5,5 Z" fill="#E07A30" />
                  </marker>
                  <marker id="t-arrow-blue" markerWidth="10" markerHeight="10" refX="7" refY="5" orient="auto">
                    <path d="M0,1 L8,5 L0,9 L1.5,5 Z" fill="#2A5B9C" />
                  </marker>
                  <marker id="t-arrow-green" markerWidth="10" markerHeight="10" refX="7" refY="5" orient="auto">
                    <path d="M0,1 L8,5 L0,9 L1.5,5 Z" fill="#36906A" />
                  </marker>
                </defs>

                <!-- Scanner sweep -->
                <g class="stage__sweep">
                  <path d="M 350,240 L 690,240 A 340 340 0 0 1 657,323 Z" fill="url(#sweep-grad)" />
                </g>

                <!-- Background regime rings -->
                {[100, 150, 200, 250].map((r) => (
                  <circle cx="350" cy="240" r={r}
                          fill="none" stroke="var(--color-rule)"
                          stroke-width="0.5"
                          stroke-dasharray="1 8" />
                ))}

                <!-- Coordinate cross-hairs (faint) -->
                <line x1="60" y1="240" x2="640" y2="240"
                      stroke="var(--color-rule)" stroke-width="0.4"
                      stroke-dasharray="2 6" opacity="0.6" />
                <line x1="350" y1="40" x2="350" y2="440"
                      stroke="var(--color-rule)" stroke-width="0.4"
                      stroke-dasharray="2 6" opacity="0.6" />

                <!-- Old + new orbit rings -->
                <ellipse id="orbit-before" cx="350" cy="240" rx="160" ry="160"
                         fill="none" stroke="var(--color-ink-muted)"
                         stroke-width="1" stroke-dasharray="4 4" opacity="0.6" />
                <ellipse id="orbit-after"  cx="350" cy="240" rx="170" ry="170"
                         fill="none" stroke="#E07A30" stroke-width="2.5" />

                <!-- Earth -->
                <g class="t-earth">
                  <circle cx="350" cy="240" r="26" fill="url(#t-earth)" />
                  <g clip-path="url(#t-earth-clip)" fill="#1f3349" fill-opacity="0.55">
                    <path d="M 351,233 C 358,233 360,238 358,243 C 356,247 352,249 350,248 C 348,247 348,243 349,239 C 350,236 351,233 351,233 Z" />
                    <path d="M 344,231 C 348,228 354,228 359,231 C 356,233 351,234 347,234 C 345,234 343,233 344,231 Z" />
                    <ellipse cx="358" cy="248" rx="3" ry="1.5" />
                  </g>
                  <circle cx="364" cy="240" r="26" fill="#000" fill-opacity="0.16"
                          clip-path="url(#t-earth-clip)" />
                </g>

                <!-- Burn marker + satellite -->
                <g id="burn-marker" opacity="0">
                  <line id="burn-line" x1="0" y1="0" x2="0" y2="0"
                        stroke="#E07A30" stroke-width="2.5"
                        marker-end="url(#t-arrow)" />
                </g>
                <g id="satellite">
                  <circle cx="0" cy="0" r="4.5" fill="var(--color-ink)" />
                  <circle cx="0" cy="0" r="9" fill="none"
                          stroke="var(--color-ink)" stroke-width="0.8"
                          stroke-dasharray="2 3" opacity="0.5" />
                </g>

                <!-- Δ label -->
                <text id="stage-delta-label" x="0" y="0"
                      font-family="var(--font-sans)" font-size="13" font-weight="800"
                      fill="var(--color-ink)" text-anchor="middle"
                      style="letter-spacing: 0.02em;">
                </text>

                <!-- Coordinate readout overlay (top-left corner) -->
                <g class="stage__hud">
                  <rect x="14" y="14" width="170" height="40" fill="var(--color-paper)" stroke="var(--color-rule)" stroke-width="0.6" rx="2" />
                  <text x="22" y="29" font-family="var(--font-sans)" font-size="9" font-weight="700"
                        fill="var(--color-ink-muted)" style="letter-spacing: 0.1em; text-transform: uppercase;">
                    NORAD <tspan id="hud-norad" fill="var(--color-ink)">—</tspan>
                  </text>
                  <text x="22" y="44" font-family="var(--font-sans)" font-size="9" font-weight="600"
                        fill="var(--color-ink-soft)" style="letter-spacing: 0.06em;">
                    <tspan id="hud-coords">ALT — · INC —</tspan>
                  </text>
                </g>

                <!-- Stage label (bottom-right corner) -->
                <text x="686" y="468" text-anchor="end"
                      font-family="var(--font-sans)" font-size="9"
                      fill="var(--color-ink-faint)"
                      style="letter-spacing: 0.08em; text-transform: uppercase;">
                  diagram · not to scale
                </text>
              </svg>

              <!-- Stage controls (overlay) -->
              <div class="stage__controls">
                <button class="sctrl" id="prev-btn" type="button" aria-label="Previous (←)" title="Previous">←</button>
                <button class="sctrl sctrl--play" id="play-btn" type="button" aria-pressed="false" title="Play (space replays)">
                  <span id="play-icon">▶</span>
                </button>
                <button class="sctrl" id="replay-btn" type="button" title="Replay">↻</button>
                <button class="sctrl" id="next-btn" type="button" aria-label="Next (→)" title="Next">→</button>
              </div>
            </div>
          </div>

          <!-- ─── RIGHT: detail readout ─── -->
          <aside class="col col--detail" aria-label="Selected event detail">
            <header class="col__head">
              <h2 class="col__title">Readout</h2>
              <span class="col__counter" id="detail-counter">— / {totalEvents}</span>
            </header>
            <div class="readout">
              <span class="readout__tag" id="r-tag"></span>
              <h3 class="readout__name" id="r-name"></h3>
              <p class="readout__sentence" id="r-sentence"></p>

              <dl class="readout__data">
                <div><dt>NORAD</dt><dd id="r-norad" class="mono"></dd></div>
                <div><dt>When</dt><dd id="r-when"></dd></div>
                <div><dt>Where</dt><dd id="r-where"></dd></div>
                <div><dt>Change</dt><dd id="r-change" class="mono"></dd></div>
                <div><dt>Size</dt><dd id="r-size"></dd></div>
                <div><dt>Confidence</dt><dd id="r-conf"></dd></div>
                <div><dt>Est. Δv</dt><dd id="r-dv" class="mono"></dd></div>
              </dl>

              <div class="readout__chart" id="r-chart-wrap"></div>

              <footer class="readout__foot">
                <a class="readout__open" id="r-open" href="#">See history →</a>
                <span class="readout__related" id="r-related"></span>
              </footer>
            </div>
          </aside>
        </section>
      )}
    </Container>
  </article>

  <script type="application/json" id="events-data" set:html={JSON.stringify(ordered)} />

  <script is:inline>
    (function () {
      const dataNode = document.getElementById("events-data");
      if (!dataNode) return;
      const events = JSON.parse(dataNode.textContent || "[]");
      if (events.length === 0) return;

      // ── DOM refs ────────────────────────────────────────────
      const prevBtn = document.getElementById("prev-btn");
      const nextBtn = document.getElementById("next-btn");
      const replayBtn = document.getElementById("replay-btn");
      const playBtn = document.getElementById("play-btn");
      const playIcon = document.getElementById("play-icon");

      const orbitBefore = document.getElementById("orbit-before");
      const orbitAfter  = document.getElementById("orbit-after");
      const satellite   = document.getElementById("satellite");
      const burnMarker  = document.getElementById("burn-marker");
      const burnLine    = document.getElementById("burn-line");
      const deltaLabel  = document.getElementById("stage-delta-label");
      const hudNorad    = document.getElementById("hud-norad");
      const hudCoords   = document.getElementById("hud-coords");

      // Readout panel
      const rTag = document.getElementById("r-tag");
      const rName = document.getElementById("r-name");
      const rSentence = document.getElementById("r-sentence");
      const rNorad = document.getElementById("r-norad");
      const rWhen = document.getElementById("r-when");
      const rWhere = document.getElementById("r-where");
      const rChange = document.getElementById("r-change");
      const rSize = document.getElementById("r-size");
      const rConf = document.getElementById("r-conf");
      const rDv = document.getElementById("r-dv");
      const rChartWrap = document.getElementById("r-chart-wrap");
      const rOpen = document.getElementById("r-open");
      const rRelated = document.getElementById("r-related");
      const detailCounter = document.getElementById("detail-counter");
      const logCounter = document.getElementById("log-counter");

      const logRows = Array.from(document.querySelectorAll(".log__row"));

      // ── Constants ───────────────────────────────────────────
      const CX = 350, CY = 240;
      const COLOR = {
        raise: "#E07A30", lower: "#2A5B9C", plane_change: "#36906A",
        stationkeeping_ew: "#B8B2A0", stationkeeping_ns: "#C9C1A9",
        deorbit: "#C73E2E",
      };
      const ARROW = {
        raise: "url(#t-arrow)", lower: "url(#t-arrow-blue)",
        plane_change: "url(#t-arrow-green)",
        stationkeeping_ew: "url(#t-arrow)",
        stationkeeping_ns: "url(#t-arrow)",
        deorbit: "url(#t-arrow)",
      };
      const PLAIN_TAG = {
        raise: "Orbit raised", lower: "Orbit lowered",
        deorbit: "Rapid altitude loss", plane_change: "Orbital plane shifted",
        stationkeeping_ew: "Routine east-west adjustment",
        stationkeeping_ns: "Routine north-south adjustment",
      };
      const TYPE_VERB = {
        raise: "raised its orbit", lower: "lowered its orbit",
        deorbit: "dropped altitude fast",
        plane_change: "shifted its orbital plane",
        stationkeeping_ew: "nudged east-or-west",
        stationkeeping_ns: "nudged north-or-south",
      };

      // ── Language ────────────────────────────────────────────
      function plainAltitude(a) {
        if (a < 1000) return `low Earth orbit (${Math.round(a)} km up)`;
        if (a < 8000) return `medium-low orbit (${(a / 1000).toFixed(1)}k km)`;
        if (a < 25000) return `medium Earth orbit (${(a / 1000).toFixed(0)}k km)`;
        if (a > 33000 && a < 38000) return `geostationary (about 36k km)`;
        return `high orbit (${(a / 1000).toFixed(0)}k km)`;
      }
      function plainSize(dv) {
        if (dv < 0.05) return "a tiny nudge";
        if (dv < 0.5)  return "a small move";
        if (dv < 5)    return "a noticeable burn";
        if (dv < 50)   return "a significant maneuver";
        return "a major maneuver";
      }
      function plainDistance(km) {
        const abs = Math.abs(km);
        if (abs < 0.5) return `about ${(abs * 1000).toFixed(0)} m`;
        if (abs < 2)   return `about ${abs.toFixed(1)} km`;
        return `about ${Math.round(abs)} km`;
      }
      function plainAngle(d) {
        const abs = Math.abs(d);
        if (abs < 0.01) return `under 0.01°`;
        if (abs < 0.1)  return `${abs.toFixed(3)}°`;
        return `${abs.toFixed(2)}°`;
      }
      function buildSentence(e) {
        const name = e.object_name || `Satellite NORAD ${e.norad_id}`;
        const verb = TYPE_VERB[e.classification] || "moved";
        const alt = plainAltitude(e.altitude_km);
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          return `${name} ${verb} by ${plainDistance(e.delta_a_km)}, in ${alt}.`;
        }
        if (e.kind === "out_of_plane" && e.delta_inc_deg != null) {
          return `${name} ${verb} by ${plainAngle(e.delta_inc_deg)}, in ${alt}.`;
        }
        return `${name} ${verb} in ${alt}.`;
      }

      // ── Geometry ────────────────────────────────────────────
      function baseRadius(altKm) {
        if (altKm < 2000)  return 105;
        if (altKm < 7000)  return 145;
        if (altKm < 25000) return 190;
        return 230;
      }
      function gapForDeltaA(deltaKm) {
        const abs = Math.abs(deltaKm || 0);
        return Math.max(10, Math.min(54, 8 + Math.log10(abs + 1) * 24));
      }
      function tiltForDeltaInc(deltaDeg) {
        const abs = Math.abs(deltaDeg || 0);
        return Math.max(0.05, Math.min(0.32, abs * 5));
      }
      function angleFor(noradId) {
        let x = noradId | 0;
        x ^= x << 13; x ^= x >>> 17; x ^= x << 5;
        return (((x >>> 0) % 100000) / 100000) * Math.PI * 2;
      }
      function easeInOutCubic(t) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      // ── State ───────────────────────────────────────────────
      let currentIdx = 0;
      let animationId = null;
      let autoTimer = null;
      const activeClasses = new Set(["raise", "lower", "plane_change", "stationkeeping_ew", "stationkeeping_ns", "deorbit"]);
      let highOnly = false;

      // ── Sparkline render ────────────────────────────────────
      function renderSparkline(e) {
        const sp = e.sparkline || {};
        const ep = sp.epoch_iso || [];
        const a  = sp.a_km || [];
        if (ep.length < 2) return '<span class="readout__chart-empty">No 90-day series.</span>';
        const W = 268, H = 80, m = { l: 4, r: 4, t: 8, b: 18 };
        const iw = W - m.l - m.r, ih = H - m.t - m.b;
        const ts = ep.map((s) => new Date(s).getTime());
        const tMin = ts[0], tMax = ts[ts.length - 1], tSp = Math.max(1, tMax - tMin);
        const aMin = Math.min.apply(null, a), aMax = Math.max.apply(null, a);
        const pad = Math.max(0.001, (aMax - aMin) * 0.18);
        const yLo = aMin - pad, yHi = aMax + pad;
        const X = (t) => m.l + ((t - tMin) / tSp) * iw;
        const Y = (v) => m.t + ih - ((v - yLo) / (yHi - yLo)) * ih;
        let d = "";
        for (let i = 0; i < ts.length; i++) {
          d += (i === 0 ? "M" : "L") + X(ts[i]).toFixed(1) + "," + Y(a[i]).toFixed(1);
        }
        const evMs = new Date(e.detected_epoch).getTime();
        const evX = (evMs >= tMin && evMs <= tMax) ? X(evMs) : null;
        const accent = COLOR[e.classification] || "#1B3A5C";
        return `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" class="readout__svg" role="img" aria-label="a(t) sparkline">
          <line x1="${m.l}" x2="${W - m.r}" y1="${m.t + ih}" y2="${m.t + ih}" stroke="var(--color-rule)" stroke-width="0.6"/>
          ${evX !== null ? `<line x1="${evX}" x2="${evX}" y1="${m.t}" y2="${m.t + ih}" stroke="${accent}" stroke-width="1.3" stroke-dasharray="3 3" opacity="0.85"/>` : ""}
          <path d="${d}" fill="none" stroke="var(--color-ink)" stroke-width="1.1"/>
          <text x="${m.l}" y="${H - 4}" font-family="var(--font-sans)" font-size="8" fill="var(--color-ink-muted)" style="letter-spacing:0.06em;text-transform:uppercase">a(t) · 90d · kink = burn</text>
        </svg>`;
      }

      // ── Burn arrow + label ──────────────────────────────────
      function placeBurnArrow(e, sx, sy, theta) {
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          const dir = e.delta_a_km >= 0 ? 1 : -1;
          const len = 20 + Math.log10(Math.abs(e.delta_a_km) + 1) * 14;
          burnLine.setAttribute("x1", sx); burnLine.setAttribute("y1", sy);
          burnLine.setAttribute("x2", sx + dir * len * Math.cos(theta));
          burnLine.setAttribute("y2", sy + dir * len * Math.sin(theta));
          burnLine.setAttribute("stroke", COLOR[e.classification]);
          burnLine.setAttribute("marker-end", ARROW[e.classification]);
        } else if (e.kind === "out_of_plane" && e.delta_inc_deg != null) {
          const dir = e.delta_inc_deg >= 0 ? 1 : -1;
          const len = 22 + Math.log10(Math.abs(e.delta_inc_deg) + 1) * 28;
          burnLine.setAttribute("x1", sx); burnLine.setAttribute("y1", sy);
          burnLine.setAttribute("x2", sx - dir * len * Math.sin(theta));
          burnLine.setAttribute("y2", sy + dir * len * Math.cos(theta));
          burnLine.setAttribute("stroke", COLOR[e.classification]);
          burnLine.setAttribute("marker-end", ARROW[e.classification]);
        }
      }
      function placeDeltaLabel(e, sx, sy, theta) {
        let txt = "";
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          txt = (e.delta_a_km >= 0 ? "+" : "") + e.delta_a_km.toFixed(2) + " km";
        } else if (e.delta_inc_deg != null) {
          txt = (e.delta_inc_deg >= 0 ? "+" : "") + Math.abs(e.delta_inc_deg).toFixed(3) + "°";
        }
        deltaLabel.textContent = txt;
        deltaLabel.setAttribute("x", (sx + 32 * Math.cos(theta)).toFixed(1));
        deltaLabel.setAttribute("y", (sy + 32 * Math.sin(theta) + 5).toFixed(1));
        deltaLabel.setAttribute("fill", COLOR[e.classification] || "var(--color-ink)");
      }

      // ── Main render + animate ──────────────────────────────
      function setSatPos(x, y) {
        satellite.setAttribute("transform", `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
      }

      function renderAndAnimate(idx) {
        if (animationId) cancelAnimationFrame(animationId);
        currentIdx = idx;
        const e = events[idx];
        if (!e) return;

        const baseR = baseRadius(e.altitude_km);
        const isPlane = e.kind === "out_of_plane";
        const dir = (e.delta_a_km ?? 0) >= 0 ? 1 : -1;
        const gap = isPlane ? 0 : gapForDeltaA(e.delta_a_km);
        const tilt = isPlane ? tiltForDeltaInc(e.delta_inc_deg) : 0;
        const beforeR = isPlane ? baseR : baseR - dir * gap * 0.5;
        const afterR  = isPlane ? baseR : baseR + dir * gap * 0.5;
        const accent = COLOR[e.classification] || "#1B3A5C";
        const theta = angleFor(e.norad_id);

        orbitBefore.setAttribute("rx", beforeR);
        orbitBefore.setAttribute("ry", beforeR);
        orbitBefore.setAttribute("opacity", "0.6");
        orbitAfter.setAttribute("rx", beforeR);
        orbitAfter.setAttribute("ry", beforeR);
        orbitAfter.setAttribute("stroke", accent);
        orbitAfter.setAttribute("opacity", "0");
        orbitAfter.removeAttribute("transform");
        burnMarker.setAttribute("opacity", "0");
        deltaLabel.textContent = "";

        const sx0 = CX + beforeR * Math.cos(theta);
        const sy0 = CY + beforeR * Math.sin(theta);
        setSatPos(sx0, sy0);
        satellite.querySelector("circle:nth-child(1)").setAttribute("fill", accent);
        satellite.querySelector("circle:nth-child(2)").setAttribute("stroke", accent);

        // HUD readout (top-left of stage)
        hudNorad.textContent = e.norad_id;
        const incTxt = e.inc_deg_at_event != null
          ? `${e.inc_deg_at_event.toFixed(2)}°`
          : "—";
        hudCoords.innerHTML = `ALT <tspan fill="var(--color-ink)">${Math.round(e.altitude_km).toLocaleString()} km</tspan>  ·  INC <tspan fill="var(--color-ink)">${incTxt}</tspan>`;

        // Right-side readout
        const d = new Date(e.detected_epoch);
        const dateLong = d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
        const timeShort = d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" });
        rTag.textContent = PLAIN_TAG[e.classification] || e.classification;
        rTag.style.color = accent;
        rTag.style.borderColor = accent;
        rName.textContent = e.object_name || `NORAD ${e.norad_id}`;
        rSentence.textContent = buildSentence(e);
        rNorad.textContent = e.norad_id;
        rWhen.textContent = `${dateLong} · ${timeShort} UTC`;
        rWhere.textContent = plainAltitude(e.altitude_km);
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          rChange.textContent = (e.delta_a_km >= 0 ? "+" : "") + e.delta_a_km.toFixed(2) + " km";
        } else if (e.delta_inc_deg != null) {
          rChange.textContent = (e.delta_inc_deg >= 0 ? "+" : "") + e.delta_inc_deg.toFixed(4) + "°";
        } else {
          rChange.textContent = "—";
        }
        rSize.textContent = plainSize(e.dv_mps);
        rConf.textContent = e.confidence === "HIGH" ? "Double-confirmed" : "Single signal";
        rConf.className = "mono " + (e.confidence === "HIGH" ? "is-high" : "is-low");
        rDv.textContent = e.dv_mps.toFixed(2) + " m/s";
        rOpen.href = `/sat/${e.norad_id}`;
        const sameSat = events.filter((x) => x.norad_id === e.norad_id).length;
        rRelated.textContent = sameSat > 1
          ? `${sameSat}× this month`
          : "Only event from this satellite";
        rChartWrap.innerHTML = renderSparkline(e);

        // Counters
        detailCounter.textContent = `${idx + 1} / ${events.length}`;
        logCounter.textContent = `${idx + 1} / ${events.length}`;

        // Log selection
        logRows.forEach((r, ri) => {
          const selected = ri === idx;
          r.classList.toggle("is-current", selected);
          r.setAttribute("aria-selected", selected ? "true" : "false");
        });
        const currentRow = logRows[idx];
        if (currentRow) currentRow.scrollIntoView({ block: "nearest", behavior: "smooth" });

        // Animate BEFORE→AFTER
        const PRE_DELAY = 220;
        const DURATION = 1400;
        const BURN_FLASH = 220;
        const start = performance.now() + PRE_DELAY;
        let armed = false;

        function tick(now) {
          const t = Math.max(0, Math.min(1, (now - start) / DURATION));
          const k = easeInOutCubic(t);

          orbitBefore.setAttribute("opacity", String(0.6 - 0.45 * k));
          if (isPlane) {
            orbitAfter.setAttribute("rx", beforeR);
            orbitAfter.setAttribute("ry", beforeR * (1 - tilt * k));
            orbitAfter.setAttribute("transform", `rotate(${k * (e.delta_inc_deg >= 0 ? 16 : -16)} ${CX} ${CY})`);
          } else {
            const curR = beforeR + (afterR - beforeR) * k;
            orbitAfter.setAttribute("rx", curR);
            orbitAfter.setAttribute("ry", curR);
          }
          orbitAfter.setAttribute("opacity", String(Math.min(1, k * 1.6)));

          if (isPlane) {
            const newTheta = theta + (e.delta_inc_deg >= 0 ? 1 : -1) * 0.06 * k;
            const sx = CX + beforeR * Math.cos(newTheta);
            const sy = CY + beforeR * (1 - tilt * k) * Math.sin(newTheta);
            setSatPos(sx, sy);
            if (k > 0.45 && !armed) {
              const sxF = CX + beforeR * Math.cos(theta);
              const syF = CY + beforeR * Math.sin(theta);
              placeBurnArrow(e, sxF, syF, theta);
              burnMarker.setAttribute("opacity", "1");
              setTimeout(() => burnMarker.setAttribute("opacity", "0"), BURN_FLASH * 1.6);
              placeDeltaLabel(e, CX + afterR * Math.cos(theta), CY + afterR * Math.sin(theta), theta);
              armed = true;
            }
          } else {
            const curR = beforeR + (afterR - beforeR) * k;
            const sx = CX + curR * Math.cos(theta);
            const sy = CY + curR * Math.sin(theta);
            setSatPos(sx, sy);
            if (k > 0.35 && k < 0.65 && !armed) {
              placeBurnArrow(e, sx, sy, theta);
              burnMarker.setAttribute("opacity", "1");
              setTimeout(() => burnMarker.setAttribute("opacity", "0"), BURN_FLASH);
              placeDeltaLabel(e, CX + afterR * Math.cos(theta), CY + afterR * Math.sin(theta), theta);
              armed = true;
            }
          }

          if (t < 1) animationId = requestAnimationFrame(tick);
          else animationId = null;
        }
        animationId = requestAnimationFrame(function pre(now) {
          if (now >= start) tick(now);
          else animationId = requestAnimationFrame(pre);
        });
      }

      // ── Navigation ─────────────────────────────────────────
      function next() {
        let i = (currentIdx + 1) % events.length;
        while (!eventPassesFilter(events[i]) && i !== currentIdx) {
          i = (i + 1) % events.length;
        }
        renderAndAnimate(i);
      }
      function prev() {
        let i = (currentIdx - 1 + events.length) % events.length;
        while (!eventPassesFilter(events[i]) && i !== currentIdx) {
          i = (i - 1 + events.length) % events.length;
        }
        renderAndAnimate(i);
      }
      function replay() { renderAndAnimate(currentIdx); }

      function eventPassesFilter(e) {
        if (!activeClasses.has(e.classification)) return false;
        if (highOnly && e.confidence !== "HIGH") return false;
        return true;
      }
      function applyFilters() {
        logRows.forEach((row, i) => {
          row.hidden = !eventPassesFilter(events[i]);
        });
      }

      // ── Wire events ────────────────────────────────────────
      prevBtn.addEventListener("click", () => { stopAuto(); prev(); });
      nextBtn.addEventListener("click", () => { stopAuto(); next(); });
      replayBtn.addEventListener("click", () => { stopAuto(); replay(); });
      logRows.forEach((row) => {
        row.addEventListener("click", () => { stopAuto(); renderAndAnimate(+row.dataset.idx); });
      });
      document.addEventListener("keydown", (e) => {
        if (e.target instanceof HTMLInputElement) return;
        if (e.key === "ArrowLeft")  { stopAuto(); prev();  e.preventDefault(); }
        if (e.key === "ArrowRight") { stopAuto(); next();  e.preventDefault(); }
        if (e.key === " ")          { stopAuto(); replay(); e.preventDefault(); }
      });

      document.querySelectorAll("[data-fc]").forEach((chip) => {
        chip.addEventListener("click", () => {
          const k = chip.dataset.fc;
          if (activeClasses.has(k)) { activeClasses.delete(k); chip.classList.remove("is-on"); }
          else { activeClasses.add(k); chip.classList.add("is-on"); }
          applyFilters();
        });
      });
      const highChip = document.querySelector('[data-fc-conf="HIGH"]');
      if (highChip) {
        highChip.addEventListener("click", () => {
          highOnly = !highOnly;
          highChip.classList.toggle("is-on", highOnly);
          highChip.setAttribute("aria-pressed", String(highOnly));
          applyFilters();
        });
      }

      // ── Auto-play ──────────────────────────────────────────
      function startAuto() {
        playBtn.setAttribute("aria-pressed", "true");
        playIcon.textContent = "❚❚";
        autoTimer = setInterval(next, 4500);
      }
      function stopAuto() {
        if (!autoTimer) return;
        clearInterval(autoTimer);
        autoTimer = null;
        playBtn.setAttribute("aria-pressed", "false");
        playIcon.textContent = "▶";
      }
      playBtn.addEventListener("click", () => {
        if (autoTimer) stopAuto(); else startAuto();
      });

      // First render
      renderAndAnimate(0);
    })();
  </script>
</BaseLayout>

