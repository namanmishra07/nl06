---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import fs from "node:fs";
import path from "node:path";

interface FeedEvent {
  norad_id: number;
  object_name: string;
  country: string | null;
  constellation: string | null;
  object_type: string | null;
  detected_epoch: string;
  kind: "in_plane" | "out_of_plane";
  classification: string;
  delta_a_km: number | null;
  delta_inc_deg: number | null;
  dv_mps: number;
  snr: number;
  confidence: "HIGH" | "LOW";
  altitude_km: number;
  a_km_at_event: number | null;
  inc_deg_at_event: number | null;
  sparkline: { epoch_iso: string[]; a_km: number[]; altitude_km: number[] };
}
interface Feed { generated_at: string; window_days: number; event_count: number; events: FeedEvent[]; }
interface Summary {
  generated_at: string; window_days: number; payloads_tracked: number;
  events_in_window: number;
  by_classification: Record<string, number>; by_kind: Record<string, number>;
  by_confidence: Record<string, number>; by_constellation: Record<string, number>;
}

function readJson<T>(rel: string, fallback: T): T {
  try {
    const p = path.resolve("./public", rel);
    if (!fs.existsSync(p)) return fallback;
    return JSON.parse(fs.readFileSync(p, "utf-8")) as T;
  } catch { return fallback; }
}

const feed: Feed = readJson("data/feed.json", {
  generated_at: new Date().toISOString(), window_days: 30, event_count: 0, events: [],
});
const summary: Summary = readJson("data/summary.json", {
  generated_at: new Date().toISOString(), window_days: 30, payloads_tracked: 0,
  events_in_window: 0, by_classification: {}, by_kind: {}, by_confidence: {}, by_constellation: {},
});

const usable = feed.events.filter((e) =>
  e.altitude_km > 100 && e.altitude_km < 50000 && e.dv_mps > 0.005
);

function isSK(c: string) { return c.startsWith("stationkeeping"); }
function score(e: FeedEvent): number {
  const conf    = e.confidence === "HIGH" ? 1.6 : 0.9;
  const routine = isSK(e.classification) ? 0.2 : 1.0;
  const swarm   = e.constellation ? 0.3 : 1.0;
  return e.dv_mps * conf * routine * swarm;
}
const ordered = [...usable].sort((a, b) => score(b) - score(a));
const totalEvents = ordered.length;
---
<BaseLayout
  title="SSA — Watch satellites move"
  description="A guided tour through every satellite maneuver detected from public orbital data this month."
  pathname="/"
  itemNumber="№ 001"
>
  <article class="theatre-page">
    <Container size="wide" class="theatre-page__inner">

      <header class="theatre-head">
        <p class="theatre-head__kicker">A guided tour</p>
        <h1 class="theatre-head__title">
          <span class="theatre-head__title-pre">Watch satellites</span>
          <span class="theatre-head__title-main">move.</span>
        </h1>
        <p class="theatre-head__lede">
          We watch their published orbits and surface the moments those orbits
          break &mdash; thruster firings, detected from the ground. Use the arrows
          to step through the most notable {totalEvents} this month, or hit Play.
          <a class="theatre-head__how" href="/method">How that works ↗</a>
        </p>
      </header>

      {ordered.length === 0 ? (
        <p class="theatre-page__empty">
          No usable maneuvers in the last 30 days. The pipeline may be
          mid-bootstrap; check back tomorrow.
        </p>
      ) : (
        <section class="theatre" aria-label="Maneuver Theatre">

          <!-- ─── The Stage ─── -->
          <div class="stage">
            <button class="stage__nav stage__nav--prev" id="prev-btn" type="button"
                    aria-label="Previous maneuver (arrow left)">
              <span aria-hidden="true">←</span>
            </button>

            <div class="stage__center">
              <svg
                class="stage__svg"
                viewBox="0 0 800 540"
                width="800" height="540"
                role="img"
                aria-label="Animated diagram of one satellite maneuver"
              >
                <defs>
                  <radialGradient id="t-earth" cx="38%" cy="38%" r="65%">
                    <stop offset="0%"  stop-color="#6f93b9" />
                    <stop offset="58%" stop-color="#3a5a7e" />
                    <stop offset="100%" stop-color="#1f3349" />
                  </radialGradient>
                  <clipPath id="t-earth-clip">
                    <circle cx="400" cy="270" r="30" />
                  </clipPath>
                  <marker id="t-arrow" markerWidth="10" markerHeight="10" refX="7" refY="5"
                          orient="auto">
                    <path d="M0,1 L8,5 L0,9 L1.5,5 Z" fill="#E07A30" />
                  </marker>
                  <marker id="t-arrow-blue" markerWidth="10" markerHeight="10" refX="7" refY="5"
                          orient="auto">
                    <path d="M0,1 L8,5 L0,9 L1.5,5 Z" fill="#2A5B9C" />
                  </marker>
                  <marker id="t-arrow-green" markerWidth="10" markerHeight="10" refX="7" refY="5"
                          orient="auto">
                    <path d="M0,1 L8,5 L0,9 L1.5,5 Z" fill="#36906A" />
                  </marker>
                </defs>

                <!-- not-to-scale watermark -->
                <text x="780" y="525" text-anchor="end"
                      font-family="var(--font-sans)" font-size="9"
                      fill="var(--color-ink-faint)"
                      style="letter-spacing: 0.08em; text-transform: uppercase;">
                  diagram · changes exaggerated for clarity
                </text>

                <!-- Background rings — the four orbital regimes, very faint -->
                {[140, 200, 260, 305].map((r) => (
                  <circle cx="400" cy="270" r={r}
                          fill="none" stroke="var(--color-rule)"
                          stroke-width="0.5"
                          stroke-dasharray="1 8" />
                ))}

                <!-- Old + new orbit rings — animated by JS -->
                <g id="stage-orbits">
                  <ellipse id="orbit-before" cx="400" cy="270" rx="180" ry="180"
                           fill="none" stroke="var(--color-ink-muted)"
                           stroke-width="1" stroke-dasharray="4 4" opacity="0.6" />
                  <ellipse id="orbit-after"  cx="400" cy="270" rx="200" ry="200"
                           fill="none" stroke="#E07A30" stroke-width="2.5" />
                </g>

                <!-- Earth -->
                <g class="t-earth">
                  <circle cx="400" cy="270" r="30" fill="url(#t-earth)" />
                  <g clip-path="url(#t-earth-clip)" fill="#1f3349" fill-opacity="0.55">
                    <path d="M 401,260 C 408,260 411,266 409,272 C 407,277 402,279 399,278 C 396,276 396,271 398,266 C 399,263 400,260 401,260 Z" />
                    <path d="M 394,257 C 399,254 405,254 412,257 C 408,260 402,261 397,260 C 394,260 392,259 394,257 Z" />
                    <path d="M 386,262 C 389,259 392,263 391,269 C 390,274 387,278 385,275 C 383,272 384,266 386,262 Z" />
                    <ellipse cx="411" cy="278" rx="4" ry="2" />
                  </g>
                  <circle cx="416" cy="270" r="30" fill="#000" fill-opacity="0.16"
                          clip-path="url(#t-earth-clip)" />
                </g>

                <!-- Burn marker — small arrow at the satellite showing direction -->
                <g id="burn-marker" opacity="0">
                  <line id="burn-line" x1="0" y1="0" x2="0" y2="0"
                        stroke="#E07A30" stroke-width="2.5"
                        marker-end="url(#t-arrow)" />
                </g>

                <!-- Satellite icon — small triangle on the orbit -->
                <g id="satellite">
                  <circle cx="0" cy="0" r="4.5" fill="var(--color-ink)" />
                  <circle cx="0" cy="0" r="9" fill="none"
                          stroke="var(--color-ink)" stroke-width="0.8"
                          stroke-dasharray="2 3" opacity="0.5" />
                </g>

                <!-- Δv label, positioned by JS -->
                <text id="stage-delta-label" x="0" y="0"
                      font-family="var(--font-sans)" font-size="13" font-weight="800"
                      fill="var(--color-ink)" text-anchor="middle"
                      style="letter-spacing: 0.02em;">
                </text>
              </svg>
            </div>

            <button class="stage__nav stage__nav--next" id="next-btn" type="button"
                    aria-label="Next maneuver (arrow right)">
              <span aria-hidden="true">→</span>
            </button>
          </div>

          <!-- ─── Caption block ─── -->
          <div class="caption" aria-live="polite">
            <div class="caption__topline">
              <span class="caption__tag" id="caption-tag"></span>
              <span class="caption__when" id="caption-when"></span>
            </div>
            <h2 class="caption__sentence" id="caption-sentence"></h2>
            <p class="caption__sub" id="caption-sub"></p>
            <div class="caption__controls">
              <button class="ctrl ctrl--play" id="play-btn" type="button" aria-pressed="false">
                <span class="ctrl__icon" aria-hidden="true">▶</span>
                <span class="ctrl__lbl ctrl__lbl--play">Auto-play</span>
                <span class="ctrl__lbl ctrl__lbl--pause" hidden>Pause</span>
              </button>
              <button class="ctrl ctrl--replay" id="replay-btn" type="button">
                <span class="ctrl__icon" aria-hidden="true">↻</span>
                Replay
              </button>
              <a class="ctrl ctrl--detail" id="detail-link" href="#">
                See this satellite's orbit history →
              </a>
              <span class="ctrl__counter" id="counter">1 / {totalEvents}</span>
            </div>
          </div>

          <!-- ─── Mini strip — every event as a small dot. Click to jump. ─── -->
          <div class="strip-wrap">
            <p class="strip__label">All {totalEvents} maneuvers, sorted by interest. Click to jump:</p>
            <div class="strip" id="strip" role="listbox" aria-label="All events">
              {ordered.map((e, i) => (
                <button class={`strip__dot strip__dot--${e.classification}`}
                        type="button"
                        data-idx={i}
                        aria-label={`${e.object_name ?? `NORAD ${e.norad_id}`}, ${e.classification.replace(/_/g, " ")}, ${new Date(e.detected_epoch).toLocaleDateString("en-GB", { day: "numeric", month: "short" })}`}
                        title={`${e.object_name ?? `NORAD ${e.norad_id}`} · ${e.classification.replace(/_/g, " ")}`}>
                </button>
              ))}
            </div>
            <ul class="legend" aria-label="Classification legend">
              <li><span class="legend__sw" style="background:#E07A30"></span>raise</li>
              <li><span class="legend__sw" style="background:#2A5B9C"></span>lower</li>
              <li><span class="legend__sw" style="background:#36906A"></span>plane shift</li>
              <li><span class="legend__sw" style="background:#B8B2A0"></span>routine SK</li>
              <li><span class="legend__sw" style="background:#C73E2E"></span>deorbit</li>
            </ul>
          </div>
        </section>
      )}

      <footer class="theatre-page__foot">
        <p class="theatre-page__nb">
          The diagram is schematic &mdash; a 1 km orbit change is invisible at scale,
          so we exaggerate to read. The numbers on the right are real.
          Satellite names will fill in once the public catalog re-fetches.
        </p>
      </footer>
    </Container>
  </article>

  <script type="application/json" id="events-data" set:html={JSON.stringify(ordered)} />

  <script is:inline>
    (function () {
      const dataNode = document.getElementById("events-data");
      if (!dataNode) return;
      const events = JSON.parse(dataNode.textContent || "[]");
      if (events.length === 0) return;

      // ── DOM refs ────────────────────────────────────────────
      const prevBtn  = document.getElementById("prev-btn");
      const nextBtn  = document.getElementById("next-btn");
      const replayBtn = document.getElementById("replay-btn");
      const playBtn  = document.getElementById("play-btn");
      const detailLink = document.getElementById("detail-link");
      const counter  = document.getElementById("counter");
      const strip    = document.getElementById("strip");
      const stripDots = Array.from(strip.querySelectorAll(".strip__dot"));

      const orbitBefore = document.getElementById("orbit-before");
      const orbitAfter  = document.getElementById("orbit-after");
      const satellite   = document.getElementById("satellite");
      const burnMarker  = document.getElementById("burn-marker");
      const burnLine    = document.getElementById("burn-line");
      const deltaLabel  = document.getElementById("stage-delta-label");

      const tag = document.getElementById("caption-tag");
      const when = document.getElementById("caption-when");
      const sentence = document.getElementById("caption-sentence");
      const subline = document.getElementById("caption-sub");

      // ── Layout constants — match SVG viewBox ───────────────
      const CX = 400, CY = 270;

      // ── Palette ─────────────────────────────────────────────
      const COLOR = {
        raise:             "#E07A30",
        lower:             "#2A5B9C",
        plane_change:      "#36906A",
        stationkeeping_ew: "#B8B2A0",
        stationkeeping_ns: "#C9C1A9",
        deorbit:           "#C73E2E",
      };
      const ARROW_MARKER = {
        raise:             "url(#t-arrow)",
        lower:             "url(#t-arrow-blue)",
        plane_change:      "url(#t-arrow-green)",
        stationkeeping_ew: "url(#t-arrow)",
        stationkeeping_ns: "url(#t-arrow)",
        deorbit:           "url(#t-arrow)",
      };
      const PLAIN_TAG = {
        raise: "Orbit raised", lower: "Orbit lowered",
        deorbit: "Rapid altitude loss", plane_change: "Plane shifted",
        stationkeeping_ew: "Routine east-west adjustment",
        stationkeeping_ns: "Routine north-south adjustment",
      };
      const TYPE_VERB = {
        raise: "raised its orbit", lower: "lowered its orbit",
        deorbit: "dropped altitude fast",
        plane_change: "shifted its orbital plane",
        stationkeeping_ew: "nudged east-or-west",
        stationkeeping_ns: "nudged north-or-south",
      };

      // ── Plain-language helpers ─────────────────────────────
      function plainAltitude(a) {
        if (a < 1000) return `low Earth orbit (${Math.round(a)} km up)`;
        if (a < 8000) return `medium-low orbit (${(a / 1000).toFixed(1)}k km up)`;
        if (a < 25000) return `medium Earth orbit (${(a / 1000).toFixed(0)}k km up)`;
        if (a > 33000 && a < 38000) return `geostationary orbit (about 36k km up)`;
        return `high orbit (${(a / 1000).toFixed(0)}k km up)`;
      }
      function plainDistance(km) {
        const abs = Math.abs(km);
        if (abs < 0.5) return `about ${(abs * 1000).toFixed(0)} metres`;
        if (abs < 2)   return `about ${abs.toFixed(1)} km`;
        return `about ${Math.round(abs)} km`;
      }
      function plainAngle(d) {
        const abs = Math.abs(d);
        if (abs < 0.01) return `a hundredth of a degree`;
        if (abs < 0.1)  return `${abs.toFixed(3)}°`;
        return `${abs.toFixed(2)}°`;
      }
      function plainSize(dv) {
        if (dv < 0.05) return "a tiny nudge";
        if (dv < 0.5)  return "a small move";
        if (dv < 5)    return "a noticeable burn";
        if (dv < 50)   return "a significant maneuver";
        return "a major maneuver";
      }
      function buildSentence(e) {
        const name = e.object_name || `Satellite NORAD ${e.norad_id}`;
        const verb = TYPE_VERB[e.classification] || "moved";
        const alt = plainAltitude(e.altitude_km);
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          return `${name} ${verb} by ${plainDistance(e.delta_a_km)}, in ${alt}.`;
        }
        if (e.kind === "out_of_plane" && e.delta_inc_deg != null) {
          return `${name} ${verb} by ${plainAngle(e.delta_inc_deg)}, in ${alt}.`;
        }
        return `${name} ${verb} in ${alt}.`;
      }
      function buildSubline(e) {
        const d = new Date(e.detected_epoch);
        const date = d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
        const time = d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC" });
        const conf = e.confidence === "HIGH" ? "Double-confirmed" : "Single signal";
        const size = plainSize(e.dv_mps);
        return `${date}, ${time} UTC · ${size} · ${conf}`;
      }

      // ── Display geometry ───────────────────────────────────
      // Map altitude regime → base orbit radius on stage.
      function baseRadiusFor(altKm) {
        if (altKm < 2000)  return 140;  // LEO
        if (altKm < 7000)  return 175;
        if (altKm < 25000) return 215;
        return 260;                      // GEO
      }
      // Exaggerated radial gap between BEFORE and AFTER.
      // Bigger Δa → bigger gap, but log-bounded so they're all readable.
      function gapForDeltaA(deltaKm) {
        const abs = Math.abs(deltaKm || 0);
        return Math.max(10, Math.min(60, 8 + Math.log10(abs + 1) * 26));
      }
      // For plane change, tilt the AFTER ring (squish y-radius).
      function tiltForDeltaInc(deltaDeg) {
        const abs = Math.abs(deltaDeg || 0);
        return Math.max(0.04, Math.min(0.35, abs * 6));
      }
      // Pseudo-stable orbital angle for the satellite glyph.
      function angleFor(noradId) {
        let x = noradId | 0;
        x ^= x << 13; x ^= x >>> 17; x ^= x << 5;
        return (((x >>> 0) % 100000) / 100000) * Math.PI * 2;
      }

      // ── State + render ─────────────────────────────────────
      let currentIdx = 0;
      let animationId = null;
      let autoTimer = null;

      function setSatellitePos(x, y) {
        satellite.setAttribute("transform", `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
      }

      function placeBurnArrow(e, sx, sy, theta) {
        // Direction matches classification.
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          const dir = e.delta_a_km >= 0 ? 1 : -1;
          const len = 22 + Math.log10(Math.abs(e.delta_a_km) + 1) * 14;
          const tx = sx + dir * len * Math.cos(theta);
          const ty = sy + dir * len * Math.sin(theta);
          burnLine.setAttribute("x1", sx); burnLine.setAttribute("y1", sy);
          burnLine.setAttribute("x2", tx); burnLine.setAttribute("y2", ty);
          burnLine.setAttribute("stroke", COLOR[e.classification]);
          burnLine.setAttribute("marker-end", ARROW_MARKER[e.classification]);
        } else if (e.kind === "out_of_plane" && e.delta_inc_deg != null) {
          const dir = e.delta_inc_deg >= 0 ? 1 : -1;
          const len = 26 + Math.log10(Math.abs(e.delta_inc_deg) + 1) * 30;
          const tx = sx - dir * len * Math.sin(theta);
          const ty = sy + dir * len * Math.cos(theta);
          burnLine.setAttribute("x1", sx); burnLine.setAttribute("y1", sy);
          burnLine.setAttribute("x2", tx); burnLine.setAttribute("y2", ty);
          burnLine.setAttribute("stroke", COLOR[e.classification]);
          burnLine.setAttribute("marker-end", ARROW_MARKER[e.classification]);
        } else {
          burnLine.setAttribute("x1", 0); burnLine.setAttribute("x2", 0);
          burnLine.setAttribute("y1", 0); burnLine.setAttribute("y2", 0);
        }
      }

      function placeDeltaLabel(e, sx, sy, theta) {
        let txt = "";
        if (e.kind === "in_plane" && e.delta_a_km != null) {
          txt = (e.delta_a_km >= 0 ? "+" : "") + e.delta_a_km.toFixed(2) + " km";
        } else if (e.delta_inc_deg != null) {
          txt = (e.delta_inc_deg >= 0 ? "+" : "") + Math.abs(e.delta_inc_deg).toFixed(3) + "°";
        }
        deltaLabel.textContent = txt;
        const lx = sx + 36 * Math.cos(theta);
        const ly = sy + 36 * Math.sin(theta) + 5;
        deltaLabel.setAttribute("x", lx.toFixed(1));
        deltaLabel.setAttribute("y", ly.toFixed(1));
        deltaLabel.setAttribute("fill", COLOR[e.classification] || "var(--color-ink)");
      }

      function easeInOutCubic(t) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function renderAndAnimate(idx) {
        if (animationId) cancelAnimationFrame(animationId);
        currentIdx = idx;
        const e = events[idx];
        if (!e) return;
        const baseR = baseRadiusFor(e.altitude_km);
        const isPlane = e.kind === "out_of_plane";
        const dir = (e.delta_a_km ?? 0) >= 0 ? 1 : -1;
        const gap = isPlane ? 0 : gapForDeltaA(e.delta_a_km);
        const tilt = isPlane ? tiltForDeltaInc(e.delta_inc_deg) : 0;
        const beforeR = isPlane ? baseR : baseR - dir * gap * 0.5;
        const afterR  = isPlane ? baseR : baseR + dir * gap * 0.5;

        const accent = COLOR[e.classification] || "#1B3A5C";
        const theta = angleFor(e.norad_id);

        // Reset to BEFORE state instantly.
        orbitBefore.setAttribute("rx", beforeR);
        orbitBefore.setAttribute("ry", beforeR);
        orbitBefore.setAttribute("stroke", "var(--color-ink-muted)");
        orbitAfter.setAttribute("rx", beforeR);
        orbitAfter.setAttribute("ry", beforeR);
        orbitAfter.setAttribute("stroke", accent);
        orbitAfter.setAttribute("opacity", "0");
        burnMarker.setAttribute("opacity", "0");
        deltaLabel.textContent = "";

        const sx0 = CX + beforeR * Math.cos(theta);
        const sy0 = CY + beforeR * Math.sin(theta);
        setSatellitePos(sx0, sy0);
        satellite.querySelector("circle:nth-child(1)").setAttribute("fill", accent);
        satellite.querySelector("circle:nth-child(2)").setAttribute("stroke", accent);

        // Update caption.
        tag.textContent = PLAIN_TAG[e.classification] || e.classification;
        tag.style.color = accent;
        tag.style.borderColor = accent;
        when.textContent = new Date(e.detected_epoch).toLocaleDateString(
          "en-GB", { day: "numeric", month: "long" }
        );
        sentence.textContent = buildSentence(e);
        subline.textContent = buildSubline(e);
        counter.textContent = `${idx + 1} / ${events.length}`;
        detailLink.href = `/sat/${e.norad_id}`;

        // Update strip selection.
        stripDots.forEach((d, di) => {
          d.classList.toggle("is-current", di === idx);
        });
        const cur = stripDots[idx];
        if (cur) cur.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });

        // Schedule the animation: a brief delay, then morph BEFORE→AFTER.
        const PRE_DELAY = 280;
        const DURATION  = 1500;
        const BURN_FLASH = 220;
        const start = performance.now() + PRE_DELAY;

        function tick(now) {
          const t = Math.max(0, Math.min(1, (now - start) / DURATION));
          const k = easeInOutCubic(t);

          // BEFORE ring fades during transition.
          orbitBefore.setAttribute("opacity", String(0.6 - 0.45 * k));
          // AFTER ring grows / tilts.
          if (isPlane) {
            const ry = beforeR * (1 - tilt * k);
            orbitAfter.setAttribute("rx", beforeR);
            orbitAfter.setAttribute("ry", ry);
            orbitAfter.setAttribute("transform", `rotate(${k * (e.delta_inc_deg >= 0 ? 18 : -18)} ${CX} ${CY})`);
          } else {
            const curR = beforeR + (afterR - beforeR) * k;
            orbitAfter.setAttribute("rx", curR);
            orbitAfter.setAttribute("ry", curR);
            orbitAfter.removeAttribute("transform");
          }
          orbitAfter.setAttribute("opacity", String(Math.min(1, k * 1.6)));

          // Satellite follows along the radial transition.
          if (isPlane) {
            // For plane change, satellite shifts along the ring slightly.
            const newTheta = theta + (e.delta_inc_deg >= 0 ? 1 : -1) * 0.05 * k;
            const sx = CX + beforeR * Math.cos(newTheta);
            const sy = CY + beforeR * (1 - tilt * k) * Math.sin(newTheta);
            setSatellitePos(sx, sy);
            if (k > 0.5 && burnMarker.getAttribute("opacity") === "0") {
              placeBurnArrow(e, CX + beforeR * Math.cos(theta), CY + beforeR * Math.sin(theta), theta);
              burnMarker.setAttribute("opacity", "1");
              setTimeout(() => burnMarker.setAttribute("opacity", "0"), BURN_FLASH * 1.4);
              placeDeltaLabel(e, CX + afterR * Math.cos(theta), CY + afterR * Math.sin(theta), theta);
            }
          } else {
            const curR = beforeR + (afterR - beforeR) * k;
            const sx = CX + curR * Math.cos(theta);
            const sy = CY + curR * Math.sin(theta);
            setSatellitePos(sx, sy);
            // Flash burn arrow around mid-transition.
            if (k > 0.35 && k < 0.6 && burnMarker.getAttribute("opacity") === "0") {
              placeBurnArrow(e, sx, sy, theta);
              burnMarker.setAttribute("opacity", "1");
              setTimeout(() => burnMarker.setAttribute("opacity", "0"), BURN_FLASH);
            }
            if (k > 0.55 && !deltaLabel.textContent) {
              placeDeltaLabel(e, CX + afterR * Math.cos(theta), CY + afterR * Math.sin(theta), theta);
            }
          }

          if (t < 1) {
            animationId = requestAnimationFrame(tick);
          } else {
            animationId = null;
            // Final placement of label.
            placeDeltaLabel(e, CX + afterR * Math.cos(theta), CY + afterR * Math.sin(theta), theta);
          }
        }

        animationId = requestAnimationFrame(function pre(now) {
          if (now >= start) tick(now);
          else animationId = requestAnimationFrame(pre);
        });
      }

      // ── Navigation ─────────────────────────────────────────
      function next() { renderAndAnimate((currentIdx + 1) % events.length); }
      function prev() { renderAndAnimate((currentIdx - 1 + events.length) % events.length); }
      function replay() { renderAndAnimate(currentIdx); }

      prevBtn.addEventListener("click", () => { stopAuto(); prev(); });
      nextBtn.addEventListener("click", () => { stopAuto(); next(); });
      replayBtn.addEventListener("click", () => { stopAuto(); replay(); });

      document.addEventListener("keydown", (e) => {
        if (e.target instanceof HTMLInputElement) return;
        if (e.key === "ArrowLeft")  { stopAuto(); prev(); }
        if (e.key === "ArrowRight") { stopAuto(); next(); }
        if (e.key === " ") { stopAuto(); replay(); e.preventDefault(); }
      });

      stripDots.forEach((d) => {
        d.addEventListener("click", () => {
          stopAuto();
          renderAndAnimate(+d.dataset.idx);
        });
      });

      // ── Auto-play ──────────────────────────────────────────
      function startAuto() {
        playBtn.setAttribute("aria-pressed", "true");
        playBtn.querySelector(".ctrl__lbl--play").hidden = true;
        playBtn.querySelector(".ctrl__lbl--pause").hidden = false;
        playBtn.querySelector(".ctrl__icon").textContent = "❚❚";
        autoTimer = setInterval(next, 5000);
      }
      function stopAuto() {
        if (!autoTimer) return;
        clearInterval(autoTimer);
        autoTimer = null;
        playBtn.setAttribute("aria-pressed", "false");
        playBtn.querySelector(".ctrl__lbl--play").hidden = false;
        playBtn.querySelector(".ctrl__lbl--pause").hidden = true;
        playBtn.querySelector(".ctrl__icon").textContent = "▶";
      }
      playBtn.addEventListener("click", () => {
        if (autoTimer) stopAuto(); else startAuto();
      });

      // ── First render ───────────────────────────────────────
      renderAndAnimate(0);
    })();
  </script>
</BaseLayout>

