---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import SearchBar  from "~/components/SearchBar.astro";
import LotModal   from "~/components/LotModal.astro";

import lotsData from "../content/lots.json";
import metaData from "../content/meta.json";

type Annexure = { filename: string; url: string; has_text: boolean };
type Lot = {
  id: string; source: string; source_url: string;
  mstc_listing_url: string | null; auction_id: string | null;
  sublot_count: number; title: string; score_title: string | null;
  seller: string | null; seller_category: string; location: string | null;
  start_price_inr: number | null; emd_inr: number | null;
  close_at_utc: string | null; status: string; score: number | null;
  category: string | null; confidence: number | null; note: string | null;
  note_is_editor: boolean; boosted: boolean; annexures: Annexure[];
  first_seen_utc?: string | null; photos?: string[];
  group_total?: number; group_more?: number;
};

const lots: Lot[] = lotsData as Lot[];
const meta:  any  = metaData;

const synced     = new Date(meta.synced_at_utc);
const syncedISO  = synced.toISOString().slice(0, 16).replace("T", " ") + " UTC";
const counts     = meta.counts as Record<string, number>;
const filter     = meta.publish_filter as {
  category_thresholds: Record<string, number>;
  prestige_categories: string[];
  prestige_seller_floor: number;
};
const lastRunErr = (meta.last_run as any | null)?.error as string | null;
const lowestThreshold = Math.min(
  ...Object.values(filter.category_thresholds), filter.prestige_seller_floor);

const PRESTIGE_SELLERS = new Set(filter.prestige_categories);
const CLOSING_SOON_DAYS = 7;
const closingSoonCutoffMs = synced.getTime() + CLOSING_SOON_DAYS * 86400 * 1000;
const isPrestigeSeller = (l: Lot) => PRESTIGE_SELLERS.has(l.seller_category);
const isClosingSoon = (l: Lot) =>
  !!l.close_at_utc && Date.parse(l.close_at_utc) <= closingSoonCutoffMs;

const NEW_BADGE_HOURS = 48;
const isNew = (l: Lot) =>
  !!l.first_seen_utc &&
  synced.getTime() - Date.parse(l.first_seen_utc) <= NEW_BADGE_HOURS * 3600 * 1000;

const CATEGORIES = ["curio", "arbitrage", "prestige-seller", "niche-instrument"] as const;
const CATEGORY_LABELS: Record<typeof CATEGORIES[number], string> = {
  "curio": "Curio", "arbitrage": "Arbitrage",
  "prestige-seller": "Prestige", "niche-instrument": "Niche",
};
const SCORE_STEPS = [4, 5, 6, 7, 8, 9];

const SOURCES = [...new Set(lots.map(l => l.source).filter(Boolean))].sort() as string[];
const SOURCE_LABELS: Record<string, string> = {
  mstc: "MSTC", baanknet: "BAANKNET", ireps: "IREPS", gem: "GeM",
};

const facetCounts = {
  total: lots.length,
  category: Object.fromEntries(
    CATEGORIES.map(c => [c, lots.filter(l => l.category === c).length])
  ) as Record<typeof CATEGORIES[number], number>,
  score: Object.fromEntries(
    SCORE_STEPS.map(s => [s, lots.filter(l => (l.score ?? 0) === s).length])
  ) as Record<number, number>,
  source: Object.fromEntries(
    SOURCES.map(s => [s, lots.filter(l => l.source === s).length])
  ) as Record<string, number>,
  prestigeSeller: lots.filter(isPrestigeSeller).length,
  closingSoon: lots.filter(isClosingSoon).length,
  withPhotos: lots.filter(l => (l.photos?.length ?? 0) > 0).length,
};

function fmtINR(rupees: number | null): string {
  if (rupees == null) return "no reserve";
  if (rupees >= 10_000_000) return `₹${(rupees / 10_000_000).toFixed(2)} cr`;
  if (rupees >= 100_000)    return `₹${(rupees / 100_000).toFixed(2)} L`;
  return `₹${rupees.toLocaleString("en-IN")}`;
}
// nominal "token" reserves (≤ ₹10) are real listed values, not defaults
const isTokenReserve = (r: number | null) => r != null && r > 0 && r <= 10;
const TOKEN_TIP = "MSTC publishes this reserve as listed. Token reserves "
  + "of a few rupees are standard in government disposal auctions; "
  + "the EMD and competitive bidding set the actual price.";
function fmtClose(iso: string | null): string {
  if (!iso) return "—";
  return iso.replace("T", " ").replace("Z", "") + " UTC";
}
function statusMark(lot: Lot): string {
  if (lot.boosted) return "BOOSTED";
  if (lot.status === "closed") return "CLOSED";
  if (lot.status === "cancelled") return "CANCELLED";
  return "ACTIVE";
}

// ── score-graded groups (collapsible; default all closed) ──────────────────
const groupMap = new Map<number | null, Lot[]>();
for (const lot of lots) {
  const key = lot.score ?? null;
  if (!groupMap.has(key)) groupMap.set(key, []);
  groupMap.get(key)!.push(lot);
}
let __n = 0;
const scoreGroups = [...groupMap.keys()]
  .sort((a, b) => (b ?? -1) - (a ?? -1))
  .map(score => ({
    score,
    glots: groupMap.get(score)!.map(lot => ({ lot, num: ++__n })),
  }));
---
<BaseLayout
  title="The register · auctionhouse.nl06"
  description="Every lot currently surfaced by the auctionhouse pipeline: Indian government surplus and disposal auctions on MSTC, scored nightly."
  itemNumber="№ AH01"
>
  <article class="ah">
    <Container size="wide" class="ah__inner">
      <header class="ah__head">
        <div class="ah__rail">
          <span class="rail__label">Last refresh</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">{syncedISO}</span>
          <a class="rail__back" href="/">← Auctionhouse front page</a>
        </div>

        <div class="ah__heading">
          <span class="ah__eyebrow">The full curated cut, updated nightly</span>
          <h1 class="ah__title">
            <span class="ah__title-line">The register.</span>
          </h1>
          <p class="ah__lede">
            Every lot that currently clears the publishing floor:
            {lots.length} of {counts.active?.toLocaleString("en-IN")} active lots
            across MSTC, BAANKNET, and IREPS. Use search to reach
            the rest of the database.
          </p>
        </div>
      </header>

      <section class="ah__register" id="register">
        <SearchBar searchable={counts.searchable ?? counts.active} />

        {lots.length > 0 && (
          <form class="ah__filters" data-ah-filters>
            <div class="ah__filter-row">
              <span class="ah__filter-label">Show</span>
              <button type="button" class="ah__chip is-active"
                      data-facet="category" data-value="*" aria-pressed="true">
                All <small>{facetCounts.total}</small>
              </button>
              {CATEGORIES.map(cat => (
                <button type="button" class="ah__chip"
                        data-facet="category" data-value={cat} aria-pressed="false">
                  {CATEGORY_LABELS[cat]} <small>{facetCounts.category[cat]}</small>
                </button>
              ))}
            </div>
            <div class="ah__filter-row">
              <span class="ah__filter-label">Score</span>
              {SCORE_STEPS.map(s => (
                <button type="button" class="ah__chip"
                        data-facet="minscore" data-value={String(s)} aria-pressed="false">
                  {s}/10 <small>{facetCounts.score[s]}</small>
                </button>
              ))}
            </div>
            {SOURCES.length > 1 && (
              <div class="ah__filter-row">
                <span class="ah__filter-label">Agency</span>
                <button type="button" class="ah__chip is-active"
                        data-facet="source" data-value="*" aria-pressed="true">
                  All <small>{facetCounts.total}</small>
                </button>
                {SOURCES.map(s => (
                  <button type="button" class="ah__chip"
                          data-facet="source" data-value={s} aria-pressed="false">
                    {SOURCE_LABELS[s] ?? s.toUpperCase()} <small>{facetCounts.source[s]}</small>
                  </button>
                ))}
              </div>
            )}
            <div class="ah__filter-row">
              <span class="ah__filter-label">Subset</span>
              <button type="button" class="ah__chip"
                      data-facet="prestige-seller" data-value="1" aria-pressed="false">
                From prestige seller <small>{facetCounts.prestigeSeller}</small>
              </button>
              <button type="button" class="ah__chip"
                      data-facet="closing-soon" data-value="1" aria-pressed="false">
                Closing in {CLOSING_SOON_DAYS}d <small>{facetCounts.closingSoon}</small>
              </button>
              <button type="button" class="ah__chip"
                      data-facet="has-photos" data-value="1" aria-pressed="false">
                With photos <small>{facetCounts.withPhotos}</small>
              </button>
              <button type="button" class="ah__chip ah__chip--reset"
                      data-facet="reset" hidden>
                Reset
              </button>
              <span class="ah__filter-status" data-ah-status>
                {lots.length} showing
              </span>
            </div>
          </form>
        )}

        {lots.length === 0 ? (
          <div class="ah__empty">
            <p class="ah__empty-headline">
              No active lots currently meet the publishing threshold.
            </p>
            <p class="ah__empty-detail">
              The pipeline ran at <time datetime={meta.synced_at_utc}>{syncedISO}</time>.
              It tracks <strong>{counts.active}</strong> active lots and has scored
              <strong> {counts.scored_active}</strong> of them. The highest-scoring
              active lot today is <strong>{counts.top_active_score}/10</strong>.
              New lots arrive nightly; the lowest publishing floor is
              {lowestThreshold}/10 (prestige &amp; curio).
            </p>
            {lastRunErr ? (
              <p class="ah__empty-error">
                Last ingestion attempt failed: <code>{lastRunErr.slice(0, 200)}</code>.
                The page is showing the snapshot from before that failure.
              </p>
            ) : null}
          </div>
        ) : (
          <div class="ah__register-groups" data-ah-list>
            <div class="ah__groupbar">
              <span class="ah__groupbar-label">Graded by score</span>
              <button type="button" class="ah__chip" data-groups="expand">Expand all</button>
              <button type="button" class="ah__chip" data-groups="collapse">Collapse all</button>
            </div>
            {scoreGroups.map(g => (
            <details class="ah-group" data-ah-group>
              <summary class="ah-group__head">
                <span class="ah-group__score">{g.score != null ? `${g.score}/10` : "unscored"}</span>
                <span class="ah-group__rule" aria-hidden="true"></span>
                <span class="ah-group__count">{g.glots.length} {g.glots.length === 1 ? "lot" : "lots"}</span>
                <span class="ah-group__chev" aria-hidden="true">+</span>
              </summary>
              <ol class="ah__register-list">
            {g.glots.map(({ lot, num }) => (
              <li
                class="reveal"
                id={`lot-${lot.id}`}
                data-ah-item
                data-index={String(num)}
                data-category={lot.category ?? ""}
                data-score={String(lot.score ?? 0)}
                data-prestige-seller={isPrestigeSeller(lot) ? "1" : "0"}
                data-has-photos={(lot.photos?.length ?? 0) > 0 ? "1" : "0"}
                data-close-utc={lot.close_at_utc ?? ""}
                data-source={lot.source ?? ""}
              >
                <article class="ah-lot">
                  <aside class="ah-lot__rail">
                    <span class="ah-lot__mark" data-ah-mark>Lot №&nbsp;{String(num).padStart(2, "0")}</span>
                    {lot.source ? (
                      <span class="ah-lot__source">{SOURCE_LABELS[lot.source] ?? lot.source.toUpperCase()}</span>
                    ) : null}
                    <span class="ah-lot__stamp" aria-label={`score ${lot.score} out of 10`}>
                      <b>{lot.score ?? "·"}</b><i>/10</i>
                    </span>
                    <span class:list={[
                      "status-mark",
                      lot.status === "active" ? "status-mark--live" : "status-mark--unresolved",
                    ]}>{statusMark(lot)}</span>
                    {isNew(lot) ? <span class="ah-lot__new">New this run</span> : null}
                    {lot.category ? <span class="ah-lot__cat">{lot.category}</span> : null}
                    {lot.sublot_count > 1 ? (
                      <span class="ah-lot__sublots">× {lot.sublot_count} sublots</span>
                    ) : null}
                    {lot.close_at_utc ? (
                      <span class="ah-lot__when">Close · {fmtClose(lot.close_at_utc)}</span>
                    ) : null}
                  </aside>

                  <div class="ah-lot__body">
                    <h3 class="ah-lot__title">
                      <a href={lot.source_url} rel="noopener" target="_blank">
                        {lot.score_title ?? lot.title}
                      </a>
                    </h3>
                    {lot.note ? (
                      <p class:list={["ah-lot__note", lot.note_is_editor && "ah-lot__note--editor"]}>
                        {lot.note}
                      </p>
                    ) : null}
                    {lot.group_more && lot.group_more > 0 ? (
                      <p class="ah-lot__more">
                        + {lot.group_more} more {lot.category} {lot.group_more === 1 ? "lot" : "lots"} from this seller, collapsed
                      </p>
                    ) : null}

                    {lot.photos && lot.photos.length > 0 && (
                      <div class="ah-lot__photos" data-ah-photos data-title={lot.title}>
                        {lot.photos.map((p, pi) => (
                          <button type="button" class="ah-lot__photo"
                                  data-photo={p} data-photo-index={String(pi)}>
                            <img src={p} alt={`photo ${pi + 1} from the lot annexure`} loading="lazy" />
                          </button>
                        ))}
                        <span class="ah-lot__photos-note">from the annexure PDF</span>
                      </div>
                    )}

                    <dl class="ah-lot__rows">
                      {lot.seller && (
                        <div class="ah-lot__row"><dt>Selling agency</dt><dd>
                          {lot.seller} <span class="ah-lot__chip">{lot.seller_category}</span>
                        </dd></div>
                      )}
                      {lot.location && (
                        <div class="ah-lot__row"><dt>Location</dt><dd>{lot.location}</dd></div>
                      )}
                      {lot.start_price_inr != null && (
                        <div class="ah-lot__row"><dt>Reserve</dt>
                          <dd class="tabular">
                            {fmtINR(lot.start_price_inr)}
                            {isTokenReserve(lot.start_price_inr) ? (
                              <span class="ah-lot__token" title={TOKEN_TIP}>token reserve, as listed</span>
                            ) : null}
                            {lot.sublot_count > 1 ? (
                              <span class="ah-lot__sublot-note">&nbsp;per sublot</span>
                            ) : null}
                          </dd></div>
                      )}
                      {lot.emd_inr != null && (
                        <div class="ah-lot__row"><dt>EMD</dt><dd class="tabular">{fmtINR(lot.emd_inr)}</dd></div>
                      )}
                      {lot.close_at_utc && (
                        <div class="ah-lot__row"><dt>Closes</dt><dd class="tabular">{fmtClose(lot.close_at_utc)}</dd></div>
                      )}
                      {lot.annexures && lot.annexures.length > 0 && (
                        <div class="ah-lot__row"><dt>Annexures</dt><dd>
                          <ul class="ah-lot__annex">
                            {lot.annexures.map(ax => (
                              <li>
                                <a href={ax.url} rel="noopener" target="_blank">{ax.filename}</a>
                                {ax.has_text
                                  ? null
                                  : <span class="ah-lot__annex-note"> (no extractable text)</span>}
                              </li>
                            ))}
                          </ul>
                        </dd></div>
                      )}
                    </dl>
                  </div>
                </article>
              </li>
            ))}
              </ol>
            </details>
            ))}
          </div>
        )}
      </section>

      <footer class="ah__pipeline">
        <p class="ah__pipeline-line">
          Pipeline last completed <time datetime={meta.synced_at_utc}>{syncedISO}</time>.
          {counts.scored_active}/{counts.active} scored.
          &nbsp;·&nbsp;
          <a href="/">front page</a> ·
          <a href="/feeds/register.xml">RSS</a> ·
          <a href="/feeds/register.json">JSON</a>
        </p>
      </footer>
    </Container>
  </article>

  <LotModal />

  <!-- PHOTO LIGHTBOX -->
  <dialog class="ah-lightbox" data-ah-lightbox>
    <button class="ah-lightbox__close" data-lb-close aria-label="close">×</button>
    <button class="ah-lightbox__nav ah-lightbox__nav--prev" data-lb-prev aria-label="previous">‹</button>
    <figure>
      <img data-lb-img src="" alt="lot photo, extracted from the annexure PDF" />
      <figcaption data-lb-cap></figcaption>
    </figure>
    <button class="ah-lightbox__nav ah-lightbox__nav--next" data-lb-next aria-label="next">›</button>
  </dialog>

  <script>
    // facet filters (same behavior as the old single-page register)
    type FacetState = {
      categories: Set<string>; minScore: number | null;
      source: string | null;
      prestigeSeller: boolean; closingSoon: boolean; hasPhotos: boolean;
    };
    const root = document.querySelector<HTMLFormElement>("[data-ah-filters]");
    const list = document.querySelector<HTMLOListElement>("[data-ah-list]");
    if (root && list) {
      const items = Array.from(list.querySelectorAll<HTMLLIElement>("[data-ah-item]"));
      const status = root.querySelector<HTMLElement>("[data-ah-status]");
      const resetBtn = root.querySelector<HTMLButtonElement>("[data-facet=reset]");
      const allBtn   = root.querySelector<HTMLButtonElement>('[data-facet=category][data-value="*"]');
      const total    = items.length;
      const closingSoonMs = Date.now() + 7 * 86_400_000;
      const state: FacetState = {
        categories: new Set(), minScore: null,
        source: null,
        prestigeSeller: false, closingSoon: false, hasPhotos: false,
      };
      function press(btn: HTMLButtonElement | null, on: boolean) {
        if (!btn) return;
        btn.classList.toggle("is-active", on);
        btn.setAttribute("aria-pressed", on ? "true" : "false");
      }
      function apply() {
        let shown = 0;
        for (const li of items) {
          const cat   = li.dataset.category || "";
          const score = Number(li.dataset.score || 0);
          const ps    = li.dataset.prestigeSeller === "1";
          const ph    = li.dataset.hasPhotos === "1";
          const close = li.dataset.closeUtc;
          const closeMs = close ? Date.parse(close) : Infinity;
          const src = li.dataset.source || "";
          const show =
            (state.categories.size === 0 || state.categories.has(cat)) &&
            (state.minScore == null || score === state.minScore) &&
            (state.source == null || src === state.source) &&
            (!state.prestigeSeller || ps) &&
            (!state.hasPhotos || ph) &&
            (!state.closingSoon || closeMs <= closingSoonMs);
          li.hidden = !show;
          if (show) shown++;
        }
        let n = 0;
        for (const li of items) {
          if (li.hidden) continue;
          n++;
          const mark = li.querySelector<HTMLElement>("[data-ah-mark]");
          if (mark) mark.textContent = `Lot № ${String(n).padStart(2, "0")}`;
        }
        if (status) status.textContent = shown === total ? `${shown} showing` : `${shown} of ${total} showing`;
        const anyActive = state.categories.size > 0 || state.minScore != null ||
          state.source != null ||
          state.prestigeSeller || state.hasPhotos || state.closingSoon;
        if (resetBtn) resetBtn.hidden = !anyActive;

        // group bookkeeping: a filter auto-opens groups that contain matches
        // and hides groups with none; clearing filters restores the default
        // all-collapsed ledger
        document.querySelectorAll<HTMLDetailsElement>("[data-ah-group]").forEach(d => {
          const any = [...d.querySelectorAll<HTMLElement>("[data-ah-item]")]
            .some(li => !li.hidden);
          d.hidden = !any;
          d.open = anyActive ? any : false;
        });
      }
      function handle(btn: HTMLButtonElement) {
        const facet = btn.dataset.facet!;
        const value = btn.dataset.value;
        if (facet === "category") {
          if (value === "*") state.categories.clear();
          else if (value) {
            state.categories.has(value) ? state.categories.delete(value) : state.categories.add(value);
          }
          press(allBtn, state.categories.size === 0);
          root!.querySelectorAll<HTMLButtonElement>('[data-facet=category]:not([data-value="*"])')
            .forEach(b => press(b, state.categories.has(b.dataset.value!)));
        } else if (facet === "minscore") {
          const n = Number(value);
          state.minScore = state.minScore === n ? null : n;
          root!.querySelectorAll<HTMLButtonElement>("[data-facet=minscore]")
            .forEach(b => press(b, Number(b.dataset.value) === state.minScore));
        } else if (facet === "source") {
          const allSrcBtn = root!.querySelector<HTMLButtonElement>('[data-facet=source][data-value="*"]');
          if (value === "*") {
            state.source = null;
          } else {
            state.source = state.source === value ? null : (value ?? null);
          }
          press(allSrcBtn, state.source == null);
          root!.querySelectorAll<HTMLButtonElement>('[data-facet=source]:not([data-value="*"])')
            .forEach(b => press(b, b.dataset.value === state.source));
        } else if (facet === "prestige-seller") { state.prestigeSeller = !state.prestigeSeller; press(btn, state.prestigeSeller); }
        else if (facet === "closing-soon")      { state.closingSoon = !state.closingSoon; press(btn, state.closingSoon); }
        else if (facet === "has-photos")        { state.hasPhotos = !state.hasPhotos; press(btn, state.hasPhotos); }
        else if (facet === "reset") {
          state.categories.clear(); state.minScore = null; state.source = null;
          state.prestigeSeller = false; state.closingSoon = false; state.hasPhotos = false;
          root!.querySelectorAll<HTMLButtonElement>(".ah__chip").forEach(b => press(b, false));
          press(allBtn, true);
          const allSrcBtn = root!.querySelector<HTMLButtonElement>('[data-facet=source][data-value="*"]');
          press(allSrcBtn, true);
        }
        apply();
      }
      root.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".ah__chip");
        if (btn) handle(btn);
      });
      root.addEventListener("submit", (e) => e.preventDefault());
      apply();
    }

    // expand-all / collapse-all
    document.querySelectorAll<HTMLButtonElement>("[data-groups]").forEach(btn => {
      btn.addEventListener("click", () => {
        const open = btn.dataset.groups === "expand";
        document.querySelectorAll<HTMLDetailsElement>("[data-ah-group]")
          .forEach(d => { if (!d.hidden) d.open = open; });
      });
    });

    // deep links (#lot-…) must open the enclosing group before scrolling
    function openHashTarget() {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id.startsWith("lot-")) return;
      const el = document.getElementById(id);
      if (!el) return;
      const d = el.closest<HTMLDetailsElement>("details[data-ah-group]");
      if (d) d.open = true;
      requestAnimationFrame(() =>
        el.scrollIntoView({ behavior: "smooth", block: "center" }));
    }
    openHashTarget();
    addEventListener("hashchange", openHashTarget);
  </script>

  <script>
    // photo lightbox
    const lb = document.querySelector<HTMLDialogElement>("[data-ah-lightbox]");
    if (lb) {
      const img = lb.querySelector<HTMLImageElement>("[data-lb-img]")!;
      const cap = lb.querySelector<HTMLElement>("[data-lb-cap]")!;
      let photos: string[] = []; let title = ""; let idx = 0;
      function show(i: number) {
        idx = (i + photos.length) % photos.length;
        img.src = photos[idx];
        cap.textContent = `${title} · photo ${idx + 1} of ${photos.length}, extracted from the annexure PDF`;
      }
      document.querySelectorAll<HTMLElement>("[data-ah-photos]").forEach(strip => {
        strip.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-photo]");
          if (!btn) return;
          photos = Array.from(strip.querySelectorAll<HTMLButtonElement>("[data-photo]")).map(b => b.dataset.photo!);
          title = strip.dataset.title || "";
          show(Number(btn.dataset.photoIndex || 0));
          lb.showModal();
        });
      });
      lb.querySelector("[data-lb-close]")!.addEventListener("click", () => lb.close());
      lb.querySelector("[data-lb-prev]")!.addEventListener("click", () => show(idx - 1));
      lb.querySelector("[data-lb-next]")!.addEventListener("click", () => show(idx + 1));
      lb.addEventListener("click", (e) => { if (e.target === lb) lb.close(); });
      lb.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(idx - 1);
        if (e.key === "ArrowRight") show(idx + 1);
      });
    }
  </script>

  <script>
    // reveal-on-scroll
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const targets = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
    if (targets.length && !reduced && "IntersectionObserver" in window) {
      document.documentElement.classList.add("js-reveal");
      const io = new IntersectionObserver((records, obs) => {
        records.forEach((rec) => {
          if (rec.isIntersecting) { rec.target.classList.add("is-in"); obs.unobserve(rec.target); }
        });
      }, { rootMargin: "0px 0px -10% 0px", threshold: 0.12 });
      targets.forEach((el) => io.observe(el));
    }
  </script>
