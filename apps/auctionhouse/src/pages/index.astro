---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";

// Static-time imports. sync-auctionhouse.py writes both files before the
// build runs; an empty lots.json is the normal "no qualifying lots today"
// state, not an error.
import lotsData from "../content/lots.json";
import metaData from "../content/meta.json";

type Lot = {
  id:               string;
  source:           string;
  source_url:       string;
  title:            string;
  seller:           string | null;
  seller_category:  string;
  location:         string | null;
  start_price_inr:  number | null;
  emd_inr:          number | null;
  close_at_utc:     string | null;
  status:           string;
  score:            number | null;
  category:         string | null;
  confidence:       number | null;
  note:             string | null;
  note_is_editor:   boolean;
  boosted:          boolean;
};

const lots: Lot[] = lotsData as Lot[];
const meta:  any  = metaData;

const synced     = new Date(meta.synced_at_utc);
const syncedISO  = synced.toISOString().slice(0, 16).replace("T", " ") + " UTC";
const counts     = meta.counts as Record<string, number>;
const threshold  = meta.min_publish_score as number;
const lastRun    = meta.last_run as any | null;
const lastRunErr = lastRun?.error as string | null;

function fmtINR(rupees: number | null): string {
  if (rupees == null) return "—";
  if (rupees >= 10_000_000) return `₹${(rupees / 10_000_000).toFixed(2)} cr`;
  if (rupees >= 100_000)    return `₹${(rupees / 100_000).toFixed(2)} L`;
  return `₹${rupees.toLocaleString("en-IN")}`;
}

function fmtClose(iso: string | null): string {
  if (!iso) return "—";
  return iso.replace("T", " ").replace("Z", "") + " UTC";
}

function statusMark(lot: Lot): string {
  if (lot.boosted) return "BOOSTED";
  if (lot.status === "closed") return "CLOSED";
  if (lot.status === "cancelled") return "CANCELLED";
  return "ACTIVE";
}
---
<BaseLayout
  title="auctionhouse.nl06 — A register of government lots"
  description="A curated register of Indian government surplus and disposal auctions from MSTC India. Updated nightly."
  itemNumber="№ AH00"
>
  <article class="ah">
    <Container size="wide" class="ah__inner">
      <!-- HERO ─────────────────────────────────────────────────── -->
      <header class="ah__head">
        <div class="ah__rail">
          <span class="rail__label">Last refresh</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">{syncedISO}</span>
        </div>

        <div class="ah__heading">
          <span class="ah__eyebrow">A standing register of public-sector auctions, India</span>
          <h1 class="ah__title">
            <span class="ah__title-line">Auctionhouse.</span>
            <span class="ah__title-emphasis">What the state is selling.</span>
          </h1>
          <p class="ah__lede dropcap-text">
            Every working day the Government of India puts thousands of lots on the open
            market through <strong>MSTC Limited</strong> &mdash; the public-sector
            e-auction platform that handles surplus, disposal, and confiscated-goods sales
            for the Ministries, the Railways, defence-PSU yards, port trusts, customs
            warehouses, and the central banks of seized metal. Most of it goes through
            quietly. This register watches the ones that don&rsquo;t.
          </p>

          <p class="ah__sub">
            Scored nightly against an editorial floor of {threshold}/10. The handful
            of lots that clear it appear below. Everything else stays in the index but
            does not surface.
          </p>
        </div>
      </header>

      <!-- REGISTER ──────────────────────────────────────────────── -->
      <section class="ah__register" id="register">
        <header class="ah__banner">
          <span class="ah__banner__num">¶</span>
          <h2 class="ah__banner__title">The register</h2>
          <span class="ah__banner__rule" aria-hidden="true"></span>
          <span class="ah__banner__count">
            {lots.length} above threshold · {counts.active} active · {counts.scored_active} scored
          </span>
        </header>

        {lots.length === 0 ? (
          <div class="ah__empty">
            <p class="ah__empty-headline">
              The register is open. No lots currently clear the editorial floor.
            </p>
            <p class="ah__empty-detail">
              The pipeline ran at <time datetime={meta.synced_at_utc}>{syncedISO}</time>.
              It tracks <strong>{counts.active}</strong> active lots across MSTC&rsquo;s
              twenty regional offices, and has scored <strong>{counts.scored_active}</strong>
              of them. The highest-scoring active lot today is
              <strong> {counts.top_active_score}/10</strong>. New lots arrive nightly;
              the floor is {threshold}/10.
            </p>
            {lastRunErr ? (
              <p class="ah__empty-error">
                Last ingestion attempt failed: <code>{lastRunErr.slice(0, 200)}</code>.
                The page is showing the snapshot from before that failure.
              </p>
            ) : null}
          </div>
        ) : (
          <ol class="ah__register-list">
            {lots.map((lot, i) => (
              <li>
                <article class="ah-lot">
                  <aside class="ah-lot__rail">
                    <span class="ah-lot__mark">Lot №&nbsp;{String(i + 1).padStart(2, "0")}</span>
                    <span class:list={[
                      "status-mark",
                      lot.status === "active" ? "status-mark--live" : "status-mark--unresolved",
                    ]}>{statusMark(lot)}</span>
                    {lot.score != null ? (
                      <span class="ah-lot__score">Score {lot.score}/10</span>
                    ) : null}
                    {lot.category ? (
                      <span class="ah-lot__cat">{lot.category}</span>
                    ) : null}
                    {lot.close_at_utc ? (
                      <span class="ah-lot__when">Close · {fmtClose(lot.close_at_utc)}</span>
                    ) : null}
                  </aside>

                  <div class="ah-lot__body">
                    <h3 class="ah-lot__title">
                      <a href={lot.source_url} rel="noopener" target="_blank">{lot.title}</a>
                    </h3>
                    {lot.note ? (
                      <p class:list={["ah-lot__note", lot.note_is_editor && "ah-lot__note--editor"]}>
                        {lot.note}
                      </p>
                    ) : null}
                    <dl class="ah-lot__rows">
                      {lot.seller && (
                        <div class="ah-lot__row"><dt>Selling agency</dt><dd>
                          {lot.seller} <span class="ah-lot__chip">{lot.seller_category}</span>
                        </dd></div>
                      )}
                      {lot.location && (
                        <div class="ah-lot__row"><dt>Location</dt><dd>{lot.location}</dd></div>
                      )}
                      {lot.start_price_inr != null && (
                        <div class="ah-lot__row"><dt>Reserve</dt><dd class="tabular">{fmtINR(lot.start_price_inr)}</dd></div>
                      )}
                      {lot.emd_inr != null && (
                        <div class="ah-lot__row"><dt>EMD</dt><dd class="tabular">{fmtINR(lot.emd_inr)}</dd></div>
                      )}
                      {lot.close_at_utc && (
                        <div class="ah-lot__row"><dt>Closes</dt><dd class="tabular">{fmtClose(lot.close_at_utc)}</dd></div>
                      )}
                    </dl>
                  </div>
                </article>
              </li>
            ))}
          </ol>
        )}
      </section>

      <!-- METHODOLOGY ─────────────────────────────────────────── -->
      <section class="ah__method" id="methodology">
        <header class="ah__banner">
          <span class="ah__banner__num">§</span>
          <h2 class="ah__banner__title">Methodology</h2>
          <span class="ah__banner__rule" aria-hidden="true"></span>
          <span class="ah__banner__count">Updated nightly</span>
        </header>

        <ol class="ah__method-steps">
          <li class="ah-step">
            <span class="ah-step__num">01</span>
            <div class="ah-step__body">
              <h3 class="ah-step__head">Ingest</h3>
              <p class="ah-step__text">
                A nightly crawl of MSTC&rsquo;s catalogue pages across all twenty
                regional offices. Each auction is captured once with provenance &mdash;
                URL, snapshot, fetched-at timestamp.
              </p>
            </div>
          </li>
          <li class="ah-step">
            <span class="ah-step__num">02</span>
            <div class="ah-step__body">
              <h3 class="ah-step__head">Normalise</h3>
              <p class="ah-step__text">
                Lots are mapped to a single schema: selling agency, category,
                location, reserve price, EMD, start, close. Annexures &mdash;
                the per-lot detail PDFs MSTC publishes alongside the catalogue
                &mdash; are fetched and excerpted.
              </p>
            </div>
          </li>
          <li class="ah-step">
            <span class="ah-step__num">03</span>
            <div class="ah-step__body">
              <h3 class="ah-step__head">Score</h3>
              <p class="ah-step__text">
                Every lot is scored 1&ndash;10 against four categories: arbitrage,
                niche-instrument, prestige-seller, curio. Conservative by default.
                Lots that clear {threshold}/10 surface in the register; everything
                else stays in the index.
              </p>
            </div>
          </li>
          <li class="ah-step">
            <span class="ah-step__num">04</span>
            <div class="ah-step__body">
              <h3 class="ah-step__head">Annotate</h3>
              <p class="ah-step__text">
                A small subset of lots gets a written note &mdash; what&rsquo;s
                being sold, why it&rsquo;s interesting, what the close attracted.
                Hand-written, infrequent, opinionated.
              </p>
            </div>
          </li>
        </ol>
      </section>

      <!-- SOURCES ─────────────────────────────────────────────── -->
      <section class="ah__sources" id="sources">
        <header class="ah__banner">
          <span class="ah__banner__num">¤</span>
          <h2 class="ah__banner__title">Primary sources</h2>
          <span class="ah__banner__rule" aria-hidden="true"></span>
          <span class="ah__banner__count">As of {synced.getUTCFullYear()}</span>
        </header>

        <dl class="ah__sources-list">
          <div class="ah__source">
            <dt>MSTC Limited</dt>
            <dd>
              <a href="https://www.mstcindia.co.in" rel="noopener">mstcindia.co.in</a>
              &nbsp;&mdash;&nbsp; the Government of India&rsquo;s e-auction platform
              for surplus, disposal, scrap, and confiscated goods. The primary
              ingest target.
            </dd>
          </div>
          <div class="ah__source">
            <dt>DGS&amp;D / GeM</dt>
            <dd>
              The Government e-Marketplace handles procurement, not auctions, so
              it is out of scope here. Cross-referenced when an MSTC lot is the
              upstream consequence of a GeM procurement decision.
            </dd>
          </div>
          <div class="ah__source">
            <dt>Selling-agency catalogues</dt>
            <dd>
              Railway divisions, defence PSUs, port trusts, central PSU mills
              and refineries each publish their own catalogues alongside the
              MSTC listing. Used to verify lot composition and condition.
            </dd>
          </div>
        </dl>

        <p class="ah__caveat">
          The register tracks what is publicly listed on MSTC. It does not predict
          outcomes, advise on bidding, or represent any seller or buyer. The
          intent is the same as the rest of <a href="https://nl06.com">nl06</a>:
          watch a running system, write down what it does.
        </p>
      </section>

      <!-- PIPELINE STATUS (footer note) ───────────────────────── -->
      <footer class="ah__pipeline">
        <p class="ah__pipeline-line">
          Pipeline last completed
          <time datetime={meta.synced_at_utc}>{syncedISO}</time>.
          {counts.scored_active}/{counts.active} scored.
          {lastRun ? `Last ingestion: ${lastRun.source} run #${lastRun.started_at_utc?.slice(0,10)}` : ""}
          {lastRunErr ? <span class="ah__pipeline-fail"> (failed)</span> : null}
        </p>
      </footer>

      <p class="ornament" aria-hidden="true"></p>
    </Container>
  </article>
</BaseLayout>

<style>
  .ah { padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .ah :global(.ah__inner) {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
  }

  /* HEAD ────────────────────────────────────────────────────── */
  .ah__head {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-rule);
  }
  .ah__rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }
  .rail__label, .rail__date {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .rail__label { color: var(--color-ink); font-weight: 600; }
  .rail__date  { color: var(--color-accent); }
  .rail__rule  { height: 1px; background: var(--color-rule); }

  .ah__eyebrow {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-6);
  }
  .ah__title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-jumbo);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .ah__title-line { display: block; }
  .ah__title-emphasis {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }
  .ah__lede {
    margin-top: var(--space-6);
    font-family: var(--font-serif);
    font-size: var(--type-h4);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    max-width: 44rem;
  }
  .ah__sub {
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink-soft);
    max-width: 44rem;
    padding-top: var(--space-5);
    border-top: 1px dashed var(--color-rule-strong);
  }

  /* BANNER ──────────────────────────────────────────────────── */
  .ah__register, .ah__method, .ah__sources {
    grid-column: 1 / -1;
    margin-top: var(--space-16);
  }
  .ah__banner {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 3px solid var(--color-ink);
    position: relative;
  }
  .ah__banner::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    border-bottom: 1px solid var(--color-ink);
  }
  .ah__banner__num {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-h1);
    color: var(--color-accent);
    line-height: 0.9;
  }
  .ah__banner__title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h1);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .ah__banner__rule { height: 1px; background: var(--color-rule); align-self: center; }
  .ah__banner__count {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }

  /* EMPTY STATE ─────────────────────────────────────────────── */
  .ah__empty {
    margin: var(--space-10) 0;
    padding: var(--space-8);
    background: var(--color-paper-margin);
    border: 1px dashed var(--color-rule-strong);
    max-width: 50rem;
  }
  .ah__empty-headline {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h3);
    color: var(--color-ink);
    margin: 0;
  }
  .ah__empty-detail {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink-soft);
  }
  .ah__empty-error {
    margin-top: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--type-small);
    color: var(--color-ink-muted);
  }
  .ah__empty-error code {
    font-family: var(--font-mono);
    background: var(--color-paper);
    padding: 0 0.25em;
  }

  /* REGISTER LIST ───────────────────────────────────────────── */
  .ah__register-list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }

  /* LOT card ────────────────────────────────────────────────── */
  .ah-lot {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--color-ink);
    background: var(--color-paper-margin);
  }
  .ah-lot__rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ah-lot__mark {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-h2);
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .ah-lot__when, .ah-lot__cat, .ah-lot__score {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .ah-lot__score { color: var(--color-accent); font-weight: 600; }
  .ah-lot__body { max-width: 50rem; }
  .ah-lot__title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h2);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    letter-spacing: var(--tracking-display);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }
  .ah-lot__title a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted var(--color-rule-strong);
  }
  .ah-lot__title a:hover { color: var(--color-accent); }
  .ah-lot__note {
    margin: var(--space-4) 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink-soft);
  }
  .ah-lot__note--editor {
    font-style: normal;
    color: var(--color-ink);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-4);
  }
  .ah-lot__rows {
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-3) var(--space-6);
  }
  .ah-lot__row { display: contents; }
  .ah-lot__rows dt {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink);
    font-feature-settings: var(--features-tabular);
    font-weight: 600;
    padding-top: 0.18em;
  }
  .ah-lot__rows dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--type-small);
    color: var(--color-ink-muted);
    line-height: var(--leading-normal);
  }
  .ah-lot__rows dd.tabular { font-feature-settings: var(--features-tabular); }
  .ah-lot__chip {
    display: inline-block;
    margin-left: 0.5em;
    padding: 0 0.5em;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
  }

  /* METHODOLOGY ─────────────────────────────────────────────── */
  .ah__method-steps {
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--color-rule);
    border-left: 1px solid var(--color-rule);
    max-width: 56rem;
  }
  .ah-step {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-6);
    border-right: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .ah-step + .ah-step { margin-top: 0; }
  .ah-step__num {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-h1);
    color: var(--color-accent);
    line-height: 0.9;
    font-feature-settings: var(--features-tabular);
  }
  .ah-step__head {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h4);
    color: var(--color-ink);
  }
  .ah-step__text {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--type-small);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
  }

  /* SOURCES ─────────────────────────────────────────────────── */
  .ah__sources-list {
    margin: var(--space-8) 0 0;
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-5) var(--space-6);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    padding: var(--space-6) 0;
  }
  .ah__source { display: contents; }
  .ah__sources-list dt {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink);
    font-feature-settings: var(--features-tabular);
    font-weight: 600;
    padding-top: 0.18em;
  }
  .ah__sources-list dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink);
  }
  .ah__caveat {
    margin-top: var(--space-6);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-small);
    color: var(--color-ink-muted);
    max-width: 50rem;
  }

  /* PIPELINE STATUS FOOTER ──────────────────────────────────── */
  .ah__pipeline {
