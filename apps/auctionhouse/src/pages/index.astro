---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import LotModal   from "~/components/LotModal.astro";

// Static-time imports. sync-auctionhouse.py writes both files before the
// build runs; an empty lots.json is the normal "no qualifying lots today"
// state, not an error.
import lotsData from "../content/lots.json";
import metaData from "../content/meta.json";

type Lot = {
  id: string; source: string; source_url: string; title: string; score_title: string | null; seller: string | null;
  seller_category: string; location: string | null;
  start_price_inr: number | null; close_at_utc: string | null;
  status: string; score: number | null; category: string | null;
  confidence: number | null; note: string | null; note_is_editor: boolean; boosted: boolean;
  first_seen_utc?: string | null; photos?: string[];
};

const lots: Lot[] = lotsData as Lot[];
const meta:  any  = metaData;

const ALERTS_WORKER = "https://auctionhouse-alerts.nl06.workers.dev";

const synced     = new Date(meta.synced_at_utc);
const syncedISO  = synced.toISOString().slice(0, 16).replace("T", " ") + " UTC";
const counts     = meta.counts as Record<string, number>;
const filter     = meta.publish_filter as {
  category_thresholds: Record<string, number>;
  prestige_categories: string[];
  prestige_seller_floor: number;
};
const lastRun    = meta.last_run as any | null;
const lastRunErr = lastRun?.error as string | null;

// ── derived shelves ─────────────────────────────────────────────────────────
const spotlightIds = new Set<string>((meta.spotlight_ids ?? []) as string[]);
const spotlight    = lots.filter(l => spotlightIds.has(l.id));

// Hammer falls: strictly OPEN lots only (close in the future at build time;
// the client also hides anything that closes while the page is up), in
// ascending close order — soonest first.
const CLOSING_RAIL_HOURS = 72;
const railCutoffMs = synced.getTime() + CLOSING_RAIL_HOURS * 3600 * 1000;
const closingRail = lots
  .filter(l => l.close_at_utc
            && Date.parse(l.close_at_utc) > synced.getTime()
            && Date.parse(l.close_at_utc) <= railCutoffMs)
  .sort((a, b) => Date.parse(a.close_at_utc!) - Date.parse(b.close_at_utc!))
  .slice(0, 12);

const CATEGORIES = ["curio", "arbitrage", "prestige-seller", "niche-instrument"] as const;
const CATEGORY_LABELS: Record<typeof CATEGORIES[number], string> = {
  "curio": "Curio", "arbitrage": "Arbitrage",
  "prestige-seller": "Prestige", "niche-instrument": "Niche",
};

function fmtINR(rupees: number | null): string {
  if (rupees == null) return "no reserve";
  if (rupees >= 10_000_000) return `₹${(rupees / 10_000_000).toFixed(2)} cr`;
  if (rupees >= 100_000)    return `₹${(rupees / 100_000).toFixed(2)} L`;
  return `₹${rupees.toLocaleString("en-IN")}`;
}
// A reserve of a few rupees is real, not a data bug: MSTC disposal
// auctions routinely publish nominal "token" reserves and let bidding
// set the price. Call it what it is so nobody reads ₹1 as a placeholder.
const isTokenReserve = (r: number | null) => r != null && r > 0 && r <= 10;
const TOKEN_TIP = "MSTC publishes this reserve as listed. Token reserves "
  + "of a few rupees are standard in government disposal auctions; "
  + "the EMD and competitive bidding set the actual price.";
---
<BaseLayout
  title="auctionhouse.nl06 · A register of government lots"
  description="A register of Indian government surplus and disposal auctions from MSTC, BAANKNET, and IREPS. Searchable, scored, and updated nightly, with email alerts."
  itemNumber="№ AH00"
>
  <article class="ah">
    <Container size="wide" class="ah__inner">
      <!-- HERO ─────────────────────────────────────────────────── -->
      <header class="ah__head">
        <div class="ah__rail">
          <span class="rail__label">Last refresh</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">{syncedISO}</span>
        </div>

        <div class="ah__heading">
          <h1 class="ah__title">
            <span class="ah__title-line">What the State</span>
            <span class="ah__title-emphasis">Is Selling.</span>
          </h1>
        </div>
      </header>

      <!-- SPOTLIGHT ─────────────────────────────────────────────── -->
      {spotlight.length > 0 && (
        <section class="ah__spot" id="spotlight" aria-label="Spotlight">
          <header class="ah__banner reveal">
            <span class="ah__banner__num">✶</span>
            <h2 class="ah__banner__title">Spotlight</h2>
            <span class="ah__banner__rule" aria-hidden="true"></span>
            <span class="ah__banner__count">
              <a class="ah__banner__archive" href="/spotlight-archive">Spotlight archive →</a>
            </span>
          </header>

          <ol class="ah__spot-shelf">
            {spotlight.map((lot, i) => (
              <li class="ah-spot reveal">
                <a class="ah-spot__link" href={`/register#lot-${lot.id}`}
                   data-lot-open={lot.id} data-spot-close={lot.close_at_utc ?? ""}>
                  <span class="ah-spot__index">{String(i + 1).padStart(2, "0")}</span>
                  {lot.photos && lot.photos.length > 0 && (
                    <img class="ah-spot__thumb" src={lot.photos[0]} alt="" loading="lazy" />
                  )}
                  <span class="ah-spot__cat">{lot.category}</span>
                  <h3 class="ah-spot__title">{lot.score_title ?? lot.title}</h3>
                  {lot.note ? (
                    <p class="ah-spot__why">{lot.note}</p>
                  ) : null}
                  <span class="ah-spot__meta">
                    {fmtINR(lot.start_price_inr)}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- REGISTER TEASER ───────────────────────────────────────── -->
      <section class="ah__teaser reveal" aria-label="The register">
        <a class="ah__teaser-link" href="/register">
          <span class="ah__teaser-num">¶</span>
          <span class="ah__teaser-main">
            <span class="ah__teaser-title">Open the full register</span>
            <span class="ah__teaser-sub">
              {lots.length} lots currently surfaced
              {counts.collapsed_seller_category
                ? ` · ${counts.collapsed_seller_category} near-duplicates collapsed` : ""}
               · filters, photos, and search across all {(counts.searchable ?? counts.active).toLocaleString("en-IN")} active lots
            </span>
          </span>
          <span class="ah__teaser-arrow" aria-hidden="true">→</span>
        </a>
        {lots.length === 0 ? (
          <p class="ah__teaser-empty">
            No active lots currently meet the publishing threshold. The pipeline
            tracks {counts.active} active lots and re-scores nightly.
            {lastRunErr ? " The last ingestion attempt failed; showing the prior snapshot." : ""}
          </p>
        ) : null}
      </section>

      <!-- CLOSING SOON RAIL ─────────────────────────────────────── -->
      {closingRail.length > 0 && (
        <section class="ah__closing" aria-label="Closing soon">
          <div class="ah__closing-head">
            <span class="ah__closing-label">Hammer falls</span>
            <span class="ah__closing-sub">closing within {CLOSING_RAIL_HOURS} hours · soonest first</span>
          </div>
          <ul class="ah__closing-rail" data-ah-rail>
            {closingRail.map(lot => (
              <li class="ah-tick">
                <a href={`/register#lot-${lot.id}`} data-lot-open={lot.id}
                   data-close={lot.close_at_utc}>
                  <span class="ah-tick__count">…</span>
                  <span class="ah-tick__title">{lot.title}</span>
                  <span class="ah-tick__price">{fmtINR(lot.start_price_inr)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- ALERTS SIGNUP ─────────────────────────────────────────── -->
      <section class="ah__alerts" id="alerts">
        <header class="ah__banner reveal">
          <span class="ah__banner__num">✉</span>
          <h2 class="ah__banner__title">Alerts</h2>
          <span class="ah__banner__rule" aria-hidden="true"></span>
          <span class="ah__banner__count">at most one email a day</span>
        </header>

        <div class="ah__alerts-grid">
          <div class="ah__alerts-copy">
            <p>
              Get an email when a new lot matches your criteria. The rules are
              strict by design: at most one digest a day (or a Sunday weekly,
              your choice), only for lots listed <em>after</em> you subscribe,
              and never the same lot twice. Confirmation is double opt-in and
              every email carries a one-click unsubscribe.
            </p>
          </div>

          <form class="ah__alerts-form" data-ah-alerts data-worker={ALERTS_WORKER}>
            <div class="af__row">
              <label class="af__label" for="af-email">Email</label>
              <input class="af__input" id="af-email" name="email" type="email"
                     required placeholder="you@example.com" autocomplete="email" />
            </div>

            <div class="af__row">
              <span class="af__label">Categories</span>
              <div class="af__chips">
                {CATEGORIES.map(cat => (
                  <label class="af__chip">
                    <input type="checkbox" name="categories" value={cat} />
                    <span>{CATEGORY_LABELS[cat]}</span>
                  </label>
                ))}
              </div>
              <span class="af__hint">none checked = all categories</span>
            </div>

            <div class="af__row">
              <label class="af__label" for="af-score">Min score</label>
              <select class="af__input af__input--narrow" id="af-score" name="min_score">
                <option value="5" selected>5 (default)</option>
                <option value="4">4 (everything surfaced)</option>
                <option value="6">6</option>
                <option value="7">7 (high bar)</option>
                <option value="8">8</option>
              </select>
              <label class="af__chip af__chip--toggle">
                <input type="checkbox" name="prestige_only" value="1" />
                <span>prestige sellers only</span>
              </label>
            </div>

            <div class="af__row">
              <label class="af__label" for="af-kw">Keywords</label>
              <input class="af__input" id="af-kw" name="keywords" type="text"
                     placeholder="optional · comma-separated, e.g. aircraft, oscilloscope, drone"
                     maxlength="220" />
            </div>

            <div class="af__row">
              <label class="af__label" for="af-price">Max reserve</label>
              <input class="af__input af__input--narrow" id="af-price" name="max_price_inr"
                     type="number" min="1" placeholder="₹, optional" />
              <span class="af__label" style="margin-left:auto">Cadence</span>
              <label class="af__chip af__chip--toggle">
                <input type="radio" name="cadence" value="daily" checked />
                <span>daily</span>
              </label>
              <label class="af__chip af__chip--toggle">
                <input type="radio" name="cadence" value="weekly" />
                <span>weekly (Sundays)</span>
              </label>
            </div>

            <!-- honeypot: humans never see it; bots fill it and get dropped -->
            <input class="af__hp" type="text" name="company" tabindex="-1"
                   autocomplete="off" aria-hidden="true" />

            <div class="af__row af__row--submit">
              <button class="af__submit" type="submit">Subscribe</button>
              <output class="af__status" data-af-status></output>
            </div>
          </form>
        </div>
      </section>

      <!-- METHODOLOGY ─────────────────────────────────────────── -->
      <section class="ah__method" id="methodology">
        <header class="ah__banner reveal">
          <span class="ah__banner__num">§</span>
          <h2 class="ah__banner__title">Methodology</h2>
          <span class="ah__banner__rule" aria-hidden="true"></span>
          <span class="ah__banner__count">Updated nightly</span>
        </header>

        <ol class="ah__method-steps">
          <li class="ah-step reveal">
            <span class="ah-step__num">01</span>
            <div class="ah-step__body">
              <h3 class="ah-step__head">Ingest</h3>
              <p class="ah-step__text">
                A nightly crawl of MSTC (twenty regional offices), BAANKNET
                (IBC liquidation auctions), and IREPS (Indian Railways disposal).
                Each auction is captured once with provenance: URL, snapshot,
                fetched-at timestamp.
              </p>
            </div>
          </li>
          <li class="ah-step reveal">
            <span class="ah-step__num">02</span>
            <div class="ah-step__body">
              <h3 class="ah-step__head">Normalise</h3>
              <p class="ah-step__text">
                Lots are mapped to a single schema: selling agency, category,
                location, reserve price, EMD, start, close. Annexures, the
                per-lot detail PDFs MSTC publishes alongside the catalogue,
                are fetched and excerpted. Embedded photos are pulled out of
                the PDFs and shown on the lot cards.
              </p>
            </div>
          </li>
          <li class="ah-step reveal">
            <span class="ah-step__num">03</span>
            <div class="ah-step__body">
              <h3 class="ah-step__head">Score</h3>
              <p class="ah-step__text">
                Every lot is scored 1&ndash;10 against four categories:
                arbitrage, niche-instrument, prestige-seller, curio. The
                publishing floor is per-category, not uniform. Arbitrage
                needs a clear margin; prestige and curio surface earlier.
                Anything from a prestige seller is included regardless of
                category fit.
              </p>
            </div>
          </li>
          <li class="ah-step reveal">
            <span class="ah-step__num">04</span>
            <div class="ah-step__body">
              <h3 class="ah-step__head">Surface</h3>
              <p class="ah-step__text">
                The register holds the curated cut. Search spans the whole
                active database. The spotlight rotates nightly. Subscribers
                get at most one email a day for new matches, and the feeds
                (RSS and JSON) republish the register for machines.
              </p>
            </div>
          </li>
        </ol>
      </section>

      <!-- SOURCES ─────────────────────────────────────────────── -->
      <section class="ah__sources" id="sources">
        <header class="ah__banner reveal">
          <span class="ah__banner__num">¤</span>
          <h2 class="ah__banner__title">Primary sources</h2>
          <span class="ah__banner__rule" aria-hidden="true"></span>
          <span class="ah__banner__count">As of {synced.getUTCFullYear()}</span>
        </header>

        <dl class="ah__sources-list">
          <div class="ah__source">
            <dt>MSTC Limited</dt>
            <dd>
              <a href="https://www.mstcindia.co.in" rel="noopener">mstcindia.co.in</a>:
              the Government of India&rsquo;s e-auction platform for surplus, disposal,
              scrap, and confiscated goods. Twenty regional offices. Primary ingest target.
            </dd>
          </div>
          <div class="ah__source">
            <dt>BAANKNET</dt>
            <dd>
              <a href="https://www.baanknet.com" rel="noopener">baanknet.com</a>:
              the IBBI-mandated auction platform for liquidation proceedings under
              the Insolvency and Bankruptcy Code. Covers plant, machinery, and
              business assets from companies in resolution.
            </dd>
          </div>
          <div class="ah__source">
            <dt>IREPS</dt>
            <dd>
              Indian Railways e-Procurement System: disposal auctions for
              condemned railway material (sleepers, track fittings, rolling stock
              parts). Scraped as a supplementary source.
            </dd>
          </div>
        </dl>

        <p class="ah__caveat">
          The register tracks what is publicly listed across these platforms. It does not
          predict outcomes, advise on bidding, or represent any seller or buyer. Like the
          rest of <a href="https://nl06.com">nl06</a>, it records what a running system does.
        </p>
      </section>

      <!-- PIPELINE STATUS (footer note) ───────────────────────── -->
      <footer class="ah__pipeline">
        <p class="ah__pipeline-line">
          Pipeline last completed
          <time datetime={meta.synced_at_utc}>{syncedISO}</time>.
          {counts.scored_active}/{counts.active} scored.
          {lastRun ? `Last ingestion: ${lastRun.source} run #${lastRun.started_at_utc?.slice(0,10)}` : ""}
          {lastRunErr ? <span class="ah__pipeline-fail"> (failed)</span> : null}
          &nbsp;·&nbsp;
          <a href="/register">register</a> ·
          <a href="/feeds/register.xml">RSS</a> ·
          <a href="/feeds/spotlight.xml">spotlight RSS</a> ·
          <a href="/feeds/register.json">JSON</a>
        </p>
      </footer>

      <p class="ornament" aria-hidden="true"></p>
    </Container>
  </article>

  <LotModal />

  <script>
    // ── hammer-falls countdowns: live tick + hide anything that closes ────
    function tick() {
      const now = Date.now();
      document.querySelectorAll<HTMLElement>("[data-ah-rail] [data-close]").forEach(a => {
        const ms = Date.parse(a.dataset.close!) - now;
        const li = a.closest("li");
        if (ms <= 0) { if (li) li.hidden = true; return; }
        const el = a.querySelector<HTMLElement>(".ah-tick__count");
        if (!el) return;
        const h = Math.floor(ms / 3.6e6), m = Math.floor((ms % 3.6e6) / 6e4);
        el.textContent = h > 0 ? `${h}h ${m}m` : `${m}m`;
        el.classList.toggle("is-urgent", ms < 6 * 3.6e6);
      });
      // if every chip closed while the page was open, drop the whole rail
      const rail = document.querySelector<HTMLElement>("[data-ah-rail]");
      if (rail && ![...rail.children].some(li => !(li as HTMLElement).hidden)) {
        rail.closest("section")?.setAttribute("hidden", "");
      }
      // spotlight never shows a closed lot: hide a card the moment its
      // hammer falls (the nightly rebuild won't re-pick it)
      document.querySelectorAll<HTMLElement>("[data-spot-close]").forEach(a => {
        const iso = a.dataset.spotClose;
        if (iso && Date.parse(iso) <= now) {
          const li = a.closest("li");
          if (li) li.hidden = true;
        }
      });
    }
    tick();
    setInterval(tick, 30_000);
  </script>

  <script>
    // ── alerts signup ──────────────────────────────────────────────────────
    const form = document.querySelector<HTMLFormElement>("[data-ah-alerts]");
    if (form) {
      const statusOut = form.querySelector<HTMLElement>("[data-af-status]")!;
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const keywords = String(fd.get("keywords") || "")
          .split(",").map(s => s.trim()).filter(Boolean).slice(0, 5);
        const body = {
          email: String(fd.get("email") || "").trim(),
          cadence: String(fd.get("cadence") || "daily"),
          hp: String(fd.get("company") || ""),
          filters: {
            min_score: Number(fd.get("min_score") || 5),
            categories: fd.getAll("categories").map(String),
            prestige_only: fd.get("prestige_only") === "1",
            keywords,
            max_price_inr: Number(fd.get("max_price_inr")) || null,
          },
        };
        statusOut.textContent = "sending…";
        statusOut.className = "af__status";
        try {
          const r = await fetch(form.dataset.worker + "/subscribe", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(body),
          });
          const j = await r.json();
          if (r.ok) {
            statusOut.textContent =
              "Check your inbox. The confirmation link expires in 24 hours.";
            statusOut.classList.add("af__status--ok");
            form.reset();
          } else {
            statusOut.textContent = j.error || "something went wrong; try again";
            statusOut.classList.add("af__status--err");
          }
        } catch {
          statusOut.textContent = "network error; try again";
          statusOut.classList.add("af__status--err");
        }
      });
    }
  </script>

  <script>
    // Stagger sections in as they enter the viewport. Arming is JS-gated,
    // so with JS disabled every .reveal element renders visible.
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const targets = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
    if (targets.length && !reduced && "IntersectionObserver" in window) {
      document.documentElement.classList.add("js-reveal");
      const io = new IntersectionObserver(
        (records, obs) => {
          records.forEach((rec) => {
            if (rec.isIntersecting) {
              rec.target.classList.add("is-in");
              obs.unobserve(rec.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.12 }
      );
      targets.forEach((el) => io.observe(el));
    }
  </script>
</BaseLayout>

<style>
  .ah { padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .ah :global(.ah__inner) {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
  }

  /* HEAD ────────────────────────────────────────────────────── */
  .ah__head {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
  }
  .ah__rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }
  .rail__label, .rail__date {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .rail__label { color: var(--color-ink); font-weight: 600; }
  .rail__date  { color: var(--color-accent); }
  .rail__rule  { height: 1px; background: var(--color-rule); }
  .rail__feeds {
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .rail__feeds a { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--color-rule-strong); }
  .rail__feeds a:hover { color: var(--color-accent); }

  .ah__title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-jumbo);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .ah__title-line { display: block; }
  .ah__title-emphasis {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }
  /* SECTION SPINE ───────────────────────────────────────────── */
  .ah__spot, .ah__closing, .ah__teaser, .ah__alerts, .ah__method, .ah__sources {
    grid-column: 1 / -1;
  }
  .ah__spot { margin-top: var(--space-8); }
  .ah__alerts, .ah__method, .ah__sources { margin-top: var(--space-16); }
  .ah__closing, .ah__teaser { margin-top: var(--space-8); }

  .ah__banner {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 3px solid var(--color-ink);
    position: relative;
  }
  .ah__banner::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    border-bottom: 1px solid var(--color-ink);
  }
  .ah__banner__num {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-h1);
    color: var(--color-accent);
    line-height: 0.9;
  }
  .ah__banner__title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h1);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .ah__banner__rule { height: 1px; background: var(--color-rule); align-self: center; }
  .ah__banner__count {
