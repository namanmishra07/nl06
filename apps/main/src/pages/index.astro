---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";

interface Sub {
  numeral: string;
  label: string;
  href: string;
  kicker: string;
  blurb: string;
}

const subdomains: Sub[] = [
  {
    numeral: "I",
    label:   "gs.",
    href:    "https://gs.nl06.com",
    kicker:  "The instrument",
    blurb:   "A one-metre offset dish on a Lucknow rooftop, pointed at GK-2A. Decodes a full-disk Earth every hour. Logs go straight into the index.",
  },
  {
    numeral: "II",
    label:   "chains.",
    href:    "https://chains.nl06.com",
    kicker:  "The reasoning",
    blurb:   "Macro shifts traced four levels down. Live, killed, and the few I'm still resolving. The killed ones are the more useful read.",
  },
  {
    numeral: "III",
    label:   "reading.",
    href:    "https://reading.nl06.com",
    kicker:  "The intake",
    blurb:   "A note every time something I read shifts how I think. One per source. RSS, no archive of half-thoughts.",
  },
  {
    numeral: "IV",
    label:   "auctionhouse.",
    href:    "https://auctionhouse.nl06.com",
    kicker:  "The register",
    blurb:   "What the Government of India is selling on MSTC, normalised into a single daily register. Backend in development.",
  },
];

const plate = {
  number: "I",
  title:  "GK-2A · IR 105 channel",
  body:   "Full-disk Earth, captured from Lucknow at 13:20 UTC on 18 May 2026.",
};
---
<BaseLayout
  title="NL06 — A Field Notebook"
  description="An index of running instruments and the notes that go with them. Built from one room in Lucknow."
  itemNumber="№ 001"
>
  <!-- HERO ──────────────────────────────────────────────────── -->
  <section class="hero">
    <Container size="wide" class="hero__inner">
      <div class="hero__lede">
        <span class="hero__eyebrow">
          The brief
          <span class="hero__eyebrow-sep" aria-hidden="true">·</span>
          Vol. I, 2026
        </span>
        <h1 class="hero__head">
          <span class="hero__head-line">An index of</span>
          <span class="hero__head-emphasis">things that work.</span>
        </h1>
        <p class="hero__sub">
          Each subdomain below is a tool that runs &mdash; built and observed from
          one room in Lucknow, written up as it goes. The work is the artefact;
          this is where the artefact is kept.
        </p>
      </div>

      <figure class="hero__plate">
        <a
          class="hero__plate-link"
          href="https://gs.nl06.com"
          aria-label="See the ground station at gs.nl06.com"
        >
          <picture>
            <source srcset="/hero/gk2a-20260518-1320-sanchez.webp" type="image/webp" />
            <img
              src="/hero/gk2a-20260518-1320-sanchez.png"
              alt="GK-2A full-disk Earth, IR105 channel, captured from Lucknow at 13:20 UTC on 18 May 2026."
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </a>
        <figcaption class="hero__cap">
          <span class="hero__cap-eyebrow">Plate {plate.number}  ·  {plate.title}</span>
          <span class="hero__cap-body">{plate.body}</span>
        </figcaption>
      </figure>
    </Container>
  </section>

  <!-- TABLE OF CONTENTS ──────────────────────────────────────── -->
  <section class="contents">
    <Container size="wide" class="contents__inner">
      <ol class="contents__list">
        {subdomains.map((s, i) => (
          <li class="entry">
            <a class="entry__link" href={s.href}>
              <span class="entry__kicker">{s.kicker}</span>
              <span class="entry__folio" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="entry__num" aria-hidden="true">{s.numeral}</span>
              <div class="entry__body">
                <span class="entry__title">
                  {s.label}
                  <span class="entry__arrow" aria-hidden="true">↗</span>
                </span>
                <p class="entry__blurb">{s.blurb}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </Container>
  </section>

</BaseLayout>

<style>
  /* HERO ─────────────────────────────────────────────────────────── */
  /* Full-bleed black plate: extends past the body's page gutter to
     viewport edges so the Earth's black space dissolves into the strip
     and the photograph appears merged with the page. */
  .hero {
    margin-inline: calc(-1 * var(--space-page));
    padding-inline: var(--space-page);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    background: #000;
    color: var(--color-paper);
  }
  .hero :global(.hero__inner) {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  .hero__lede {
    max-width: 32rem;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-faint);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 22%, transparent);
    margin-bottom: var(--space-6);
  }
  .hero__eyebrow-sep { color: var(--color-ink-muted); }
  .hero__head {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-jumbo);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-paper);
    font-feature-settings: var(--features-display);
  }
  .hero__head-line { display: block; }
  .hero__head-emphasis {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent-soft);
  }
  .hero__sub {
    margin-top: var(--space-6);
    font-family: var(--font-serif);
    font-size: var(--type-h4);
    font-weight: 400;
    line-height: var(--leading-snug);
    color: var(--color-paper);
  }

  .hero__plate { margin: 0; }
  .hero__plate-link {
    display: block;
    text-decoration: none;
    transition: opacity 200ms ease;
  }
  .hero__plate-link:hover { opacity: 0.88; }
  .hero__plate img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 60vh;
    object-fit: contain;
    /* No border — image edges dissolve into the black strip. */
  }
  .hero__cap {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: minmax(0, max-content) 1fr;
    gap: var(--space-3) var(--space-4);
    align-items: baseline;
    padding-top: var(--space-2);
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 38%, transparent);
  }
  .hero__cap-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-paper);
    font-feature-settings: var(--features-tabular);
    font-weight: 600;
  }
  .hero__cap-body {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-small);
    color: var(--color-ink-faint);
    line-height: var(--leading-normal);
  }

  /* CONTENTS ────────────────────────────────────────────────────── */
  .contents {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }
  .contents__list {
    margin-top: var(--space-8);
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }
  .entry {
    margin: 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .entry + .entry { margin-top: 0; }
  .entry__link {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: var(--space-8);
    row-gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-8) 0;
    text-decoration: none;
    color: var(--color-ink);
    transition: color 100ms ease;
  }
  .entry__kicker {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .entry__folio {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }
  .entry__num {
    grid-column: 1;
    grid-row: 2;
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-display);
    line-height: 0.85;
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-accent);
    font-feature-settings: var(--features-display);
  }
  .entry__body {
    grid-column: 2 / -1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .entry__title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h1);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
  }
  .entry__arrow {
    font-size: 0.5em;
    color: var(--color-ink-faint);
    transition: color 100ms ease, transform 200ms cubic-bezier(0.2, 0.7, 0.4, 1);
    transform: translate(0, 0);
  }
  .entry__blurb {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink-soft);
    max-width: 38rem;
  }
  .entry__folio {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-faint);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    /* grid placement already declared above; this rule carries typography */
  }
  .entry__link:hover .entry__title { color: var(--color-accent); }
  .entry__link:hover .entry__arrow { color: var(--color-accent); transform: translate(0.1em, -0.1em); }

  /* responsive ────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero :global(.hero__inner) {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .hero__lede { max-width: none; }
  }
  @media (max-width: 760px) {
    .hero__head { font-size: var(--type-display); }
    .hero__sub  { font-size: var(--type-small); }

    .entry__link {
      grid-template-columns: 4rem minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: var(--space-4);
      row-gap: var(--space-3);
      padding: var(--space-6) 0;
    }
    .entry__kicker { grid-column: 1 / -1; grid-row: 1; }
    .entry__num    { grid-column: 1;     grid-row: 2; font-size: var(--type-h1); }
    .entry__body   { grid-column: 2;     grid-row: 2; }
    .entry__title  { font-size: var(--type-h2); }
    .entry__folio  { display: none; }
  }
</style>
