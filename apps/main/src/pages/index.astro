---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";

interface Sub {
  label: string;
  href: string;
  blurb: string;
}

const subdomains: Sub[] = [
  {
    label: "gs.",
    href:  "https://gs.nl06.com",
    blurb: "A 60-centimetre dish on a Lucknow rooftop, pointed at GK-2A. Decodes a full-disk Earth every hour.",
  },
  {
    label: "chains.",
    href:  "https://chains.nl06.com",
    blurb: "Macro shifts traced four levels down. Live, killed, and the few I'm still resolving.",
  },
  {
    label: "reading.",
    href:  "https://reading.nl06.com",
    blurb: "A note every time something I read shifts how I think. One per source.",
  },
];
---
<BaseLayout
  title="nl06"
  description="An index of running instruments and the notes that go with them."
>
  <section class="hero">
    <figure class="hero__figure">
      <img
        src="/hero/gk2a-20260518-1320-sanchez.png"
        alt="GK-2A full-disk Earth, IR105 channel, captured from Lucknow at 13:20 UTC on 18 May 2026."
      />
    </figure>
    <Container size="container" class="hero__cap">
      <p class="plate">Plate I &nbsp;·&nbsp; GK-2A, IR105 channel &nbsp;·&nbsp; 18 May 2026, 13:20 UTC &nbsp;·&nbsp; captured from Lucknow.</p>
    </Container>
  </section>

  <Container size="prose" class="lede-section">
    <h1>An index of things that work.</h1>
    <p class="lede">Each subdomain below is a tool that runs — built and observed from one room in Lucknow, written up here as it goes.</p>
  </Container>

  <Container size="container" class="subs">
    <h2 class="subs__heading">Subdomains <span class="subs__sep" aria-hidden="true">/</span> Each an instrument</h2>
    <ul class="subs__list">
      {subdomains.map((s) => (
        <li class="subs__item">
          <a href={s.href} class="subs__link">{s.label}</a>
          <span class="subs__blurb">{s.blurb}</span>
        </li>
      ))}
    </ul>
  </Container>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }
  .hero__figure {
    margin: 0;
    display: flex;
    justify-content: center;
  }
  .hero__figure img {
    max-height: 78vh;
    width: auto;
    height: auto;
    display: block;
  }
  .hero :global(.hero__cap) {
    margin-top: var(--space-4);
    text-align: center;
  }
  .plate {
    font-family: var(--font-sans);
    font-size: var(--type-meta);
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--color-ink-muted);
  }

  .lede-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    text-align: center;
  }
  .lede-section > h1 {
    font-size: var(--type-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
  .lede-section > h1 + .lede {
    margin-top: var(--space-5);
    font-size: var(--type-h3);
    color: var(--color-ink-soft);
    line-height: var(--leading-snug);
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
  }

  .subs {
    padding-bottom: var(--space-16);
  }
  .subs__heading {
    font-family: var(--font-sans);
    font-size: var(--type-meta);
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--color-ink-muted);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }
  .subs__sep {
    margin: 0 var(--space-2);
    color: var(--color-rule);
  }
  .subs__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-rule);
  }
  .subs__item {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-6);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-rule);
    align-items: baseline;
  }
  .subs__item + .subs__item { margin-top: 0; }
  .subs__link {
    font-family: var(--font-serif);
    font-weight: 600;
    text-decoration: none;
    font-size: var(--type-h4);
    color: var(--color-ink);
  }
  .subs__link:hover { color: var(--color-accent); }
  .subs__blurb {
    color: var(--color-ink-soft);
    line-height: var(--leading-normal);
  }
  @media (max-width: 600px) {
    .subs__item { grid-template-columns: 1fr; gap: var(--space-1); padding: var(--space-4) 0; }
  }
</style>
