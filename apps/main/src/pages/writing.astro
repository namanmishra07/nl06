---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";

interface Essay { title: string; date: string; href: string; blurb: string; }
const essays: Essay[] = [];
---
<BaseLayout
  title="Writing — NL06"
  description="Notes and longer-form pieces."
  pathname="/writing"
  itemNumber="№ 004"
>
  <article class="writing">
    <Container size="wide" class="writing__inner">
      <header class="writing__head">
        <div class="writing__rail">
          <span class="rail__label">Register</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">Of essays</span>
        </div>
        <h1 class="writing__title">
          <span class="writing__title-line">Writing</span>
          <span class="writing__title-sub">— A standing register of essays.</span>
        </h1>
        <p class="writing__epigraph">
          Short notes live at <a href="https://reading.nl06.com">reading.nl06.com</a> &mdash;
          one entry per book, paper, or post that shifted something. Longer essays land
          here, but the bar is high and the register is intentionally short.
        </p>
      </header>

      <section class="writing__list-section">
        <header class="list-head">
          <span class="list-head__label">Essays</span>
          <span class="list-head__rule" aria-hidden="true"></span>
          <span class="list-head__count">
            {essays.length === 0 ? "In preparation" : `${essays.length} on file`}
          </span>
        </header>

        {essays.length === 0 ? (
          <div class="empty">
            <p class="empty__notice">In preparation.</p>
            <p class="empty__body">
              <em>
                No essays in the register yet. The bar for posting here is higher
                than for <a href="https://reading.nl06.com">reading.</a> &mdash;
                under-baked writing on a personal site is worse than no writing.
              </em>
            </p>
            <p class="empty__sign">
              <span class="empty__sign-rule" aria-hidden="true"></span>
              <span class="empty__sign-text">The next entry will land here.</span>
              <span class="empty__sign-rule" aria-hidden="true"></span>
            </p>
          </div>
        ) : (
          <ol class="essays">
            {essays.map((e, i) => (
              <li class="essay">
                <a class="essay__link" href={e.href}>
                  <span class="essay__num">{String(i + 1).padStart(2, "0")}</span>
                  <div class="essay__body">
                    <span class="essay__title">{e.title}</span>
                    <span class="essay__date">{e.date}</span>
                    <p class="essay__blurb">{e.blurb}</p>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        )}
      </section>

    </Container>
  </article>
</BaseLayout>

<style>
  .writing { padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .writing :global(.writing__inner) {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
  }

  .writing__head {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr) minmax(14rem, 18rem);
    gap: var(--space-8);
    align-items: end;
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-rule);
  }
  .writing__rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }
  .rail__label {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink);
    font-feature-settings: var(--features-tabular);
    font-weight: 600;
  }
  .rail__rule { height: 1px; background: var(--color-rule); }
  .rail__date {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .writing__title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-jumbo);
    line-height: 0.95;
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .writing__title-sub {
    display: block;
    font-style: italic;
    font-weight: 500;
    font-size: var(--type-h3);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
    margin-top: var(--space-3);
    letter-spacing: var(--tracking-tight);
  }
  .writing__epigraph {
    margin-top: 0;
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-rule);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-small);
    color: var(--color-ink-soft);
    line-height: var(--leading-normal);
  }

  .writing__list-section {
    grid-column: 2 / -1;
    padding-top: var(--space-10);
    max-width: 42rem;
  }
  .list-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    padding-bottom: var(--space-3);
    border-bottom: 3px solid var(--color-ink);
    position: relative;
  }
  .list-head::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    border-bottom: 1px solid var(--color-ink);
  }
  .list-head__label { color: var(--color-ink); font-weight: 600; }
  .list-head__rule { flex: 1; height: 1px; background: var(--color-rule); }

  .empty {
    margin-top: var(--space-10);
    padding: var(--space-10) var(--space-8);
    border: 1px solid var(--color-rule);
    text-align: center;
    background: var(--color-paper-margin);
  }
  .empty__notice {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    font-feature-settings: var(--features-tabular);
    font-weight: 600;
  }
  .empty__body {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--type-h4);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
    max-width: 28rem;
    margin-left: auto;
    margin-right: auto;
  }
  .empty__sign {
    margin-top: var(--space-8);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .empty__sign-rule {
    display: inline-block;
    width: 3rem;
    height: 1px;
    background: var(--color-rule-strong);
  }

  /* essay list (used when essays exist) */
  .essays {
    margin-top: var(--space-8);
    list-style: none;
    padding: 0;
  }
  .essay { border-bottom: 1px solid var(--color-rule); }
  .essay__link {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    text-decoration: none;
    color: var(--color-ink);
  }
  .essay__num {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-h1);
    color: var(--color-accent);
    line-height: 0.85;
    font-feature-settings: var(--features-tabular);
  }
  .essay__title {
    display: block;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h2);
    line-height: var(--leading-snug);
  }
  .essay__date {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .essay__blurb {
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    color: var(--color-ink-soft);
    line-height: var(--leading-prose);
  }
  .essay__link:hover .essay__title { color: var(--color-accent); }

  /* responsive ────────────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .writing__head {
      grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
      align-items: start;
    }
    .writing__epigraph {
      grid-column: 2 / -1;
      margin-top: var(--space-4);
      padding-left: 0;
      border-left: 0;
      max-width: 36rem;
    }
  }
  @media (max-width: 760px) {
    .writing :global(.writing__inner),
    .writing__head { grid-template-columns: 1fr; }
    .writing__rail { flex-direction: row; align-items: center; gap: var(--space-3); }
    .writing__rail .rail__rule { flex: 1; }
    .writing__title { font-size: var(--type-display); }
    .writing__list-section { grid-column: 1 / -1; }
    .writing__epigraph { grid-column: 1 / -1; }
  }
</style>
