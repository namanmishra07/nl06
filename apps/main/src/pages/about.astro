---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import Prose      from "@nl06/design-system/components/Prose.astro";
---
<BaseLayout
  title="About — nl06"
  description="About Naman."
  pathname="/about"
>
  <Container size="prose" class="about">
    <h1>About</h1>

    <Prose>
      <p>I build instruments and write about what they reveal.</p>

      <p>Currently based in Mumbai, with a rooftop ground station running 1,400&nbsp;km north in Lucknow. Before that: a few years of building hardware-software things — some of which shipped, some of which I walked away from when the next round didn't make sense.</p>

      <p>What's loaded into the next few months is at <a href="/now">/now</a>. What I'm reading is at <a href="https://reading.nl06.com">reading.</a> The way I think about macro shifts is at <a href="https://chains.nl06.com">chains.</a></p>

      <p>For the rest: <a href="https://www.linkedin.com/in/namanmishra07" rel="noopener">LinkedIn</a>.</p>
    </Prose>
  </Container>
</BaseLayout>

<style>
  .about { padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .about > :global(.prose-flow) { margin-top: var(--space-8); }
  .about > :global(.prose-flow) > p:first-child {
    font-size: var(--type-h3);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    font-style: italic;
  }
</style>
