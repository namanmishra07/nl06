---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import Prose      from "@nl06/design-system/components/Prose.astro";

const swatches: { name: string; var: string }[] = [
  { name: "paper",        var: "--color-paper" },
  { name: "paper-dim",    var: "--color-paper-dim" },
  { name: "ink",          var: "--color-ink" },
  { name: "ink-soft",     var: "--color-ink-soft" },
  { name: "ink-muted",    var: "--color-ink-muted" },
  { name: "rule",         var: "--color-rule" },
  { name: "accent",       var: "--color-accent" },
  { name: "accent-hover", var: "--color-accent-hover" },
];

const typeScale: { name: string; var: string; sample: string }[] = [
  { name: "display", var: "--type-display", sample: "Observatory" },
  { name: "h1",      var: "--type-h1",      sample: "On building things that already work" },
  { name: "h2",      var: "--type-h2",      sample: "A subsection heading sits here" },
  { name: "h3",      var: "--type-h3",      sample: "An h3, used inside a section" },
  { name: "h4",      var: "--type-h4",      sample: "An h4, often a label" },
  { name: "body",    var: "--type-body",    sample: "Body type. Source Serif 4 at 17px, line-height 1.65." },
  { name: "small",   var: "--type-small",   sample: "Small text — used for footnotes and captions." },
  { name: "meta",    var: "--type-meta",    sample: "Meta text — Inter, uppercase, 13px." },
];
---
<BaseLayout
  title="Styleguide — nl06"
  description="Design system primitives."
>
  <Container size="container" class="sg">
    <p class="meta">Design system / v0.0.1</p>
    <h1>Styleguide</h1>
    <p class="lede">Every primitive on one page. If a page in this site uses a typographic element, it appears here first.</p>

    <hr />

    <!-- ─── Color ──────────────────────────────────────────── -->
    <h2 id="color">Color</h2>
    <p>One restrained accent. Everything else lives on the ink-paper spectrum.</p>
    <div class="swatches">
      {swatches.map((s) => (
        <div class="swatch">
          <div class="swatch__chip" style={`background: var(${s.var});`} />
          <div class="swatch__meta">
            <span class="swatch__name">{s.name}</span>
            <code>{s.var}</code>
          </div>
        </div>
      ))}
    </div>

    <hr />

    <!-- ─── Type ──────────────────────────────────────────── -->
    <h2 id="type">Typography</h2>
    <p>Serif (Source Serif 4) does the work. Sans (Inter) only for UI chrome — nav, metadata, captions, table headers.</p>
    <table class="type-scale">
      <thead>
        <tr><th>Name</th><th>Token</th><th>Sample</th></tr>
      </thead>
      <tbody>
        {typeScale.map((t) => (
          <tr>
            <td><code>{t.name}</code></td>
            <td><code>{t.var}</code></td>
            <td style={`font-size: var(${t.var});`}>{t.sample}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <hr />

    <!-- ─── Prose ──────────────────────────────────────────── -->
    <h2 id="prose">Prose</h2>
    <Prose>
      <h3>Section heading inside prose</h3>
      <p>This is a body paragraph. It sits inside a <code>&lt;Prose&gt;</code> wrapper that handles vertical rhythm. <a href="#prose">An inline link</a> picks up the accent color. <em>Italics</em> are Source Serif 4 italic; <strong>bold</strong> uses the 600 weight.</p>

      <p>A second paragraph to demonstrate spacing. Short prose is encouraged. If a sentence runs to two clauses joined by a comma — like this one — that is fine, but three is suspect.</p>

      <h4>An h4 inside prose</h4>
      <p>Headings inside prose get more space above than between paragraphs.</p>

      <blockquote>
        <p>A blockquote with a single sentence draws attention without shouting. The accent appears as a left rule.</p>
      </blockquote>

      <p>An unordered list:</p>
      <ul>
        <li>First item — short, direct.</li>
        <li>Second item, possibly with <a href="#prose">a link</a>.</li>
        <li>Third item, no trailing punctuation difference.</li>
      </ul>

      <p>An ordered list:</p>
      <ol>
        <li>Numbered when sequence matters.</li>
        <li>Otherwise bullets.</li>
      </ol>

      <p>Inline code: <code>const accent = "#1B3A5C"</code>.</p>

      <pre><code>{`// Code block — monospaced, on paper-dim
function build(spec) {
  return spec.steps.map(run);
}`}</code></pre>

      <p>A horizontal rule separates sections without a heading:</p>
      <hr />
      <p>Like that.</p>
    </Prose>

    <hr />

    <!-- ─── Metadata ──────────────────────────────────────── -->
    <h2 id="metadata">Metadata</h2>
    <p>Used for dates, source types, section labels.</p>
    <p class="meta">2026 / 05 / 21 · Paper</p>
    <p class="meta">Reading note · Source: paper</p>

    <hr />

    <!-- ─── Images ────────────────────────────────────────── -->
    <h2 id="images">Images</h2>
    <p>Treat images as primary content. No frames, no shadows, no rounded corners. Captions in <code>.meta</code>.</p>
    <figure>
      <img
        src="https://placehold.co/1280x720/14181F/FAF8F3?text=GK-2A+placeholder"
        alt="GK-2A capture placeholder"
        width="1280"
        height="720"
      />
      <figcaption class="meta">GK-2A · 2026-05-18 · Lucknow</figcaption>
    </figure>

    <hr />

    <!-- ─── Tables ────────────────────────────────────────── -->
    <h2 id="tables">Tables</h2>
    <p>Tabular figures by default. Headers in Inter caps.</p>
    <table>
      <thead>
        <tr>
          <th>Subdomain</th>
          <th>Status</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>gs.nl06.com</td>     <td>placeholder</td> <td>2026-05-21</td></tr>
        <tr><td>chains.nl06.com</td> <td>scaffolded</td>  <td>2026-05-21</td></tr>
        <tr><td>reading.nl06.com</td><td>scaffolded</td>  <td>2026-05-21</td></tr>
      </tbody>
    </table>
  </Container>
</BaseLayout>

<style>
  .sg {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }
  .sg > * + * { margin-top: var(--space-6); }
  .sg > h2 { margin-top: var(--space-12); }
  .sg > h2 + p { margin-top: var(--space-3); }
  .sg .lede {
    font-size: var(--type-h4);
    color: var(--color-ink-soft);
    line-height: var(--leading-snug);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-4);
  }
  .swatch {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .swatch__chip {
    height: 80px;
    border: 1px solid var(--color-rule);
  }
  .swatch__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .swatch__name {
    font-family: var(--font-sans);
    font-size: var(--type-meta);
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--color-ink-muted);
  }

  .type-scale td { vertical-align: baseline; }
  .type-scale td:first-child,
  .type-scale td:nth-child(2) {
    width: 1%;
    white-space: nowrap;
  }

  figure { margin: 0; }
  figcaption { margin-top: var(--space-2); }
</style>
