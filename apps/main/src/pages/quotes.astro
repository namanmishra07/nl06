---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import history    from "@nl06/design-system/data/quote_history.json";

interface HistoryEntry {
  date_ist: string;
  date_display: string;
  quote: string;
  author: string;
  author_key: string;
  author_url: string;
  ts_utc: string;
}

const entries = (history.entries ?? []) as HistoryEntry[];

// ── Date helpers ────────────────────────────────────────────────
const monthNames = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

function toRoman(n: number): string {
  const map: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
    [100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
    [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
  ];
  let x = n;
  let out = "";
  for (const [v, sym] of map) { while (x >= v) { out += sym; x -= v; } }
  return out;
}

// ── Build the calendar atlas ────────────────────────────────────
// Index entries by ISO date for O(1) lookup per cell.
const entriesByDate = new Map(entries.map((e) => [e.date_ist, e]));

// Render months from the earliest entry's month through the latest's.
// (When the agent runs forward indefinitely, more months appear naturally.)
const allDates = entries.map((e) => e.date_ist).sort();
const [eY, eM] = (allDates[0] ?? "2026-04-01").split("-").map(Number);
const [lY, lM] = (allDates[allDates.length - 1] ?? "2026-05-01").split("-").map(Number);

interface CalCell {
  empty: boolean;
  blank: boolean;  // in-month day with no entry
  day?: number;
  entry?: HistoryEntry;
}

interface Month {
  year: number;
  month: number;
  label: string;
  yearRoman: string;
  count: number;
  cells: CalCell[];
}

function buildMonth(year: number, month: number): Month {
  const firstOfMonth = new Date(Date.UTC(year, month - 1, 1));
  // JS getUTCDay: 0=Sun..6=Sat. Convert to Mon-start: 0=Mon..6=Sun.
  const firstDow = (firstOfMonth.getUTCDay() + 6) % 7;
  const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
  const cells: CalCell[] = [];

  for (let i = 0; i < firstDow; i++) cells.push({ empty: true, blank: false });

  let count = 0;
  for (let d = 1; d <= daysInMonth; d++) {
    const key = `${year}-${String(month).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    const entry = entriesByDate.get(key);
    if (entry) count++;
    cells.push({
      empty: false,
      blank: !entry,
      day: d,
      entry: entry ?? undefined,
    });
  }
  // Pad trailing so we always have full 7-cell rows.
  while (cells.length % 7 !== 0) cells.push({ empty: true, blank: false });

  return {
    year,
    month,
    label: monthNames[month - 1],
    yearRoman: toRoman(year),
    count,
    cells,
  };
}

const months: Month[] = [];
{
  let y = eY;
  let m = eM;
  while (y < lY || (y === lY && m <= lM)) {
    months.push(buildMonth(y, m));
    m++;
    if (m > 12) { m = 1; y++; }
  }
}

// Newest entry is the default for the reading panel.
const total = entries.length;
const defaultEntry = entries[0] ?? null;

// Author census, in canonical order.
const census = (["claude", "openai", "gemini"] as const).map((key) => ({
  key,
  label: entries.find((e) => e.author_key === key)?.author
       ?? key[0].toUpperCase() + key.slice(1),
  n: entries.filter((e) => e.author_key === key).length,
}));

// Day-of-week column headers (Mon-start).
const DOW = ["M", "T", "W", "T", "F", "S", "S"];
---
<BaseLayout
  title="Marginalia — NL06"
  description="A daily atlas of one-line aphorisms composed for the nl06.com footer by Claude, ChatGPT, and Gemini. Click a day to read its line."
  pathname="/quotes"
  itemNumber="№ 006"
>
  <article class="atlas-sheet">
    <Container size="wide" class="atlas-sheet__inner">

      <!-- ─────────────────────────── MASTHEAD ─────────────────────── -->
      <header class="masthead">
        <div class="masthead__rail">
          <span class="rail__label">Marginalia</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__edition">A Daily Atlas · Vol. I</span>
        </div>

        <h1 class="masthead__title">Marginalia.</h1>

        <p class="masthead__lede">
          A daily atlas of aphorisms &mdash; composed, in turn, by Claude,
          ChatGPT, and Gemini. <span class="masthead__instruction">Tap a
          filled day to read its line.</span>
        </p>

        <ul class="census" aria-label="Edition census">
          <li class="census__cell">
            <span class="census__num">{total}</span>
            <span class="census__label">pieces</span>
          </li>
          {census.map((c) => (
            <li class="census__cell census__cell--author">
              <span class={`census__dot census__dot--${c.key}`} aria-hidden="true"></span>
              <span class="census__name">{c.label}</span>
              <span class="census__count">{c.n}</span>
            </li>
          ))}
          <li class="census__cell census__cell--time">
            <span class="census__pressed">Pressed daily, 03:30 IST</span>
          </li>
        </ul>
      </header>

      {defaultEntry === null ? (
        <p class="atlas-sheet__empty">
          The atlas is empty. Tomorrow&rsquo;s line will be the first.
        </p>
      ) : (
        <>
          <!-- ───────────────────── READING PANEL ─────────────────── -->
          <section class="reading" id="reading" aria-live="polite" aria-atomic="true">
            {entries.map((e, i) => (
              <article
                class:list={["leaf", `leaf--${e.author_key}`, i === 0 && "is-active"]}
                data-q={e.date_ist}
                id={`q-${e.date_ist}`}
              >
                <blockquote class="leaf__text">
                  <span class="leaf__mark" aria-hidden="true">&ldquo;</span>{e.quote}
                </blockquote>
                <footer class="leaf__meta">
                  <span class={`leaf__dot leaf__dot--${e.author_key}`} aria-hidden="true"></span>
                  <a class="leaf__author" href={e.author_url} rel="noopener">{e.author}</a>
                  <span class="leaf__sep" aria-hidden="true">·</span>
                  <span class="leaf__date">{e.date_display}</span>
                  <span class="leaf__sep" aria-hidden="true">·</span>
                  <span class="leaf__num">№ {String(entries.length - i).padStart(3, "0")}</span>
                </footer>
              </article>
            ))}
          </section>

          <!-- ───────────────────── ATLAS GRID ───────────────────── -->
          <section class="atlas" aria-label="Calendar atlas">
            {months.map((mo) => (
              <article class="month">
                <header class="month__head">
                  <h2 class="month__name">{mo.label}</h2>
                  <span class="month__year" aria-hidden="true">{mo.yearRoman}</span>
                  <span class="month__rule" aria-hidden="true"></span>
                  <span class="month__count">{mo.count} {mo.count === 1 ? "piece" : "pieces"}</span>
                </header>
                <div class="cal" role="grid" aria-label={`${mo.label} ${mo.year}`}>
                  {DOW.map((d, i) => (
                    <span class="cal__dow" role="columnheader" aria-label={["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"][i]}>{d}</span>
                  ))}
                  {mo.cells.map((c) => (
                    c.empty ? (
                      <span class="cal__cell cal__cell--empty" role="gridcell" aria-hidden="true"></span>
                    ) : c.entry ? (
                      <a
                        class:list={["cal__cell", "cal__cell--filled", `cal__cell--${c.entry.author_key}`]}
                        href={`#q-${c.entry.date_ist}`}
                        data-q={c.entry.date_ist}
                        role="gridcell"
                        aria-label={`Quote by ${c.entry.author} on ${c.entry.date_display}`}
                      >
                        <span class="cal__day">{c.day}</span>
                      </a>
                    ) : (
                      <span class="cal__cell cal__cell--blank" role="gridcell">
                        <span class="cal__day">{c.day}</span>
                      </span>
                    )
                  ))}
                </div>
              </article>
            ))}
          </section>
        </>
      )}

      <footer class="atlas-sheet__foot" aria-hidden="true">
        <span class="asterism">⁂</span>
      </footer>

    </Container>
  </article>

  <script is:inline>
    (function () {
      var days = document.querySelectorAll('.cal__cell--filled');
      var leaves = document.querySelectorAll('.leaf');
      if (!days.length || !leaves.length) return;

      // If the URL arrived with a hash, jump to that entry immediately.
      function applyHash() {
        var hash = window.location.hash;
        if (!hash || !hash.startsWith('#q-')) return;
        var q = hash.slice(3);
        select(q, false);
      }

      function select(q, scroll) {
        var found = false;
        leaves.forEach(function (l) {
          var match = l.getAttribute('data-q') === q;
          l.classList.toggle('is-active', match);
          if (match) found = true;
        });
        if (!found) return;
        days.forEach(function (d) {
          d.classList.toggle('is-selected', d.getAttribute('data-q') === q);
        });
        if (scroll) {
          var panel = document.getElementById('reading');
          if (panel) {
            var rect = panel.getBoundingClientRect();
            if (rect.top < 0 || rect.bottom > window.innerHeight) {
              panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }
      }

      days.forEach(function (d) {
        d.addEventListener('click', function (e) {
          e.preventDefault();
          var q = d.getAttribute('data-q');
          history.replaceState(null, '', '#q-' + q);
          select(q, true);
        });
      });

      applyHash();
    })();
  </script>
</BaseLayout>

<style>
  /* ─────────────────── per-LLM hues ──────────────────── */
  /* Restrained — three muted tones that share weight with cream paper. */
  :root {
    --claude: #A8512A;   /* warm rust    */
    --openai: #2E7E5D;   /* muted green  */
    --gemini: #1B3A5C;   /* ink blue (= site accent) */
  }

  .leaf--claude { --acc: var(--claude); }
  .leaf--openai { --acc: var(--openai); }
  .leaf--gemini { --acc: var(--gemini); }

  .leaf__dot--claude,  .census__dot--claude  { background: var(--claude); }
  .leaf__dot--openai,  .census__dot--openai  { background: var(--openai); }
  .leaf__dot--gemini,  .census__dot--gemini  { background: var(--gemini); }

  .cal__cell--claude { --cell: var(--claude); }
  .cal__cell--openai { --cell: var(--openai); }
  .cal__cell--gemini { --cell: var(--gemini); }

  /* ─────────────────── page frame ──────────────────── */
  .atlas-sheet {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }
  .atlas-sheet__inner {
    padding-left: var(--space-page);
    padding-right: var(--space-page);
  }

  /* ─────────────────── masthead ──────────────────── */
  .masthead__rail {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .rail__label    { color: var(--color-ink); font-weight: 600; }
  .rail__rule     { flex: 1; height: 1px; background: var(--color-rule); }
  .rail__edition  { font-feature-settings: var(--features-tabular); }

  .masthead__title {
    margin: var(--space-8) 0 var(--space-4) 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 5rem);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--color-accent);
    font-feature-settings: var(--features-display);
  }

  .masthead__lede {
    margin: 0 0 var(--space-7) 0;
    font-family: var(--font-serif);
    font-size: var(--type-h3);
    line-height: 1.45;
    color: var(--color-ink-soft);
    max-width: 38rem;
    font-weight: 400;
  }
  .masthead__instruction {
    color: var(--color-ink-muted);
    font-style: italic;
  }

  /* Census strip — single horizontal row, restrained labels. */
  .census {
    list-style: none;
    margin: 0 0 var(--space-12) 0;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-7);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-weight: 500;
    font-feature-settings: var(--features-tabular);
  }
  .census__cell {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
  }
  .census__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4em;
    color: var(--color-ink);
    font-weight: 600;
    font-feature-settings: var(--features-oldstyle);
  }
  .census__label {
    text-transform: none;
    letter-spacing: var(--tracking-normal);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-ink-soft);
    font-size: var(--type-small);
  }
  .census__dot {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    transform: translateY(-0.05em);
  }
  .census__name {
    color: var(--color-ink);
    font-weight: 600;
  }
  .census__count {
    font-family: var(--font-serif);
    font-style: italic;
    font-feature-settings: var(--features-oldstyle);
    color: var(--color-ink-muted);
    text-transform: none;
    letter-spacing: var(--tracking-normal);
    font-size: var(--type-small);
    margin-left: 0.1em;
  }
  .census__pressed {
    text-transform: none;
    letter-spacing: var(--tracking-normal);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-ink-soft);
    font-size: var(--type-small);
  }

  /* ─────────────────── reading panel ──────────────────── */
  .reading {
    position: relative;
    margin: 0 0 var(--space-16) 0;
    min-height: 14rem;
  }
  .leaf {
    display: none;
    max-width: 42rem;
  }
  .leaf.is-active {
    display: block;
    animation: leaf-in 360ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @keyframes leaf-in {
    from { opacity: 0; transform: translateY(0.5rem); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .leaf__text {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    line-height: 1.25;
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    text-indent: -0.4em;
  }
  .leaf__mark {
    color: var(--acc);
    font-weight: 800;
    font-size: 1.3em;
    line-height: 0;
    vertical-align: -0.1em;
    margin-right: 0.04em;
  }

  .leaf__meta {
    margin-top: var(--space-6);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55em;
    font-family: var(--font-sans);
    font-size: var(--type-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .leaf__dot {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    transform: translateY(0.05em);
  }
  .leaf__author {
    color: var(--acc);
    text-decoration: none;
    font-weight: 700;
    border-bottom: 1px solid transparent;
    transition: border-color 140ms ease;
  }
  .leaf__author:hover {
    border-bottom-color: var(--acc);
  }
  .leaf__sep { color: var(--color-ink-faint); }
  .leaf__date {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-ink-muted);
    text-transform: none;
    letter-spacing: var(--tracking-normal);
    font-size: var(--type-small);
    font-feature-settings: var(--features-oldstyle);
  }
  .leaf__num {
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-oldstyle), "tnum" 1;
  }

  /* ─────────────────── atlas (calendar) ──────────────────── */
  .atlas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-10) var(--space-12);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-rule);
  }
  .month { min-width: 0; }
  .month__head {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }
  .month__name {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: var(--type-h3);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
  }
  .month__year {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-small);
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
  }
  .month__rule { height: 1px; background: var(--color-rule); align-self: center; }
  .month__count {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }

  /* The grid itself — 7 cols, dow header + day rows. */
  .cal {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.35rem;
  }
  .cal__dow {
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-faint);
    font-weight: 600;
    padding-bottom: 0.4rem;
  }

  /* Day cell — uniform aspect ratio, day numeral oldstyle. */
  .cal__cell {
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-feature-settings: var(--features-oldstyle);
    color: var(--color-ink-faint);
    font-size: var(--type-small);
    line-height: 1;
    border-radius: 50%;
    position: relative;
  }
  .cal__cell--empty { visibility: hidden; }
  .cal__cell--blank {
    color: var(--color-ink-faint);
  }
  /* Filled day — disc in LLM colour, day numeral in cream. */
  .cal__cell--filled {
    background: var(--cell);
    color: var(--color-paper);
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 180ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 180ms ease;
    font-feature-settings: var(--features-oldstyle), "lnum" 1;
  }
  .cal__cell--filled:hover,
  .cal__cell--filled:focus-visible {
    transform: scale(1.12);
    outline: none;
  }
  .cal__cell--filled.is-selected {
    transform: scale(1.12);
    /* Ring matches the cell colour at higher contrast. */
    box-shadow: 0 0 0 2px var(--color-paper), 0 0 0 3px var(--color-ink);
  }
  .cal__cell--filled:focus-visible {
    box-shadow: 0 0 0 2px var(--color-paper), 0 0 0 3px var(--color-accent);
  }
  .cal__day {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.85em;
    letter-spacing: -0.01em;
  }

  /* ─────────────────── empty + foot ──────────────────── */
  .atlas-sheet__empty {
    margin-top: var(--space-10);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-body);
    color: var(--color-ink-muted);
  }
  .atlas-sheet__foot {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
    text-align: center;
  }
  .asterism {
    font-size: 1.5rem;
    color: var(--color-ink-faint);
    letter-spacing: 0.5em;
  }

  /* ─────────────────── responsive ──────────────────── */
  @media (max-width: 760px) {
    .masthead__title { font-size: 2.75rem; }
    .masthead__lede  { font-size: var(--type-body); }

    .census {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .leaf__text { font-size: 1.4rem; }
    .leaf__meta { font-size: var(--type-marginalia); gap: 0.4em; }

    .atlas {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .cal { gap: 0.3rem; }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .leaf.is-active { animation: none; }
    .cal__cell--filled:hover,
    .cal__cell--filled.is-selected {
      transform: none;
    }
  }
</style>
