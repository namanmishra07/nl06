---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import history    from "@nl06/design-system/data/quote_history.json";

interface HistoryEntry {
  date_ist: string;
  date_display: string;
  quote: string;
  author: string;
  author_key: string;
  author_url: string;
  ts_utc: string;
}

const entries = (history.entries ?? []) as HistoryEntry[];

const monthShort = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];

function toRoman(n: number): string {
  const map: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
    [100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
    [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
  ];
  let x = n;
  let out = "";
  for (const [v, sym] of map) { while (x >= v) { out += sym; x -= v; } }
  return out;
}

// Each entry is a typographic "specimen" whose treatment depends on
// its bucket. Every 7th becomes a column-breaking PULL — display-size,
// dramatic — regardless of its length. The others are bucketed by word
// count, which gives short punchy quotes more visual real estate.
type Bucket = "pull" | "headline" | "lead" | "body" | "footnote";

function bucketize(quote: string, i: number): Bucket {
  if (i % 7 === 0) return "pull";
  const w = quote.split(/\s+/).length;
  if (w <= 7)  return "headline";
  if (w <= 12) return "lead";
  if (w <= 17) return "body";
  return "footnote";
}

// Pre-compute everything the template needs.
const specimens = entries.map((e, i) => {
  const [Y, M, D] = e.date_ist.split("-").map(Number);
  return {
    ...e,
    bucket: bucketize(e.quote, i),
    day: D,
    month: monthShort[M - 1],
    year: Y,
    yearRoman: toRoman(Y),
    // Asterism + ornament markers used by pull-quotes.
    initial: e.quote[0],
    rest: e.quote.slice(1),
  };
});

const total = entries.length;
const yearMain = entries.length > 0
  ? Number(entries[0].date_ist.slice(0, 4))
  : new Date().getFullYear();
const volRoman = toRoman(yearMain);

// Author census — show all three with their dot colors.
const census: { key: string; label: string; n: number }[] = [
  "claude", "openai", "gemini",
].map((key) => ({
  key,
  label: entries.find((e) => e.author_key === key)?.author
       ?? key.charAt(0).toUpperCase() + key.slice(1),
  n: entries.filter((e) => e.author_key === key).length,
}));
---
<BaseLayout
  title="Marginalia — NL06"
  description="A folio of one-line aphorisms composed daily for the nl06.com footer by Claude, ChatGPT, and Gemini. Read in any order — the eye is in charge."
  pathname="/quotes"
  itemNumber="№ 006"
>
  <article class="sheet">
    <Container size="wide" class="sheet__inner">

      <!-- ─────────────────────────── MASTHEAD ─────────────────────────── -->
      <header class="sheet__head">
        <div class="sheet__rail">
          <span class="rail__num">Sheet IV</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">Vol. I · {volRoman}</span>
        </div>

        <h1 class="sheet__title">
          <span class="sheet__title-pre">A folio of</span>
          <span class="sheet__title-main">Marginalia<span class="sheet__title-comma" aria-hidden="true">,</span></span>
          <span class="sheet__title-post">composed in transit between three hands.</span>
        </h1>

        <div class="sheet__below">
          <p class="sheet__epigraph">
            One short line a day, pinned to the footer of <em>nl06.com</em>
            until tomorrow&rsquo;s takes its place. This is where they come
            to be remembered. <span class="sheet__epigraph-aside">Read in any
            order &mdash; the eye is in charge.</span>
          </p>

          <dl class="sheet__census" aria-label="Edition census">
            <div class="census__row">
              <dt>Pieces</dt>
              <dd><span class="census__num">{total}</span></dd>
            </div>
            <div class="census__row">
              <dt>Hands</dt>
              <dd class="census__hands">
                {census.map((c, i) => (
                  <span class="census__hand">
                    {i > 0 && <span class="census__sep" aria-hidden="true">·</span>}
                    <span class={`census__dot census__dot--${c.key}`} aria-hidden="true"></span>
                    <span class="census__name">{c.label}</span>
                    <span class="census__count">{c.n}</span>
                  </span>
                ))}
              </dd>
            </div>
            <div class="census__row">
              <dt>Pressed</dt>
              <dd>Daily, 03:30 IST</dd>
            </div>
          </dl>
        </div>
      </header>

      <!-- ─────────────────────────── MOSAIC ─────────────────────────── -->
      <div class="mosaic">
        {specimens.map((s, i) => (
          s.bucket === "pull" ? (
            <figure class={`spec spec--pull spec--${s.author_key}`}>
              <div class="pull__frame">
                <div class="pull__rail">
                  <span class="pull__day" aria-hidden="true">{s.day}</span>
                  <span class="pull__month" aria-hidden="true">{s.month}</span>
                  <span class="pull__year" aria-hidden="true">{s.yearRoman}</span>
                </div>
                <div class="pull__body">
                  <blockquote class="pull__quote">
                    <span class="pull__mark" aria-hidden="true">&ldquo;</span>{s.quote}
                  </blockquote>
                  <figcaption class="pull__stamp">
                    <span class="pull__pilcrow" aria-hidden="true">❡</span>
                    <a class="pull__author" href={s.author_url} rel="noopener">{s.author}</a>
                    <span class="pull__stamp-rule" aria-hidden="true"></span>
                    <span class="pull__stamp-meta">№ {String(i + 1).padStart(3, "0")}</span>
                  </figcaption>
                </div>
              </div>
            </figure>
          ) : (
            <figure class={`spec spec--${s.bucket} spec--${s.author_key}`}>
              {s.bucket === "headline" ? (
                <blockquote class="spec__quote spec__quote--headline">
                  <span class="spec__initial" aria-hidden="true">{s.initial}</span><span class="spec__rest">{s.rest}</span>
                </blockquote>
              ) : (
                <blockquote class={`spec__quote spec__quote--${s.bucket}`}>
                  <span class="spec__mark" aria-hidden="true">&ldquo;</span>{s.quote}
                </blockquote>
              )}
              <figcaption class="spec__stamp">
                <span class={`spec__dot spec__dot--${s.author_key}`} aria-hidden="true"></span>
                <a class="spec__author" href={s.author_url} rel="noopener">{s.author}</a>
                <span class="spec__date">
                  <span class="spec__day-num">{s.day}</span>&thinsp;{s.month}&thinsp;{s.yearRoman}
                </span>
              </figcaption>
            </figure>
          )
        ))}
      </div>

      {entries.length === 0 && (
        <p class="sheet__empty">
          The folio is empty. Tomorrow&rsquo;s line will be the first.
        </p>
      )}

      <footer class="sheet__foot" aria-hidden="true">
        <span class="sheet__asterism">⁂</span>
      </footer>

    </Container>
  </article>
</BaseLayout>

<style>
  /* ─────────────────────── per-LLM accents ─────────────────────── */
  /* Three quiet hues that sit on cream paper without competing
     with the ink-blue site accent. Used as a CSS var so each
     specimen scopes its accent cleanly. */
  .spec--claude { --acc: #A8512A; }   /* warm rust  */
  .spec--openai { --acc: #2E7E5D; }   /* muted green */
  .spec--gemini { --acc: #1B3A5C; }   /* ink blue   */

  .census__dot--claude { background: #A8512A; }
  .census__dot--openai { background: #2E7E5D; }
  .census__dot--gemini { background: #1B3A5C; }
  .spec__dot--claude   { background: #A8512A; }
  .spec__dot--openai   { background: #2E7E5D; }
  .spec__dot--gemini   { background: #1B3A5C; }

  /* ─────────────────────── PAGE FRAME ─────────────────────── */
  .sheet {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }
  .sheet__inner {
    padding-left: var(--space-page);
    padding-right: var(--space-page);
  }

  /* ─────────────────────── MASTHEAD ─────────────────────── */
  .sheet__rail {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .rail__num   { color: var(--color-ink); font-weight: 600; }
  .rail__rule  { flex: 1; height: 1px; background: var(--color-rule); }
  .rail__date  { font-feature-settings: var(--features-tabular); }

  .sheet__title {
    margin: var(--space-7) 0 var(--space-8) 0;
    font-family: var(--font-serif);
    color: var(--color-ink);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    font-feature-settings: var(--features-display);
  }
  .sheet__title-pre {
    display: block;
    font-style: italic;
    font-weight: 400;
    font-size: 1.4rem;
    color: var(--color-ink-muted);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2);
  }
  .sheet__title-main {
    display: block;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 9vw, 6rem);
    color: var(--color-accent);
    letter-spacing: var(--tracking-jumbo);
    line-height: 0.92;
  }
  .sheet__title-comma {
    color: var(--color-ink);
    font-weight: 400;
  }
  .sheet__title-post {
    display: block;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.4rem, 3.2vw, 2.25rem);
    color: var(--color-ink-soft);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-3);
  }

  /* MASTHEAD ↓ epigraph + census, separated from mosaic by a double rule */
  .sheet__below {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-12);
    padding-top: var(--space-7);
    padding-bottom: var(--space-10);
    border-top: 3px double var(--color-rule-strong);
    border-bottom: 3px double var(--color-rule-strong);
  }
  .sheet__epigraph {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink-soft);
    max-width: 38rem;
  }
  .sheet__epigraph em {
    font-style: italic;
    color: var(--color-ink);
  }
  .sheet__epigraph-aside {
    color: var(--color-accent);
    font-style: italic;
  }

  .sheet__census {
    margin: 0;
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-4) var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-weight: 500;
    align-content: start;
  }
  .census__row { display: contents; }
  .sheet__census dt {
    color: var(--color-ink);
    font-weight: 600;
    padding-top: 0.2em;
  }
  .sheet__census dd {
    margin: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-serif);
    font-size: var(--type-small);
    text-transform: none;
    letter-spacing: var(--tracking-normal);
    font-feature-settings: var(--features-tabular);
  }
  .census__num {
    font-weight: 600;
    color: var(--color-ink);
    font-size: 1.05em;
  }
  .census__hands {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5em;
  }
  .census__hand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }
  .census__dot {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    transform: translateY(-0.05em);
  }
  .census__name {
    color: var(--color-ink);
    font-weight: 600;
  }
  .census__count {
    font-feature-settings: var(--features-oldstyle);
    color: var(--color-ink-muted);
    font-style: italic;
    margin-left: 0.1em;
  }
  .census__sep {
    color: var(--color-ink-faint);
    margin-right: 0.15em;
  }

  /* ─────────────────────── THE MOSAIC ─────────────────────── */
  /* CSS multi-column packing — items flow naturally, fill column 1
     top-to-bottom, then column 2, then column 3. Pull-quotes use
     column-span:all to break out as full-width feature spreads.

     Critical: break-inside: avoid keeps a specimen whole. */
  .mosaic {
    margin-top: var(--space-12);
    column-count: 3;
    column-gap: var(--space-12);
    column-rule: 1px solid var(--color-rule);
  }

  /* ─────────────────────── SPECIMEN BASE ─────────────────────── */
  .spec {
    break-inside: avoid;
    margin: 0 0 var(--space-10) 0;
    padding: 0 0 0 var(--space-4);
    border-left: 1px solid var(--color-rule);
    position: relative;
    transition: border-color 220ms ease;
  }
  .spec:hover {
    border-left-color: var(--acc, var(--color-accent));
  }

  .spec__quote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
    text-indent: -0.4em;
  }
  .spec__mark {
    color: var(--acc, var(--color-accent));
    font-weight: 800;
    font-size: 1.35em;
    line-height: 0;
    vertical-align: -0.1em;
    margin-right: 0.04em;
  }

  /* HEADLINE — short, punchy. Drop-cap initial in the LLM colour. */
  .spec__quote--headline {
    font-size: 1.875rem;
    line-height: 1.18;
    font-weight: 500;
    text-indent: 0;
  }
  .spec__initial {
    float: left;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: 3.6em;
    line-height: 0.82;
    color: var(--acc, var(--color-accent));
    margin: 0.05em 0.08em -0.1em 0;
    font-feature-settings: var(--features-display);
  }
  .spec__rest { color: inherit; }

  /* LEAD — medium. Hung quote mark in colour. */
  .spec__quote--lead {
    font-size: 1.4rem;
    line-height: 1.3;
    font-weight: 500;
  }
  /* BODY — most quotes land here. */
  .spec__quote--body {
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  /* FOOTNOTE — long. Tucked compactly, paper-dim tint, vertical bar. */
  .spec--footnote {
    background: var(--color-paper-dim);
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    border-left: 2px solid var(--acc, var(--color-rule));
    margin-left: -1px;
  }
  .spec__quote--footnote {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  /* The STAMP — universal author + date signature. */
  .spec__stamp {
    margin-top: var(--space-3);
    display: flex;
    align-items: baseline;
    gap: 0.55em;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .spec__dot {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    flex-shrink: 0;
    transform: translateY(0.06em);
  }
  .spec__author {
    color: var(--acc, var(--color-ink));
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 140ms ease;
    font-weight: 700;
  }
  .spec__author:hover {
    border-bottom-color: var(--acc, var(--color-accent));
  }
  .spec__date {
    color: var(--color-ink-muted);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-meta);
    text-transform: none;
    letter-spacing: var(--tracking-normal);
    font-feature-settings: var(--features-oldstyle);
    margin-left: auto;
  }
  .spec__day-num {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* ─────────────────────── PULL-QUOTE ─────────────────────── */
  /* Every 7th specimen breaks the columns into a full-width feature.
     Big italic display type with a marginal date numeral. The dramatic
     punctuation that anchors the mosaic. */
  .spec--pull {
    column-span: all;
    -webkit-column-span: all;
    border-left: 0;
    padding: 0;
    margin: var(--space-12) 0 var(--space-12) 0;
  }
  .pull__frame {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-12);
    align-items: start;
    padding: var(--space-10) 0;
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    position: relative;
  }
  /* Double-rule above and below — printed-edition framing. */
  .pull__frame::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: -5px;
    border-top: 1px solid var(--color-ink);
  }
  .pull__frame::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -5px;
    border-bottom: 1px solid var(--color-ink);
  }
  .pull__rail {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-right: var(--space-4);
    border-right: 1px solid var(--color-rule);
  }
  .pull__day {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(4.5rem, 11vw, 8rem);
    line-height: 0.82;
    color: var(--acc);
    font-feature-settings: var(--features-oldstyle);
    letter-spacing: -0.04em;
  }
  .pull__month {
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--type-meta);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .pull__year {
    margin-top: var(--space-1);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-small);
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
  }
  .pull__body {
    min-width: 0;
  }
  .pull__quote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.75rem, 4.2vw, 3.25rem);
    line-height: 1.08;
    color: var(--color-ink);
    letter-spacing: var(--tracking-display);
    text-indent: -0.4em;
  }
  .pull__mark {
    color: var(--acc);
    font-weight: 800;
    font-size: 1.4em;
    line-height: 0;
    vertical-align: -0.1em;
    margin-right: 0.04em;
  }
  .pull__stamp {
    margin-top: var(--space-7);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--type-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 600;
  }
  .pull__pilcrow {
    color: var(--acc);
    font-size: 1.4em;
    font-weight: 400;
  }
  .pull__author {
    color: var(--acc);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    transition: border-color 140ms ease;
    font-weight: 700;
  }
  .pull__author:hover {
    border-bottom-color: var(--acc);
  }
  .pull__stamp-rule {
    flex: 1;
    height: 1px;
    background: var(--color-rule);
  }
  .pull__stamp-meta {
    font-feature-settings: var(--features-oldstyle);
    color: var(--color-ink-muted);
    font-weight: 500;
  }

  /* ─────────────────────── EMPTY + FOOT ─────────────────────── */
  .sheet__empty {
    margin-top: var(--space-10);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-body);
    color: var(--color-ink-muted);
  }
  .sheet__foot {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
    text-align: center;
  }
  .sheet__asterism {
    font-size: 1.5rem;
    color: var(--color-ink-faint);
    letter-spacing: 0.5em;
  }

  /* ─────────────────────── RESPONSIVE ─────────────────────── */
  @media (max-width: 1024px) {
    .mosaic { column-count: 2; column-gap: var(--space-10); }
    .sheet__below {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  @media (max-width: 760px) {
    .sheet__title { margin-top: var(--space-5); }
    .sheet__title-main { letter-spacing: -0.025em; }

    .sheet__census { grid-template-columns: 1fr; gap: var(--space-2); }
    .sheet__census dt { padding-top: var(--space-3); }

    .mosaic {
      column-count: 1;
      column-rule: 0;
    }

    .pull__frame {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding: var(--space-7) 0;
    }
    .pull__rail {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
      padding-right: 0;
      padding-bottom: var(--space-3);
      border-right: 0;
      border-bottom: 1px solid var(--color-rule);
    }
    .pull__day { line-height: 0.95; }
    .pull__month { margin-top: 0; }
    .pull__year { margin-top: 0; }

    .spec__quote--headline { font-size: 1.5rem; }
    .spec__quote--lead     { font-size: 1.2rem; }
  }
</style>
