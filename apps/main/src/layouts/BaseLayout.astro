---
import "@nl06/design-system/global.css";
import SiteHeader   from "@nl06/design-system/components/SiteHeader.astro";
import SiteFooter   from "@nl06/design-system/components/SiteFooter.astro";
import Meta         from "@nl06/design-system/components/Meta.astro";

interface Props {
  title: string;
  description?: string;
  /** Path of the current page, for nav active state. Defaults to Astro.url.pathname. */
  pathname?: string;
  /** Item number in the printer's colophon footer. */
  itemNumber?: string;
}

const {
  title,
  description,
  pathname = Astro.url.pathname,
  itemNumber,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

/* Subdomain "stations" — surfaced as a quietly-subordinated second nav
 * row in the masthead so visitors don't have to scroll past the hero
 * to discover the running instruments. Apex only; subdomain mastheads
 * don't pass this prop. */
const stations = [
  { numeral: "I",   label: "gs.",           href: "https://gs.nl06.com" },
  { numeral: "II",  label: "chains.",       href: "https://chains.nl06.com" },
  { numeral: "III", label: "reading.",      href: "https://reading.nl06.com" },
  { numeral: "IV",  label: "auctionhouse.", href: "https://auctionhouse.nl06.com" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <Meta title={title} description={description} canonical={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader
      pathname={pathname}
      title="NL06"
      caption="— A Field Notebook"
      edition='Composed by Naman // <a href="https://www.anthropic.com" rel="noopener">Claude</a>'
      dateline="Earth  ·  2026"
      stations={stations}
    />
    <main>
      <slot />
    </main>
    <SiteFooter itemNumber={itemNumber} />
  </body>
</html>
