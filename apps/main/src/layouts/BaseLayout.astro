---
import "@nl06/design-system/global.css";
import SiteHeader   from "@nl06/design-system/components/SiteHeader.astro";
import SiteFooter   from "@nl06/design-system/components/SiteFooter.astro";
import Meta         from "@nl06/design-system/components/Meta.astro";

interface Props {
  title: string;
  description?: string;
  /** Path of the current page, for nav active state. Defaults to Astro.url.pathname. */
  pathname?: string;
}

const {
  title,
  description,
  pathname = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <Meta title={title} description={description} canonical={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader pathname={pathname} />
    <main>
      <slot />
    </main>
    <SiteFooter signature="Running on a Pi in Lucknow." />
  </body>
</html>
