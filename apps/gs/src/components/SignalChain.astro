---
/* The signal chain — an editorial technical diagram for one of the
   gs instruments. Hairlines, named nodes, no icons. Reusable across
   the V-dipole VHF chain and the two L-band pointings (GK-2A and
   Elektro-L5). */

export interface Node {
  /** Roman numeral printed as the node marker. */
  mark: string;
  /** Title — Inter uppercase. */
  name: string;
  /** Sub-spec — serif italic. */
  spec: string;
  /** Optional second sub-spec, for tabular pairs. */
  spec2?: string;
}

interface Props {
  nodes: Node[];
  /** Tag pair printed above the divider, e.g. ["Rooftop", "NAS"]. */
  domainTags?: [string, string];
  /** Index AFTER which the rooftop/NAS divider sits. Default: 3
   *  (i.e. between node IV — Receiver — and node V — Decoder). */
  dividerAfter?: number;
  caption?: string;
}

const {
  nodes,
  domainTags = ["Antenna · RF", "NAS · /satellite"],
  dividerAfter,
  caption,
} = Astro.props;

const W = 1200;
const H = 280;
const PAD = 52;
const usable = W - PAD * 2;
const step = nodes.length > 1 ? usable / (nodes.length - 1) : usable;
const yMid = 140;
const boxW = 156;
const boxH = 112;
const innerW = boxW - 16;

/* Wrap a label into at most two lines that fit inside the box, breaking
   on whitespace. Any single line that is still too wide is squeezed to
   the box width via textLength so nothing spills outside the box. */
function wrapText(t: string, maxChars: number): string[] {
  const tokens = t.split(/\s+/).filter(Boolean);
  const lines: string[] = [];
  let cur = "";
  for (const tok of tokens) {
    const cand = cur ? `${cur} ${tok}` : tok;
    if (cand.length > maxChars && cur) { lines.push(cur); cur = tok; }
    else cur = cand;
  }
  if (cur) lines.push(cur);
  if (lines.length > 2) return [lines[0], lines.slice(1).join(" ")];
  return lines;
}
const clampLen = (t: string, perChar: number): number | undefined =>
  t.length * perChar > innerW ? innerW : undefined;

// Place the divider half-way between the two nodes on either side of it.
const dividerIdx = dividerAfter ?? Math.floor(nodes.length / 2) - 1;
const dividerX = PAD + step * (dividerIdx + 0.5);
---
<figure class="signal-chain">
  {caption && (
    <figcaption class="signal-chain__cap">
      <span class="signal-chain__cap-label">Diagram</span>
      <span class="signal-chain__cap-rule" aria-hidden="true"></span>
      <span class="signal-chain__cap-body">{caption}</span>
    </figcaption>
  )}

  <svg
    class="signal-chain__svg"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`Signal chain: ${nodes.map((n) => n.name).join(" → ")}.`}
    preserveAspectRatio="xMidYMid meet"
  >
    {dividerIdx >= 0 && dividerIdx < nodes.length - 1 && (
      <g>
        <line
          x1={dividerX} y1={36}
          x2={dividerX} y2={H - 24}
          stroke="var(--color-rule-strong)" stroke-width="1"
        />
        <text x={dividerX - 14} y={28}
          text-anchor="end" class="sc-tag" fill="var(--color-ink-muted)"
        >{domainTags[0]}</text>
        <text x={dividerX + 14} y={28}
          text-anchor="start" class="sc-tag" fill="var(--color-ink-muted)"
        >{domainTags[1]}</text>
      </g>
    )}

    {nodes.map((n, i) => {
      const cx = PAD + step * i;
      const x  = cx - boxW / 2;
      const y  = yMid - boxH / 2;
      const isLast = i === nodes.length - 1;
      const nextCx = PAD + step * (i + 1);
      const crossesDivider = i === dividerIdx;
      return (
        <g>
          {!isLast && (
            <g>
              <line
                x1={cx + boxW / 2}
                y1={yMid}
                x2={nextCx - boxW / 2 - 10}
                y2={yMid}
                stroke="var(--color-ink)"
                stroke-width={crossesDivider ? "1.4" : "1"}
              />
              <polygon
                points={`${nextCx - boxW / 2 - 2},${yMid} ${nextCx - boxW / 2 - 10},${yMid - 4} ${nextCx - boxW / 2 - 10},${yMid + 4}`}
                fill="var(--color-ink)"
              />
            </g>
          )}
          <rect
            x={x} y={y}
            width={boxW} height={boxH}
            fill="var(--color-paper)"
            stroke="var(--color-ink)"
            stroke-width="1.2"
          />
          <line
            x1={x} y1={y + 24}
            x2={x + boxW} y2={y + 24}
            stroke="var(--color-rule)" stroke-width="1"
          />
          <text x={x + 10} y={y + 17}
            class="sc-mark" fill="var(--color-accent)"
          >{n.mark}</text>
          <text x={x + boxW - 10} y={y + 17}
            text-anchor="end" class="sc-folio" fill="var(--color-ink-muted)"
          >{String(i + 1).padStart(2, "0")}</text>
          {(() => {
            const specLines  = wrapText(n.spec, 26);
            const spec2Lines = n.spec2 ? wrapText(n.spec2, 28) : [];
            const specStartY = y + 56;
            const spec2StartY = specStartY + specLines.length * 14 + 2;
            return (
              <g>
                <text x={x + boxW / 2} y={y + 40}
                  text-anchor="middle" class="sc-name" fill="var(--color-ink)"
                  textLength={clampLen(n.name, 8.6)} lengthAdjust="spacingAndGlyphs"
                >{n.name}</text>
                {specLines.map((ln, k) => (
                  <text x={x + boxW / 2} y={specStartY + k * 14}
                    text-anchor="middle" class="sc-spec" fill="var(--color-ink-soft)"
                    textLength={clampLen(ln, 6.2)} lengthAdjust="spacingAndGlyphs"
                  >{ln}</text>
                ))}
                {spec2Lines.map((ln, k) => (
                  <text x={x + boxW / 2} y={spec2StartY + k * 13}
                    text-anchor="middle" class="sc-spec-sm" fill="var(--color-ink-muted)"
                    textLength={clampLen(ln, 5.4)} lengthAdjust="spacingAndGlyphs"
                  >{ln}</text>
                ))}
              </g>
            );
          })()}
        </g>
      );
    })}
  </svg>

  <style>
    .signal-chain {
      margin: 0;
      padding: var(--space-6) 0;
    }
    .signal-chain__cap {
      display: grid;
      grid-template-columns: auto auto 1fr;
      gap: var(--space-3);
      align-items: center;
      margin-bottom: var(--space-5);
    }
    .signal-chain__cap-label {
      font-family: var(--font-sans);
      font-size: var(--type-marginalia);
      letter-spacing: var(--tracking-meta);
      text-transform: uppercase;
      color: var(--color-ink);
      font-feature-settings: var(--features-tabular);
      font-weight: 600;
    }
    .signal-chain__cap-rule {
      width: 2.5rem;
      height: 1px;
      background: var(--color-ink);
    }
    .signal-chain__cap-body {
      font-family: var(--font-serif);
      font-style: italic;
      color: var(--color-ink-soft);
      font-size: var(--type-small);
      line-height: var(--leading-snug);
    }
    .signal-chain__svg {
      display: block;
      width: 100%;
      height: auto;
      max-width: 100%;
      background: var(--color-paper);
    }
    :global(.sc-mark) {
      font-family: var(--font-serif);
      font-weight: 800;
      font-size: 13px;
      font-feature-settings: var(--features-tabular);
    }
    :global(.sc-folio) {
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: 10px;
      letter-spacing: 0.08em;
      font-feature-settings: var(--features-tabular);
    }
    :global(.sc-name) {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-feature-settings: var(--features-tabular);
    }
    :global(.sc-spec) {
      font-family: var(--font-serif);
      font-weight: 500;
      font-style: italic;
      font-size: 12px;
    }
    :global(.sc-spec-sm) {
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: 10px;
      letter-spacing: 0.06em;
      font-feature-settings: var(--features-tabular);
    }
    :global(.sc-tag) {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-feature-settings: var(--features-tabular);
    }
  </style>
</figure>
