---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import PlateCard  from "~/components/PlateCard.astro";

const all = (await getCollection("plates"))
  .filter((p) => !p.data.draft && p.data.image)
  .sort((a, b) => b.data.captured_at.getTime() - a.data.captured_at.getTime());

const romans = ["I","II","III","IV","V","VI","VII","VIII","IX","X","XI","XII","XIII","XIV","XV","XVI","XVII","XVIII","XIX","XX"];

/** Map a plate's `satellite` display string to the section key. */
function sectionKey(satDisplay: string): "gk-2a" | "elektro-l5" | "meteor-m2-4" | "other" {
  if (satDisplay.includes("KOMPSAT")) return "gk-2a";
  if (satDisplay.includes("ELEKTRO")) return "elektro-l5";
  if (satDisplay.includes("METEOR"))  return "meteor-m2-4";
  return "other";
}

interface Section {
  id: "gk-2a" | "elektro-l5" | "meteor-m2-4";
  numeral: string;
  label: string;
  /** Official page for this satellite — operating agency where available. */
  officialUrl: string;
  target: string;
  band: string;
  instrumentHref: string;
  /** Display numeral of the instrument this section's captures are produced by. */
  instrumentNumeral: string;
  /** Display label shown next to the instrument link. */
  instrumentLabel: string;
  emptyMessage?: string;
  entries: typeof all;
}

const sections: Section[] = [
  {
    id: "gk-2a",
    numeral: "I",
    label: "GK-2A",
    officialUrl: "https://nmsc.kma.go.kr/enhome/html/main/main.do",
    target: "GEO-KOMPSAT-2A · 128.2°E",
    band: "L-band · 1692.140 MHz",
    instrumentHref: "/instrument#i-l-band-gk2a-trough",
    instrumentNumeral: "I",
    instrumentLabel: "parabolic trough (current); see also Instrument II — 12-turn helix (retired)",
    entries: all.filter((p) => sectionKey(p.data.satellite) === "gk-2a"),
  },
  {
    id: "elektro-l5",
    numeral: "II",
    label: "Elektro-L5",
    officialUrl: "https://en.wikipedia.org/wiki/Elektro-L",
    target: "Elektro-L5 · 76°E",
    band: "L-band · 1691.000 MHz",
    instrumentHref: "/instrument#iii-l-band-elektro",
    instrumentNumeral: "III",
    instrumentLabel: "L-band · Elektro-L5",
    emptyMessage: "Elektro-L5 is in commissioning at 76°E. Broadcasts are sporadic, clustered around 08:00 UTC, and the 2026-05-17 attempt yielded no decoded frames. Images appear here once the satellite transmits reliably and the chain locks.",
    entries: all.filter((p) => sectionKey(p.data.satellite) === "elektro-l5"),
  },
  {
    id: "meteor-m2-4",
    numeral: "III",
    label: "METEOR M2-4",
    officialUrl: "https://en.wikipedia.org/wiki/Meteor-M",
    target: "METEOR-M N2-4 (and N2-3) · polar LEO",
    band: "VHF · 137.900 MHz",
    instrumentHref: "/instrument#iv-v-dipole",
    instrumentNumeral: "IV",
    instrumentLabel: "137 MHz V-dipole",
    entries: all.filter((p) => sectionKey(p.data.satellite) === "meteor-m2-4"),
  },
];

// Per-section plate numbering — start each section at I and count up.
function getRomanFor(sectionEntries: typeof all, plateId: string): string {
  const idx = sectionEntries.findIndex((e) => e.id === plateId);
  return romans[idx] ?? "—";
}

const totalImaged = all.length;
---
<BaseLayout
  title="gs.nl06 — Plates"
  description="Every decoded plate this rig has produced, sectioned by satellite."
  itemNumber="№ GS02"
>
  <article class="plates">
    <Container size="wide" class="plates__inner">
      <header class="plates__head">
        <div class="plates__rail">
          <span class="rail__label">Register</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">{totalImaged} on file</span>
        </div>
        <div class="plates__heading">
          <h1 class="plates__title">
            <span class="plates__title-line">Plates.</span>
            <span class="plates__title-emphasis">By satellite, then by time.</span>
          </h1>
          <p class="plates__lede">
            Every decoded frame this rig has filed, grouped by source satellite. Each
            section is fed by one configured chain; the section header links to that
            instrument's page. Failed captures and unlocked passes are kept in the
            <a href="/log">operational log</a>, not here.
          </p>
        </div>
      </header>

      <!-- table of contents -->
      <nav class="plates__toc" aria-label="Sections">
        <ol class="plates__toc-list">
          {sections.map((s) => (
            <li class="plates__toc-item">
              <a href={`#${s.id}`} class="plates__toc-link">
                <span class="plates__toc-mark">{s.numeral}</span>
                <span class="plates__toc-label">{s.label}</span>
                <span class="plates__toc-count">
                  {s.entries.length === 0 ? "—" : String(s.entries.length).padStart(2, "0")}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {sections.map((s) => (
        <section class="plates__section" id={s.id}>
          <header class="plates__section-head">
            <span class="plates__section-mark">{s.numeral}</span>
            <div class="plates__section-heading">
              <span class="plates__section-kicker">
                {s.band}
                <span class="plates__section-kicker-sep" aria-hidden="true">·</span>
                <a href={s.instrumentHref} class="plates__section-instrument-link">
                  Instrument {s.instrumentNumeral} · {s.instrumentLabel} ↗
                </a>
              </span>
              <h2 class="plates__section-title">
                <a class="plates__section-title-link" href={s.officialUrl} rel="noopener" target="_blank">
                  {s.label}<span class="plates__section-title-arrow" aria-hidden="true">↗</span>
                </a>
              </h2>
              <p class="plates__section-target">{s.target}</p>
            </div>
            <span class="plates__section-count">
              {s.entries.length === 0 ? "Coming soon" : `${s.entries.length} plates on file`}
            </span>
          </header>

          {s.entries.length === 0 ? (
            <div class="plates__section-empty">
              <p class="plates__empty-mark">No images yet</p>
              <p class="plates__empty-body">{s.emptyMessage}</p>
              <p class="plates__empty-link">
                <a href={s.instrumentHref}>See the instrument →</a>
              </p>
            </div>
          ) : (
            <ol class="plates__section-list">
              {s.entries.map((p) => (
                <li id={p.id}>
                  <PlateCard
                    plate={p}
                    number={s.entries.findIndex((e) => e.id === p.id) + 1}
                    roman={getRomanFor(s.entries, p.id)}
                    level={3}
                  />
                </li>
              ))}
            </ol>
          )}
        </section>
      ))}
    </Container>
  </article>
</BaseLayout>

<style>
  .plates { padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .plates :global(.plates__inner) {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
  }
  .plates__head {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-rule);
  }
  .plates__rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }
  .rail__label, .rail__date {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .rail__label { color: var(--color-ink); font-weight: 600; }
  .rail__date  { color: var(--color-ink-muted); }
  .rail__rule  { height: 1px; background: var(--color-rule); }

  .plates__title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-jumbo);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .plates__title-line { display: block; }
  .plates__title-emphasis {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }
  .plates__lede {
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--type-h4);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
    max-width: 44rem;
  }

  /* TOC ────────────────────────────────────────────────────────── */
  .plates__toc {
    grid-column: 1 / -1;
    margin-top: var(--space-10);
  }
  .plates__toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--color-ink);
  }
  .plates__toc-item {
    border-right: 1px solid var(--color-rule);
    margin: 0;
  }
  .plates__toc-item + .plates__toc-item { margin-top: 0; }
  .plates__toc-item:last-child { border-right: 0; }
  .plates__toc-link {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-5) var(--space-5);
    text-decoration: none;
    color: inherit;
    background: var(--color-paper);
    transition: background 100ms ease;
  }
  .plates__toc-link:hover { background: var(--color-paper-margin); }
  .plates__toc-mark {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-h2);
    line-height: 0.9;
    color: var(--color-accent);
    font-feature-settings: var(--features-tabular);
    text-align: center;
  }
  .plates__toc-label {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h4);
    color: var(--color-ink);
    letter-spacing: var(--tracking-tight);
  }
  .plates__toc-count {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }

  /* SECTION ────────────────────────────────────────────────────── */
  .plates__section {
    grid-column: 1 / -1;
    margin-top: var(--space-16);
    scroll-margin-top: var(--space-12);
  }
  .plates__section-head {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 3px solid var(--color-ink);
    position: relative;
  }
  .plates__section-head::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    border-bottom: 1px solid var(--color-ink);
  }
  .plates__section-mark {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-jumbo);
    line-height: 0.82;
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-accent);
    font-feature-settings: var(--features-tabular);
    text-align: right;
  }
  .plates__section-heading { padding-top: 0.6em; }
  .plates__section-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-3);
    width: max-content;
    max-width: 100%;
  }
  .plates__section-kicker-sep { color: var(--color-rule-strong); }
  .plates__section-instrument-link {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    padding-bottom: 1px;
  }
  .plates__section-instrument-link:hover {
    color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent-hover);
  }
  .plates__section-title {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .plates__section-title-link {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.2em;
    transition: color 100ms ease;
  }
  .plates__section-title-link:hover { color: var(--color-accent); }
  .plates__section-title-arrow {
    font-size: 0.42em;
    color: var(--color-ink-faint);
    transition: color 100ms ease, transform 200ms cubic-bezier(0.2, 0.7, 0.4, 1);
  }
  .plates__section-title-link:hover .plates__section-title-arrow {
    color: var(--color-accent);
    transform: translate(0.15em, -0.15em);
  }
  .plates__section-target {
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-body);
    color: var(--color-ink-soft);
  }
  .plates__section-count {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    white-space: nowrap;
    align-self: end;
    padding-bottom: 0.2em;
  }

  .plates__section-list {
    grid-column: 1 / -1;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }
  .plates__section-list li { margin: 0; }
  .plates__section-list li + li { margin-top: 0; }

  /* Empty state — Elektro-L5 placeholder */
  .plates__section-empty {
    margin-top: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--color-ink);
    background: var(--color-paper-margin);
    background-image: repeating-linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-rule-strong) 14%, transparent) 0,
      color-mix(in srgb, var(--color-rule-strong) 14%, transparent) 1px,
      transparent 1px,
      transparent 14px
    );
    max-width: 50rem;
  }
  .plates__empty-mark {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-accent);
    font-feature-settings: var(--features-tabular);
    font-weight: 700;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-4);
  }
  .plates__empty-body {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink-soft);
  }
  .plates__empty-link {
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-body);
  }
  .plates__empty-link a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    padding-bottom: 1px;
  }
  .plates__empty-link a:hover {
    color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent-hover);
  }

  @media (max-width: 760px) {
    .plates :global(.plates__inner),
    .plates__head { grid-template-columns: 1fr; }
    .plates__rail { flex-direction: row; align-items: center; gap: var(--space-3); }
    .plates__rail .rail__rule { flex: 1; }
    .plates__title { font-size: var(--type-display); }
    .plates__toc-list { grid-template-columns: 1fr; }
    .plates__toc-item { border-right: 0; border-bottom: 1px solid var(--color-rule); }
    .plates__toc-item:last-child { border-bottom: 0; }
    .plates__section-head { grid-template-columns: auto 1fr; }
    .plates__section-mark { font-size: var(--type-h1); }
    .plates__section-title { font-size: var(--type-h2); }
    .plates__section-count { display: none; }
  }
</style>
