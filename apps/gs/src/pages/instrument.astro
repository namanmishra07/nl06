---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import SignalChain from "~/components/SignalChain.astro";

interface NodeSpec {
  mark: string;
  name: string;
  spec: string;
  detail: string;
  role: string;
  notes: string;
}

const components: NodeSpec[] = [
  {
    mark: "I",
    name: "Antenna",
    spec: "60 cm parabolic offset dish",
    detail: "Re-purposed Ku-band TV dish, repointed and re-aimed for L-band geostationary work. Mechanical pointing fixed to GK-2A at 128.2°E.",
    role: "Captures the L-band downlink and concentrates it onto the helix feed at the focal point.",
    notes: "Azimuth 112.6° true (111.9° magnetic at Lucknow). Elevation 29.6°. Half-power beamwidth at 1.69 GHz is roughly 17°, which means re-aiming for any non-GK-2A bird is a manual job.",
  },
  {
    mark: "II",
    name: "Feed",
    spec: "3-turn RHCP helix, ~1691 MHz",
    detail: "Hand-wound helical antenna with reflector ground plane. Right-hand circular to match GK-2A's RHCP downlink.",
    role: "Converts the dish's focused energy into a coaxial signal of the correct polarisation.",
    notes: "Mismatched polarisation alone costs 20+ dB, so the helix sense matters more than its raw gain.",
  },
  {
    mark: "III",
    name: "Front-end",
    spec: "Nooelec SAWbird+ GOES",
    detail: "Integrated LNA and SAW filter, ~36 dB gain in band, bandpass centred on 1688 MHz. Externally powered — bias-tee on the SDR is NOT used.",
    role: "Lifts the microvolt-level dish output above the SDR's noise floor while keeping the band clean of adjacent emitters.",
    notes: "External 5V supply is the safer arrangement on this rig — co-existing bias-tee would conflict and almost certainly damage the SDR's regulator.",
  },
  {
    mark: "IV",
    name: "Receiver",
    spec: "RTL-SDR Blog V4",
    detail: "R828D tuner, 8-bit ADC, native cu8 baseband, 2.4 Msps capture rate.",
    role: "Tunes to 1692.140 MHz and writes a complex-baseband stream straight to disk.",
    notes: "Tuner gain held at 25 dB; pushing higher compresses the front end and raises the noise floor visibly. The first usable METEOR captures on this rig appeared the day the gain came back down.",
  },
  {
    mark: "V",
    name: "Decoder",
    spec: "SatDump v2.0.0-alpha-8ce9d5b",
    detail: "Built from source on the NAS. The gk2a_lrit pipeline does the Viterbi, Reed-Solomon, and CCSDS frame work.",
    role: "Lock the BPSK carrier, recover the symbol clock, reconstruct CADUs, and write the LRIT image files.",
    notes: "--dc_block=true is mandatory for cu8 captures from this rig. The DC bin in cu8 sits +30 dB above the noise floor — a known encoding artefact, not a real signal — and destabilises the symbol tracker if not removed.",
  },
  {
    mark: "VI",
    name: "Composite",
    spec: "Sanchez v1.0.26.1",
    detail: "Final colorisation pass: blue Earth underlay, atmospheric haze, optional gradient palettes for the IR brightness scale.",
    role: "Turn the raw greyscale IR105 brightness frame into a legible plate.",
    notes: "Optional. Plate V on the register is the same capture before this step, included to show what the decoder hands to the colorist.",
  },
];
---
<BaseLayout
  title="gs.nl06 — The instrument"
  description="Antenna to composite: every link in the chain that turns a microvolt at 1.69 GHz into a plate."
  itemNumber="№ GS03"
>
  <article class="instr">
    <Container size="wide" class="instr__inner">
      <header class="instr__head">
        <div class="instr__rail">
          <span class="rail__label">Reference</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">Six nodes</span>
        </div>
        <div class="instr__heading">
          <h1 class="instr__title">
            <span class="instr__title-line">The instrument.</span>
            <span class="instr__title-emphasis">Microvolts in, plate out.</span>
          </h1>
          <p class="instr__lede dropcap-text">
            Every plate filed on this register is the output of a six-node chain run
            end-to-end without intervention. The diagram below names the nodes; the
            register beneath it lists what each one is for, what part of the failure
            envelope it owns, and where the surprises tend to live.
          </p>
        </div>
      </header>

      <section class="instr__diagram">
        <SignalChain />
      </section>

      <section class="instr__register">
        <header class="instr__banner">
          <span class="instr__banner__num">§</span>
          <h2 class="instr__banner__title">Per-node register</h2>
          <span class="instr__banner__rule" aria-hidden="true"></span>
          <span class="instr__banner__count">{components.length} entries</span>
        </header>

        <ol class="instr__list">
          {components.map((c, i) => (
            <li class="node">
              <article class="node__article">
                <aside class="node__rail">
                  <span class="node__mark">{c.mark}</span>
                  <span class="node__folio">No. {String(i + 1).padStart(2, "0")}</span>
                </aside>
                <div class="node__body">
                  <header class="node__head">
                    <span class="node__kicker">{c.spec}</span>
                    <h3 class="node__name">{c.name}</h3>
                  </header>

                  <dl class="node__rows">
                    <div class="node__row">
                      <dt>Detail</dt>
                      <dd>{c.detail}</dd>
                    </div>
                    <div class="node__row">
                      <dt>Role</dt>
                      <dd>{c.role}</dd>
                    </div>
                    <div class="node__row node__row--accent">
                      <dt>Operative note</dt>
                      <dd>{c.notes}</dd>
                    </div>
                  </dl>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </section>

      <section class="instr__ops">
        <header class="instr__banner">
          <span class="instr__banner__num">¶</span>
          <h2 class="instr__banner__title">Operational notes</h2>
          <span class="instr__banner__rule" aria-hidden="true"></span>
          <span class="instr__banner__count">Standing posture</span>
        </header>

        <dl class="ops__rows">
          <div class="ops__row">
            <dt>Cadence</dt>
            <dd>GK-2A transmits continuously. Capture slots are scheduled on the hour and the half hour; the rooftop chain is otherwise idle.</dd>
          </div>
          <div class="ops__row">
            <dt>Calibration</dt>
            <dd>The 137 MHz V-dipole path (now retired) used the always-on ORBCOMM constellation as a chain canary &mdash; if frames decode, the chain is alive. The L-band path has no equivalent free signal; GGAK at 1693 MHz is the closest candidate but currently unverified on this rig.</dd>
          </div>
          <div class="ops__row">
            <dt>Retention</dt>
            <dd>Raw IQ from a successful decode is purged within an hour. Failed-decode IQ is held seven days in <code>/satellite/_raw-iq/needs-review/</code> for re-decode attempts, then auto-deleted.</dd>
          </div>
          <div class="ops__row">
            <dt>Provenance</dt>
            <dd>Every IQ file that has been pulled and processed is logged one JSON line at a time in <code>/satellite/.processed-iq-log.ndjson</code>, keyed on filename and first-megabyte SHA-256.</dd>
          </div>
        </dl>

        <p class="ops__legend">
          The chain has been quiet since the rooftop hardware was moved off-site for
          re-housing. New plates resume the day the dish goes back up.
        </p>
      </section>
    </Container>
  </article>
</BaseLayout>

<style>
  .instr { padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .instr :global(.instr__inner) {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
  }
  .instr__head {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-rule);
  }
  .instr__rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }
  .rail__label, .rail__date {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .rail__label { color: var(--color-ink); font-weight: 600; }
  .rail__date  { color: var(--color-ink-muted); }
  .rail__rule  { height: 1px; background: var(--color-rule); }

  .instr__title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-jumbo);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .instr__title-line { display: block; }
  .instr__title-emphasis {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }
  .instr__lede {
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--type-h4);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
    max-width: 42rem;
  }

  .instr__diagram { grid-column: 1 / -1; margin-top: var(--space-10); }
  .instr__register, .instr__ops { grid-column: 1 / -1; margin-top: var(--space-16); }

  .instr__banner {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 3px solid var(--color-ink);
    position: relative;
  }
  .instr__banner::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    border-bottom: 1px solid var(--color-ink);
  }
  .instr__banner__num {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-h1);
    color: var(--color-accent);
    line-height: 0.9;
  }
  .instr__banner__title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h1);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .instr__banner__rule { height: 1px; background: var(--color-rule); align-self: center; }
  .instr__banner__count {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }

  /* NODE LIST ───────────────────────────────────────────────────── */
  .instr__list {
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }
  .node {
    margin: 0;
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .node + .node { margin-top: 0; }
  .node__article {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .node__rail { display: flex; flex-direction: column; gap: var(--space-2); }
  .node__mark {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-jumbo);
    line-height: 0.82;
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-accent);
    font-feature-settings: var(--features-tabular);
  }
  .node__folio {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }

  .node__body { max-width: 56rem; }
  .node__head {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }
  .node__kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .node__name {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h1);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }

  .node__rows {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-4) var(--space-6);
  }
  .node__row { display: contents; }
  .node__rows dt {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    padding-top: 0.3em;
  }
  .node__rows dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink);
  }
  .node__row--accent dt { color: var(--color-accent); font-weight: 600; }
  .node__row--accent dd {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-4);
    font-style: italic;
    color: var(--color-ink-soft);
  }

  /* OPERATIONAL ROWS ───────────────────────────────────────────── */
  .ops__rows {
    margin: var(--space-8) 0 0;
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-5) var(--space-6);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .ops__row { display: contents; }
  .ops__rows dt {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink);
    font-feature-settings: var(--features-tabular);
    font-weight: 600;
    padding-top: 0.3em;
  }
  .ops__rows dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink);
  }
  .ops__rows code {
    font-family: var(--font-mono);
    background: var(--color-paper-dim);
    padding: 0.1em 0.35em;
    border-radius: 2px;
    font-size: 0.92em;
  }
  .ops__legend {
    margin-top: var(--space-6);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-body);
    color: var(--color-ink-soft);
    max-width: 46rem;
  }

  @media (max-width: 760px) {
    .instr :global(.instr__inner),
    .instr__head,
    .node__article,
    .ops__rows { grid-template-columns: 1fr; gap: var(--space-3); }
    .instr__rail { flex-direction: row; align-items: center; gap: var(--space-3); }
    .instr__rail .rail__rule { flex: 1; }
    .instr__title { font-size: var(--type-display); }
    .node__rail { flex-direction: row; align-items: baseline; gap: var(--space-4); }
    .node__mark { font-size: var(--type-h1); }
    .node__rows { grid-template-columns: 1fr; gap: var(--space-2); }
    .node__rows dt { padding-top: var(--space-3); }
    .ops__rows dt { padding-top: var(--space-3); }
    .instr__banner { grid-template-columns: auto 1fr; }
    .instr__banner__rule, .instr__banner__count { display: none; }
  }
</style>
