---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import SignalChain, { type Node } from "~/components/SignalChain.astro";

interface InstrumentSpec {
  id: string;
  numeral: string;
  name: string;
  target: string;
  targetStatus?: string;
  /** Frequency band + receive frequency label, e.g. "VHF · 137.900 MHz". */
  band: string;
  /** "Lede" sentence appearing under the title. */
  lede: string;
  /** Nodes that make up the SVG signal chain. */
  nodes: Node[];
  /** Where the rooftop/compute divider sits in the chain (index after which it falls). */
  dividerAfter: number;
  /** Per-instrument spec key-values. */
  specs: { k: string; v: string }[];
  /** Operative note — the operative quirk worth knowing. */
  note: string;
  /** Anchor on /plates that filters captures from this instrument. */
  capturesHref: string;
  /** Display label for the captures link. */
  capturesLabel: string;
  /** Whether captures from this instrument exist yet. */
  hasCaptures: boolean;
}

const instruments: InstrumentSpec[] = [
  {
    id: "i-l-band-gk2a-trough",
    numeral: "I",
    name: "L-band chain · GK-2A · parabolic trough",
    target: "GEO-KOMPSAT-2A",
    targetStatus: "Geostationary, 128.2°E · current chain",
    band: "L · 1692.140 MHz",
    lede: "A 60 × 60 cm cylindrical parabolic trough, hand-built from cardboard formers, a nichrome-wire skeleton, a tensioned plastic-film skin and an aluminium-foil reflector, with a linear half-wave dipole at the focal line. Aimed at GK-2A. Full-disk images on this site dated 23 May 2026 or later were captured with this instrument.",
    nodes: [
      { mark: "I",   name: "Reflector",  spec: "60×60 cm parabolic trough", spec2: "f = 10 cm  ·  Al-foil on plastic film" },
      { mark: "II",  name: "Feed",       spec: "λ/2 linear dipole",         spec2: "8.9 cm at 1.69 GHz  ·  parallel to spine" },
      { mark: "III", name: "Front-end",  spec: "SAWbird+ GOES",             spec2: "LNA + SAW filter, ext. PSU" },
      { mark: "IV",  name: "Receiver",   spec: "RTL-SDR Blog V4",           spec2: "cu8  ·  2.4 Msps  ·  gain 25 dB" },
      { mark: "V",   name: "Decoder",    spec: "SatDump v2.0.0-α",          spec2: "pipeline · gk2a_lrit_aggressive" },
      { mark: "VI",  name: "Composite",  spec: "Sanchez v1.0.26.1",         spec2: "geostationary projection · blue underlay" },
    ],
    dividerAfter: 3,
    specs: [
      { k: "Antenna",   v: "60 × 60 cm cylindrical parabolic trough, hand-built (23 May 2026)" },
      { k: "Reflector", v: "Cardboard formers · nichrome wire skeleton · plastic-film skin · aluminium-foil surface" },
      { k: "Feed",      v: "Linear half-wave dipole at the focal line (8.9 cm @ 1.69 GHz), parallel to the spine" },
      { k: "Pointing",  v: "az 103° true · el 25° (→ 128.2°E geostationary)" },
      { k: "Front-end", v: "Nooelec SAWbird+ GOES (LNA + SAW, externally powered; SDR bias-tee OFF)" },
      { k: "Frequency", v: "1692.140 MHz (LRIT, BPSK 128 ksymb/s post-Viterbi 64 kbps)" },
      { k: "Sample rate", v: "2.4 Msps cu8, --dc_block=true" },
      { k: "Post",      v: "Sanchez geostationary projection · blue underlay · haze 0.6" },
    ],
    note: "GK-2A LRIT is right-hand circularly polarised; a linear dipole takes a fixed 3 dB cross-polarisation loss regardless of orientation. The trough's larger aperture partly compensates — the 24 May timelapse held lock for nine consecutive slots above the 1.5 dB Peak-SNR threshold this rig needs to decode. The cleanest recovery path is to swap the dipole for an RHCP helix feed at the same focal line; the trough geometry is unchanged.",
    capturesHref: "/plates#gk-2a",
    capturesLabel: "View captures from this instrument",
    hasCaptures: true,
  },
  {
    id: "ii-l-band-gk2a-helix",
    numeral: "II",
    name: "L-band chain · GK-2A · 12-turn helix",
    target: "GEO-KOMPSAT-2A",
    targetStatus: "Retired 23 May 2026 · superseded by Instrument I",
    band: "L · 1692.140 MHz",
    lede: "A 12-turn axial-mode helix wound for RHCP, on a 25 × 25 cm aluminium ground plane, hand-pointed. It produced the first decoded GK-2A frames on 22 May 2026. Replaced the next day by the parabolic trough at Instrument I; kept here for provenance.",
    nodes: [
      { mark: "I",   name: "Antenna",    spec: "12-turn axial helix, RHCP", spec2: "25×25 cm Al reflector  ·  hand-aimed" },
      { mark: "II",  name: "Front-end",  spec: "SAWbird+ GOES",             spec2: "LNA + SAW filter, ext. PSU" },
      { mark: "III", name: "Receiver",   spec: "RTL-SDR Blog V4",           spec2: "cu8  ·  2.4 Msps  ·  gain 25 dB" },
      { mark: "IV",  name: "Decoder",    spec: "SatDump v2.0.0-α",          spec2: "pipeline · gk2a_lrit" },
      { mark: "V",   name: "Composite",  spec: "Sanchez v1.0.26.1",         spec2: "geostationary projection · blue underlay" },
    ],
    dividerAfter: 2,
    specs: [
      { k: "Antenna",   v: "12-turn axial-mode helix, RHCP, hand-wound" },
      { k: "Reflector", v: "25 × 25 cm aluminium ground plane" },
      { k: "Pointing",  v: "az 103° true · el 25° (→ 128.2°E geostationary), hand-aimed" },
      { k: "Front-end", v: "Nooelec SAWbird+ GOES (LNA + SAW, ext. PSU; bias-tee OFF)" },
      { k: "Frequency", v: "1692.140 MHz (LRIT, BPSK 128 ksymb/s)" },
      { k: "Sample rate", v: "2.4 Msps cu8, --dc_block=true" },
      { k: "Status",    v: "Retired 23 May 2026; replaced by the parabolic trough at Instrument I" },
    ],
    note: "The helix matched GK-2A's RHCP downlink, so unlike the trough's linear dipole there was no 3 dB cross-polarisation loss in the link budget. The trade-off was capture area: a 25 × 25 cm helix collects less signal than a 60 × 60 cm parabolic surface, and the larger aperture was preferred. Result on this chain: 22 May 2026, 3 IR105 full-disk images at ~2.2 dB Peak SNR.",
    capturesHref: "/plates#gk-2a",
    capturesLabel: "View captures from this instrument (22 May 2026 plate)",
    hasCaptures: true,
  },
  {
    id: "iii-l-band-elektro",
    numeral: "III",
    name: "L-band chain · Elektro-L5",
    target: "Elektro-L5",
    targetStatus: "Geostationary, 76°E · commissioning",
    band: "L · 1691.000 MHz",
    lede: "The same parabolic trough and SAWbird+ front-end as Instrument I, repointed west towards the 76°E geostationary slot to receive Elektro-L5's LRIT broadcasts. L5 is in commissioning and transmits only sporadically.",
    nodes: [
      { mark: "I",   name: "Reflector",  spec: "60×60 cm parabolic trough", spec2: "shared with Instrument I, repointed" },
      { mark: "II",  name: "Feed",       spec: "λ/2 linear dipole",         spec2: "8.9 cm at 1.69 GHz" },
      { mark: "III", name: "Front-end",  spec: "SAWbird+ GOES",             spec2: "LNA + SAW filter, ext. PSU" },
      { mark: "IV",  name: "Receiver",   spec: "RTL-SDR Blog V4",           spec2: "cu8  ·  2.4 Msps" },
      { mark: "V",   name: "Decoder",    spec: "SatDump v2.0.0-α",          spec2: "pipeline · elektro_lrit" },
      { mark: "VI",  name: "Composite",  spec: "Sanchez (planned)",         spec2: "geostationary · 76°E centred" },
    ],
    dividerAfter: 3,
    specs: [
      { k: "Antenna",   v: "60 × 60 cm parabolic trough (shared with Instrument I)" },
      { k: "Feed",      v: "Linear half-wave dipole at the focal line" },
      { k: "Pointing",  v: "Repointed west of GK-2A by ~52° in azimuth (target 76°E equator)" },
      { k: "Front-end", v: "Nooelec SAWbird+ GOES (LNA + SAW, ext. PSU)" },
      { k: "Frequency", v: "1691.000 MHz (LRIT)" },
      { k: "Schedule",  v: "Sporadic — slots at :12/:27/:42/:57 UTC, mostly silent" },
    ],
    note: "L5 has been in commissioning since 2026-02-12, with broadcasts clustered around 08:00 UTC and rare outside that window. The first attempt on 2026-05-17 produced zero CADU — Viterbi never synced, and an FFT confirmed no signal in band. It is not yet known whether the antenna was off the bird, the polarisation sense was wrong, or L5 was not transmitting during that slot.",
    capturesHref: "/plates#elektro-l5",
    capturesLabel: "View captures (commissioning, no images yet)",
    hasCaptures: false,
  },
  {
    id: "iv-v-dipole",
    numeral: "IV",
    name: "137 MHz V-dipole",
    target: "METEOR M2-4 (and M2-3)",
    band: "VHF · 137.900 MHz",
    lede: "A pair of crossed half-wave elements on a rooftop pole, receiving the LRPT downlink during METEOR overpasses. The simplest chain on the rig, and the source of the only polar-orbit imagery in the register so far.",
    nodes: [
      { mark: "I",   name: "V-dipole",   spec: "Linear, ~1 m elements", spec2: "Pole, ~3.6 m, RHCP loss ~3 dB" },
      { mark: "II",  name: "Receiver",   spec: "RTL-SDR Blog V4",       spec2: "cu8  ·  1.024 Msps  ·  gain 25 dB" },
      { mark: "III", name: "Decoder",    spec: "SatDump v2.0.0-α",      spec2: "meteor_m2-x_lrpt · --dc_block=true" },
    ],
    dividerAfter: 1,
    specs: [
      { k: "Antenna",   v: "Crossed V-dipole, linear polarisation" },
      { k: "Mount",     v: "Rooftop pole, ~3.6 m, no rotator" },
      { k: "Frequency", v: "137.900 MHz (LRPT primary)" },
      { k: "Sample rate", v: "1.024 Msps (Nyquist for 1024 ksymbol/s QPSK)" },
      { k: "Gain",      v: "RTL gain 25 dB (no physical LNA in chain)" },
      { k: "Decode",    v: "SatDump on NAS, --dc_block=true mandatory for cu8" },
    ],
    note: "The V-dipole is linear and LRPT is circular, so there is an unavoidable ~3 dB cross-polarisation loss. The dominant limit, though, is tuner gain rather than polarisation: pushing the R828D above 30 dB compresses the front end and raises the noise floor by 20+ dB. At 25 dB the rig is the quietest it has been measured.",
    capturesHref: "/plates#meteor-m2-4",
    capturesLabel: "View captures from this instrument",
    hasCaptures: true,
  },
  {
    id: "v-l-band-gk2a-biquad",
    numeral: "V",
    name: "L-band chain · GK-2A · biquad on 1 m dish",
    target: "GEO-KOMPSAT-2A",
    targetStatus: "Geostationary, 128.2°E · Lucknow site",
    band: "L · 1692.140 MHz",
    lede: "The Lucknow L-band chain: a biquad feed in a tin-box reflector at the focus of a 1 m parabolic dish, pointed at GK-2A. This is the permanent-site build the 1 m dish was planned around — the trough and helix were the temporary Mumbai rigs that proved the link first. Build photographs are in the field record.",
    nodes: [
      { mark: "I",   name: "Reflector",  spec: "1 m parabolic dish",       spec2: "100 cm aperture · prime focus" },
      { mark: "II",  name: "Feed",       spec: "Biquad in tin-box cavity",  spec2: "linear pol · biscuit-tin reflector" },
      { mark: "III", name: "Front-end",  spec: "SAWbird+ GOES",             spec2: "LNA + SAW filter, ext. PSU" },
      { mark: "IV",  name: "Receiver",   spec: "RTL-SDR Blog V4",           spec2: "cu8  ·  2.4 Msps" },
      { mark: "V",   name: "Decoder",    spec: "SatDump v2.0.0-α",          spec2: "pipeline · gk2a_lrit_aggressive" },
      { mark: "VI",  name: "Composite",  spec: "Sanchez v1.0.26.1",         spec2: "geostationary projection · blue underlay" },
    ],
    dividerAfter: 3,
    specs: [
      { k: "Antenna",   v: "1 m prime-focus parabolic dish (100 cm aperture), Lucknow site" },
      { k: "Feed",      v: "Biquad (double-quad) at the dish focus, in a biscuit-tin reflector cavity" },
      { k: "Polarisation", v: "Linear — fixed 3 dB cross-polarisation loss against GK-2A's RHCP downlink" },
      { k: "Pointing",  v: "az 112.6° true · el 29.6° (Lucknow 26.85°N 80.95°E → 128.2°E geostationary)" },
      { k: "Front-end", v: "Nooelec SAWbird+ GOES (LNA + SAW, ext. PSU; bias-tee OFF)" },
      { k: "Frequency", v: "1692.140 MHz (LRIT, BPSK 128 ksymb/s)" },
      { k: "Sample rate", v: "2.4 Msps cu8, --dc_block=true" },
      { k: "Also",      v: "The same dish repoints ~52° west to Elektro-L5 at 76°E" },
    ],
    note: "A biquad is linearly polarised, so like the trough's dipole it takes a fixed 3 dB cross-polarisation loss against GK-2A's right-hand circular downlink. The 1 m dish has roughly 2.5× the collecting area of the 60 cm Mumbai trough, which more than offsets that loss; the biscuit-tin box behind the biquad acts as a sub-reflector, tightening the feed pattern onto the dish. At a 1 m aperture the L-band beamwidth is only ~12°, so the dish has to be aimed far more precisely than the hand-pointed Mumbai rigs.",
    capturesHref: "/build",
    capturesLabel: "See the build photographs",
    hasCaptures: false,
  },
];
---
<BaseLayout
  title="gs.nl06 — The instruments"
  description="Receive chains for three satellites, documented from antenna to composite."
  itemNumber="№ GS03"
>
  <article class="inst">
    <Container size="wide" class="inst__inner">
      <header class="inst__head">
        <div class="inst__rail">
          <span class="rail__label">Reference</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">Five configurations</span>
        </div>
        <div class="inst__heading">
          <h1 class="inst__title">
            <span class="inst__title-line">The instruments.</span>
            <span class="inst__title-emphasis">Five configurations, three targets.</span>
          </h1>
          <p class="inst__lede dropcap-text">
            The rig runs in five configurations &mdash; a hand-built
            60&nbsp;cm parabolic trough currently aimed at GK-2A; the
            12-turn helix it replaced on 23 May 2026, kept here for
            provenance; the same trough repointed west for Elektro-L5; a
            137&nbsp;MHz V-dipole on a pole for polar passes; and a biquad-fed
            1&nbsp;m dish at the Lucknow site, also on GK-2A. Each configuration
            is documented as a separate instrument below. Photographs of the
            builds are in the <a href="/build">field record</a>.
          </p>
        </div>
      </header>

      {instruments.map((inst) => (
        <section class="inst-card" id={inst.id}>
          <header class="inst-card__head">
            <span class="inst-card__numeral">{inst.numeral}</span>
            <div class="inst-card__heading">
              <span class="inst-card__kicker">
                Instrument {inst.numeral}
                <span class="inst-card__kicker-sep" aria-hidden="true">·</span>
                {inst.band}
              </span>
              <h2 class="inst-card__name">{inst.name}</h2>
              <p class="inst-card__target">
                <span class="inst-card__target-label">Target</span>
                <span class="inst-card__target-body">
                  {inst.target}
                  {inst.targetStatus && (
                    <span class="inst-card__target-status">{inst.targetStatus}</span>
                  )}
                </span>
              </p>
            </div>
          </header>

          <p class="inst-card__lede">{inst.lede}</p>

          <SignalChain
            nodes={inst.nodes}
            dividerAfter={inst.dividerAfter}
            domainTags={["Antenna · RF", "NAS · /satellite"]}
            caption={`The ${inst.name} chain, antenna to ${inst.nodes[inst.nodes.length - 1].name.toLowerCase()}.`}
          />

          <dl class="inst-card__specs">
            {inst.specs.map((s) => (
              <div class="inst-card__spec">
                <dt>{s.k}</dt>
                <dd>{s.v}</dd>
              </div>
            ))}
          </dl>

          <p class="inst-card__note">
            <span class="inst-card__note-label">Operative note</span>
            <span class="inst-card__note-body">{inst.note}</span>
          </p>

          <p class:list={["inst-card__cta", { "inst-card__cta--quiet": !inst.hasCaptures }]}>
            <a href={inst.capturesHref}>
              {inst.capturesLabel}
              <span class="inst-card__cta-arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </section>
      ))}

      <section class="inst__ops">
        <header class="inst__banner">
          <span class="inst__banner__num">¶</span>
          <h2 class="inst__banner__title">Standing notes</h2>
          <span class="inst__banner__rule" aria-hidden="true"></span>
          <span class="inst__banner__count">Across instruments</span>
        </header>

        <dl class="inst__ops-rows">
          <div class="inst__ops-row">
            <dt>Switching</dt>
            <dd>Only one chain is wired to the RTL-SDR at a time. The SPDT switch the rig was designed around is not yet installed, so moving between instruments is a manual coax swap and, for I&ndash;II, a physical re-aim.</dd>
          </div>
          <div class="inst__ops-row">
            <dt>Cadence</dt>
            <dd>GK-2A transmits continuously; capture slots are scheduled on the hour and the half hour. METEOR is captured per-pass when the orbit is favourable. Elektro-L5 captures track its sporadic broadcast cadence, mostly within an 05:30&ndash;09:30 UTC window.</dd>
          </div>
          <div class="inst__ops-row">
            <dt>Calibration</dt>
            <dd>The 137 MHz chain uses the always-on ORBCOMM constellation as a chain canary &mdash; if frames decode, the rig is alive. The L-band chains have no equivalent free signal; GGAK at 1693 MHz is a candidate but unverified on this rig.</dd>
          </div>
          <div class="inst__ops-row">
            <dt>Retention</dt>
            <dd>Raw IQ from a successful decode is purged within an hour. Failed-decode IQ is held seven days in <code>/satellite/_raw-iq/needs-review/</code>, then auto-deleted.</dd>
          </div>
          <div class="inst__ops-row">
            <dt>Provenance</dt>
            <dd>Every IQ pulled and processed is logged one JSON line at a time in <code>/satellite/.processed-iq-log.ndjson</code> &mdash; keyed on filename and first-megabyte SHA-256, then projected to a canonical per-IQ state file the website reads from.</dd>
          </div>
        </dl>
      </section>
    </Container>
  </article>
</BaseLayout>

<style>
  .inst { padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .inst :global(.inst__inner) {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
  }
  .inst__head {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-rule);
  }
  .inst__rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }
  .rail__label, .rail__date {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .rail__label { color: var(--color-ink); font-weight: 600; }
  .rail__date  { color: var(--color-ink-muted); }
  .rail__rule  { height: 1px; background: var(--color-rule); }

  .inst__title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-jumbo);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .inst__title-line { display: block; }
  .inst__title-emphasis {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }
  .inst__lede {
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--type-h4);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    max-width: 44rem;
  }

  /* INSTRUMENT CARD ────────────────────────────────────────────── */
  .inst-card {
    grid-column: 1 / -1;
    margin-top: var(--space-16);
    padding: var(--space-10) 0;
    border-top: 3px solid var(--color-ink);
    position: relative;
  }
  .inst-card::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 4px;
    border-top: 1px solid var(--color-ink);
  }
  .inst-card + .inst-card { margin-top: var(--space-12); }

  .inst-card__head {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-3);
  }
  .inst-card__numeral {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-folio);
    line-height: 0.82;
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-accent);
    font-feature-settings: var(--features-tabular);
  }
  .inst-card__heading { padding-top: 0.4em; }
  .inst-card__kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-3);
    width: max-content;
    max-width: 100%;
  }
  .inst-card__kicker-sep { color: var(--color-rule-strong); }
  .inst-card__name {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .inst-card__target {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
  }
  .inst-card__target-label {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .inst-card__target-body {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--type-h4);
    color: var(--color-ink);
  }
  .inst-card__target-status {
    margin-left: var(--space-3);
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }

  .inst-card__lede {
    margin: var(--space-6) 0 0;
    font-family: var(--font-serif);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink-soft);
    max-width: 50rem;
  }

  /* spec grid ─────────────────────────────────────── */
  .inst-card__specs {
    margin: var(--space-4) 0 0;
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-3) var(--space-6);
