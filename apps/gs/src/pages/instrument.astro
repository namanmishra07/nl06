---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container  from "@nl06/design-system/components/Container.astro";
import SignalChain, { type Node } from "~/components/SignalChain.astro";

interface InstrumentSpec {
  id: string;
  numeral: string;
  name: string;
  target: string;
  targetStatus?: string;
  /** Frequency band + receive frequency label, e.g. "VHF · 137.900 MHz". */
  band: string;
  /** "Lede" sentence appearing under the title. */
  lede: string;
  /** Nodes that make up the SVG signal chain. */
  nodes: Node[];
  /** Where the rooftop/compute divider sits in the chain (index after which it falls). */
  dividerAfter: number;
  /** Per-instrument spec key-values. */
  specs: { k: string; v: string }[];
  /** Operative note — the operative quirk worth knowing. */
  note: string;
  /** Anchor on /plates that filters captures from this instrument. */
  capturesHref: string;
  /** Display label for the captures link. */
  capturesLabel: string;
  /** Whether captures from this instrument exist yet. */
  hasCaptures: boolean;
}

const instruments: InstrumentSpec[] = [
  {
    id: "i-v-dipole",
    numeral: "I",
    name: "137 MHz V-dipole",
    target: "METEOR M2-4 (and M2-3)",
    band: "VHF · 137.900 MHz",
    lede: "A pair of crossed half-wave elements on a rooftop pole, listening for the LRPT downlink as METEOR sweeps overhead. The simplest instrument on the roof — and the one that has produced the only polar-orbit imagery in the register so far.",
    nodes: [
      { mark: "I",   name: "V-dipole",   spec: "Linear, ~1 m elements", spec2: "Pole, ~3.6 m, RHCP loss ~3 dB" },
      { mark: "II",  name: "Receiver",   spec: "RTL-SDR Blog V4",       spec2: "cu8  ·  1.024 Msps  ·  gain 25 dB" },
      { mark: "III", name: "Decoder",    spec: "SatDump v2.0.0-α",      spec2: "meteor_m2-x_lrpt · --dc_block=true" },
    ],
    dividerAfter: 1,
    specs: [
      { k: "Antenna",   v: "Crossed V-dipole, linear polarisation" },
      { k: "Mount",     v: "Rooftop pole, ~3.6 m, no rotator" },
      { k: "Frequency", v: "137.900 MHz (LRPT primary)" },
      { k: "Sample rate", v: "1.024 Msps (Nyquist for 1024 ksymbol/s QPSK)" },
      { k: "Gain",      v: "RTL gain 25 dB (no physical LNA in chain)" },
      { k: "Decode",    v: "SatDump on NAS, --dc_block=true mandatory for cu8" },
    ],
    note: "The V-dipole is linear and LRPT is circular, so there's an unavoidable ~3 dB cross-polarisation loss before anything else fails. The instrument's real failure mode isn't the polarisation though — it's the tuner gain. Pushing the R828D above 30 dB compresses the front end and raises the noise floor by 20+ dB; at 25 dB the rig is the quietest it has ever been measured.",
    capturesHref: "/plates#meteor-m2-4",
    capturesLabel: "View captures from this instrument",
    hasCaptures: true,
  },
  {
    id: "ii-l-band-gk2a",
    numeral: "II",
    name: "L-band chain · GK-2A",
    target: "GEO-KOMPSAT-2A",
    targetStatus: "Geostationary, 128.2°E",
    band: "L · 1692.140 MHz",
    lede: "A one-metre offset dish on the rooftop, repurposed from a Ku-band TV setup, with a hand-wound RHCP helix at the focus and a SAWbird+ GOES doing the front-end work. Aimed thirty degrees up and 112° east of true. Decodes a full-disk Earth every ten minutes.",
    nodes: [
      { mark: "I",   name: "Antenna",    spec: "1 m parabolic",         spec2: "az 112.6°  ·  el 29.6°" },
      { mark: "II",  name: "Feed",       spec: "3-turn helix, RHCP",    spec2: "1692.14 MHz centre" },
      { mark: "III", name: "Front-end",  spec: "SAWbird+ GOES",         spec2: "LNA + SAW filter, ext. PSU" },
      { mark: "IV",  name: "Receiver",   spec: "RTL-SDR Blog V4",       spec2: "cu8  ·  2.4 Msps" },
      { mark: "V",   name: "Decoder",    spec: "SatDump v2.0.0-α",      spec2: "pipeline · gk2a_lrit" },
      { mark: "VI",  name: "Composite",  spec: "Sanchez v1.0.26.1",     spec2: "blue underlay  ·  haze 0.6" },
    ],
    dividerAfter: 3,
    specs: [
      { k: "Antenna",   v: "1 m offset parabolic (ex-Ku TV)" },
      { k: "Feed",      v: "3-turn RHCP helix, hand-wound" },
      { k: "Pointing",  v: "az 112.6° true · el 29.6°" },
      { k: "Front-end", v: "Nooelec SAWbird+ GOES (LNA + SAW, ext. PSU)" },
      { k: "Frequency", v: "1692.140 MHz (LRIT, BPSK 128 ksymb/s)" },
      { k: "Sample rate", v: "2.4 Msps cu8" },
      { k: "Post",      v: "Sanchez · geostationary projection · blue underlay" },
    ],
    note: "The chain is shared between GK-2A and Elektro-L5 — only the pointing changes. SAWbird+ GOES is externally powered; the SDR's bias-tee must remain off. Beamwidth at L-band with the 1 m dish is roughly 12°, so a re-aim for any non-GK-2A target is a deliberate manual operation, not a click.",
    capturesHref: "/plates#gk-2a",
    capturesLabel: "View captures from this instrument",
    hasCaptures: true,
  },
  {
    id: "iii-l-band-elektro",
    numeral: "III",
    name: "L-band chain · Elektro-L5",
    target: "Elektro-L5",
    targetStatus: "Geostationary, 76°E · commissioning",
    band: "L · 1691.000 MHz",
    lede: "The same one-metre dish and helix-and-SAWbird front-end as Instrument II, repointed south-southwest at the 76°E geostationary slot. Listening for Elektro-L5's sporadic LRIT broadcasts during its commissioning window — currently silent more often than not.",
    nodes: [
      { mark: "I",   name: "Antenna",    spec: "1 m parabolic",         spec2: "az 190.9°  ·  el 58.0°" },
      { mark: "II",  name: "Feed",       spec: "3-turn helix, RHCP",    spec2: "1691.000 MHz centre" },
      { mark: "III", name: "Front-end",  spec: "SAWbird+ GOES",         spec2: "LNA + SAW filter, ext. PSU" },
      { mark: "IV",  name: "Receiver",   spec: "RTL-SDR Blog V4",       spec2: "cu8  ·  2.4 Msps" },
      { mark: "V",   name: "Decoder",    spec: "SatDump v2.0.0-α",      spec2: "pipeline · elektro_lrit" },
      { mark: "VI",  name: "Composite",  spec: "Sanchez (planned)",     spec2: "geostationary · 76°E centred" },
    ],
    dividerAfter: 3,
    specs: [
      { k: "Antenna",   v: "1 m offset parabolic (shared with II)" },
      { k: "Feed",      v: "3-turn RHCP helix" },
      { k: "Pointing",  v: "az 190.9° true · el 58.0° (target 76°E equator)" },
      { k: "Front-end", v: "Nooelec SAWbird+ GOES (LNA + SAW, ext. PSU)" },
      { k: "Frequency", v: "1691.000 MHz (LRIT)" },
      { k: "Schedule",  v: "Sporadic — slots at :12/:27/:42/:57 UTC, mostly silent" },
    ],
    note: "L5 has been in commissioning since 2026-02-12, with broadcasts clustered around 08:00 UTC and rarely lit outside that window. The first-light attempt on 2026-05-17 produced zero CADU — Viterbi never synced, FFT confirmed no signal in band — leaving the unanswered question of whether the dish was on the bird, the polarisation sense was wrong, or L5 simply wasn't transmitting during that slot.",
    capturesHref: "/plates#elektro-l5",
    capturesLabel: "View captures (commissioning, no images yet)",
    hasCaptures: false,
  },
];
---
<BaseLayout
  title="gs.nl06 — The instruments"
  description="Three configured chains, three satellites. Antenna to composite, end to end."
  itemNumber="№ GS03"
>
  <article class="inst">
    <Container size="wide" class="inst__inner">
      <header class="inst__head">
        <div class="inst__rail">
          <span class="rail__label">Reference</span>
          <span class="rail__rule" aria-hidden="true"></span>
          <span class="rail__date">Three chains</span>
        </div>
        <div class="inst__heading">
          <h1 class="inst__title">
            <span class="inst__title-line">The instruments.</span>
            <span class="inst__title-emphasis">Three chains, three targets.</span>
          </h1>
          <p class="inst__lede dropcap-text">
            The rig is not one antenna. It&rsquo;s three operating configurations of the
            same rooftop &mdash; a V-dipole on a pole for the polar pass, a one-metre
            offset dish aimed at GK-2A through the morning haze, and the same dish
            repointed south-southwest when Elektro-L5 decides to broadcast. Each
            configuration is its own instrument. Each instrument writes its own log.
          </p>
        </div>
      </header>

      {instruments.map((inst) => (
        <section class="inst-card" id={inst.id}>
          <header class="inst-card__head">
            <span class="inst-card__numeral">{inst.numeral}</span>
            <div class="inst-card__heading">
              <span class="inst-card__kicker">
                Instrument {inst.numeral}
                <span class="inst-card__kicker-sep" aria-hidden="true">·</span>
                {inst.band}
              </span>
              <h2 class="inst-card__name">{inst.name}</h2>
              <p class="inst-card__target">
                <span class="inst-card__target-label">Target</span>
                <span class="inst-card__target-body">
                  {inst.target}
                  {inst.targetStatus && (
                    <span class="inst-card__target-status">{inst.targetStatus}</span>
                  )}
                </span>
              </p>
            </div>
          </header>

          <p class="inst-card__lede">{inst.lede}</p>

          <SignalChain
            nodes={inst.nodes}
            dividerAfter={inst.dividerAfter}
            domainTags={["Rooftop · Lucknow", "NAS · /satellite"]}
            caption={`The ${inst.name} chain, antenna to ${inst.nodes[inst.nodes.length - 1].name.toLowerCase()}.`}
          />

          <dl class="inst-card__specs">
            {inst.specs.map((s) => (
              <div class="inst-card__spec">
                <dt>{s.k}</dt>
                <dd>{s.v}</dd>
              </div>
            ))}
          </dl>

          <p class="inst-card__note">
            <span class="inst-card__note-label">Operative note</span>
            <span class="inst-card__note-body">{inst.note}</span>
          </p>

          <p class:list={["inst-card__cta", { "inst-card__cta--quiet": !inst.hasCaptures }]}>
            <a href={inst.capturesHref}>
              {inst.capturesLabel}
              <span class="inst-card__cta-arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </section>
      ))}

      <section class="inst__ops">
        <header class="inst__banner">
          <span class="inst__banner__num">¶</span>
          <h2 class="inst__banner__title">Standing notes</h2>
          <span class="inst__banner__rule" aria-hidden="true"></span>
          <span class="inst__banner__count">Across instruments</span>
        </header>

        <dl class="inst__ops-rows">
          <div class="inst__ops-row">
            <dt>Switching</dt>
            <dd>Only one chain is wired to the RTL-SDR at a time. The SPDT switch the rig was designed around is not yet installed, so moving between instruments is a manual coax swap and, for II&ndash;III, a physical re-aim.</dd>
          </div>
          <div class="inst__ops-row">
            <dt>Cadence</dt>
            <dd>GK-2A transmits continuously; capture slots are scheduled on the hour and the half hour. METEOR is captured per-pass when the orbit is favourable. Elektro-L5 captures track its sporadic broadcast cadence, mostly within an 05:30&ndash;09:30 UTC window.</dd>
          </div>
          <div class="inst__ops-row">
            <dt>Calibration</dt>
            <dd>The 137 MHz chain uses the always-on ORBCOMM constellation as a chain canary &mdash; if frames decode, the rig is alive. The L-band chains have no equivalent free signal; GGAK at 1693 MHz is a candidate but unverified on this rig.</dd>
          </div>
          <div class="inst__ops-row">
            <dt>Retention</dt>
            <dd>Raw IQ from a successful decode is purged within an hour. Failed-decode IQ is held seven days in <code>/satellite/_raw-iq/needs-review/</code>, then auto-deleted.</dd>
          </div>
          <div class="inst__ops-row">
            <dt>Provenance</dt>
            <dd>Every IQ pulled and processed is logged one JSON line at a time in <code>/satellite/.processed-iq-log.ndjson</code> &mdash; keyed on filename and first-megabyte SHA-256, then projected to a canonical per-IQ state file the website reads from.</dd>
          </div>
        </dl>
      </section>
    </Container>
  </article>
</BaseLayout>

<style>
  .inst { padding-top: var(--space-12); padding-bottom: var(--space-12); }
  .inst :global(.inst__inner) {
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
  }
  .inst__head {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--width-marginalia) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-rule);
  }
  .inst__rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }
  .rail__label, .rail__date {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .rail__label { color: var(--color-ink); font-weight: 600; }
  .rail__date  { color: var(--color-ink-muted); }
  .rail__rule  { height: 1px; background: var(--color-rule); }

  .inst__title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-jumbo);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .inst__title-line { display: block; }
  .inst__title-emphasis {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }
  .inst__lede {
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--type-h4);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    max-width: 44rem;
  }

  /* INSTRUMENT CARD ────────────────────────────────────────────── */
  .inst-card {
    grid-column: 1 / -1;
    margin-top: var(--space-16);
    padding: var(--space-10) 0;
    border-top: 3px solid var(--color-ink);
    position: relative;
  }
  .inst-card::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 4px;
    border-top: 1px solid var(--color-ink);
  }
  .inst-card + .inst-card { margin-top: var(--space-12); }

  .inst-card__head {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-3);
  }
  .inst-card__numeral {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--type-folio);
    line-height: 0.82;
    letter-spacing: var(--tracking-jumbo);
    color: var(--color-accent);
    font-feature-settings: var(--features-tabular);
  }
  .inst-card__heading { padding-top: 0.4em; }
  .inst-card__kicker {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-3);
    width: max-content;
    max-width: 100%;
  }
  .inst-card__kicker-sep { color: var(--color-rule-strong); }
  .inst-card__name {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    font-feature-settings: var(--features-display);
  }
  .inst-card__target {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
  }
  .inst-card__target-label {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }
  .inst-card__target-body {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--type-h4);
    color: var(--color-ink);
  }
  .inst-card__target-status {
    margin-left: var(--space-3);
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }

  .inst-card__lede {
    margin: var(--space-6) 0 0;
    font-family: var(--font-serif);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink-soft);
    max-width: 50rem;
  }

  /* spec grid ─────────────────────────────────────── */
  .inst-card__specs {
    margin: var(--space-4) 0 0;
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-3) var(--space-6);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    max-width: 50rem;
  }
  .inst-card__spec { display: contents; }
  .inst-card__specs dt {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
    padding-top: 0.18em;
  }
  .inst-card__specs dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--type-small);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }

  /* operative note ────────────────────────────────────────────── */
  .inst-card__note {
    margin: var(--space-6) 0 0;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-5);
    align-items: baseline;
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-accent);
    max-width: 50rem;
  }
  .inst-card__note-label {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-accent);
    font-feature-settings: var(--features-tabular);
    font-weight: 700;
    padding-top: 0.3em;
  }
  .inst-card__note-body {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink-soft);
  }

  /* CTA — view captures from this instrument */
  .inst-card__cta {
    margin: var(--space-8) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-serif);
    font-size: var(--type-h4);
    font-style: italic;
  }
  .inst-card__cta a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    padding-bottom: 1px;
    transition: color 100ms ease, border-color 100ms ease;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .inst-card__cta a:hover {
    color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent-hover);
  }
  .inst-card__cta-arrow {
    font-style: normal;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.4, 1);
  }
  .inst-card__cta a:hover .inst-card__cta-arrow { transform: translateX(0.2em); }
  .inst-card__cta--quiet a {
    color: var(--color-ink-muted);
    border-bottom-color: color-mix(in srgb, var(--color-ink-muted) 40%, transparent);
  }
  .inst-card__cta--quiet a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  /* STANDING NOTES ─────────────────────────────────────────────── */
  .inst__ops {
    grid-column: 1 / -1;
    margin-top: var(--space-16);
  }
  .inst__banner {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 3px solid var(--color-ink);
    position: relative;
  }
  .inst__banner::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    border-bottom: 1px solid var(--color-ink);
  }
  .inst__banner__num {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: var(--type-h1);
    color: var(--color-accent);
    line-height: 0.9;
  }
  .inst__banner__title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--type-h1);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .inst__banner__rule { height: 1px; background: var(--color-rule); align-self: center; }
  .inst__banner__count {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-feature-settings: var(--features-tabular);
    font-weight: 500;
  }

  .inst__ops-rows {
    margin: var(--space-8) 0 0;
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-5) var(--space-6);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .inst__ops-row { display: contents; }
  .inst__ops-rows dt {
    font-family: var(--font-sans);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-ink);
    font-feature-settings: var(--features-tabular);
    font-weight: 600;
    padding-top: 0.3em;
  }
  .inst__ops-rows dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
    color: var(--color-ink);
